+                controller_id="controller-a",
+                expected_revision=1,
+                lease_deadline_monotonic=30.0,
+            )
+        )
+    )
+    rebind_thread.start()
+    assert notification_started.wait(timeout=3)
+
+    new_sink = _RecordingSink()
+    new_registration = runtime.host.prepare_observer(
+        _request(), new_sink
+    ).activate()
+    allow_notification.set()
+    rebind_thread.join(timeout=3)
+    assert not rebind_thread.is_alive()
+    _wait_until(lambda: runtime.observers.active_count == 1)
