+def _bind(
+    runtime: ExtensionRuntimeV1,
+    key: str = "session-1",
+    *,
+    controller_id: str | None = None,
+    generation: str = "generation-1",
+    expected_revision: int = 0,
+    lease_deadline_monotonic: float | None = None,
+):
+    return runtime.sessions.bind(
+        profile="default",
+        durable_session_key=key,
+        runtime_generation=generation,
+        controller_id=controller_id or f"controller-{key}",
+        expected_revision=expected_revision,
+        lease_deadline_monotonic=(
+            lease_deadline_monotonic
+            if lease_deadline_monotonic is not None
+            else time.monotonic() + 60
+        ),
+    )
+
