+"""Internal Stage 2 runtime for the public Gateway Extension Host SPI v1.
+
+This module deliberately stops before any CLI, TUI, Desktop, Gateway, ACP, or
+worker composition.  It provides the protocol-neutral session authority and
+observer mechanics needed by a future composition root without importing
+private Agent or transport implementations.
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+import math
+import threading
+import time
+import unicodedata
+from collections import deque
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass, field
+from enum import Enum
+from types import MappingProxyType
+from typing import Any, Literal
+
+from hermes_cli.extension_host_v1 import (
+    ControlScope,
+    EventSink,
+    HostSpiCapabilityError,
+    HostSpiError,
+    HostSpiRegistrationError,
+    HostSpiUnavailableError,
+    ObserverEvent,
+    ObserverRequest,
+    OwnerActionRequest,
+    Registration,
+    RuntimeDescriptor,
+    SafeAuditEvent,
+)
+
+MAX_OBSERVER_QUEUE_FRAMES = 32
+MAX_OBSERVER_FRAME_BYTES = 256 * 1024
+MAX_SNAPSHOT_EVENTS = 32
+MAX_OBSERVERS_TOTAL = 64
+MAX_OBSERVERS_PER_SCOPE = 8
+MAX_BLOCKED_OBSERVERS = 4
+MAX_OBSERVER_FAILURE_HISTORY = 128
+
+DISPLAY_SAFE_EVENT_TYPES_V1 = frozenset(
+    {
+        "assistant.delta",
+        "assistant.message",
+        "session.status",
+        "tool.status",
+        "user.message",
+    }
+)
+
+_EVENT_REQUIRED_FIELDS: Mapping[str, frozenset[str]] = MappingProxyType(
+    {
+        "assistant.delta": frozenset({"text"}),
+        "assistant.message": frozenset({"text"}),
+        "session.status": frozenset({"status"}),
+        "tool.status": frozenset({"tool_name", "status"}),
+        "user.message": frozenset({"text"}),
+    }
+)
+_EVENT_OPTIONAL_FIELDS: Mapping[str, frozenset[str]] = MappingProxyType(
+    {
+        "assistant.delta": frozenset(),
+        "assistant.message": frozenset(),
+        "session.status": frozenset({"display"}),
+        "tool.status": frozenset({"display"}),
+        "user.message": frozenset(),
+    }
+)
+_TOOL_STATUSES = frozenset({"queued", "running", "succeeded", "failed"})
+_SESSION_STATUSES = frozenset(
+    {"thinking", "waiting", "completed", "interrupted", "failed"}
+)
+
+SAFE_AUDIT_EVENT_NAMES_V1 = frozenset(
+    {
+        "authority.lifecycle",
+        "observer.lifecycle",
+        "runtime.lifecycle",
+    }
+)
+_AUDIT_ALLOWED_ATTRIBUTES: Mapping[str, frozenset[str]] = MappingProxyType(
+    {
+        "authority.lifecycle": frozenset({"action", "revision", "state"}),
+        "observer.lifecycle": frozenset(
+            {"action", "failure_category", "state", "subscription_id"}
+        ),
+        "runtime.lifecycle": frozenset({"action", "state"}),
+    }
+)
+_AUDIT_SENSITIVE_KEY_FRAGMENTS = frozenset(
+    {
+        "approval",
+        "argument",
+        "credential",
+        "password",
+        "payload",
+        "reasoning",
+        "secret",
+        "token",
+        "tooloutput",
+    }
+)
+_AUDIT_ALLOWED_VALUES: Mapping[str, frozenset[str]] = MappingProxyType(
+    {
+        "action": frozenset(
+            {"bound", "closed", "closing", "expired", "failed", "renewed", "started"}
+        ),
+        "failure_category": frozenset(
+            {
+                "cleanup_failed",
+                "clock_failed",
+                "delivery_blocked",
+                "none",
+                "sink_delivery_failed",
+                "worker_start_failed",
+            }
+        ),
+        "state": frozenset(
+            {"active", "closed", "closing", "prepared", "ready", "unavailable"}
+        ),
+    }
+)
+
+
+class ObserverStateError(HostSpiError):
+    def __init__(self) -> None:
+        super().__init__("observer lifecycle state is unavailable")
+
+
+class ObserverSequenceError(HostSpiError):
+    def __init__(self) -> None:
+        super().__init__("observer event sequence is not contiguous")
+
+
+class ObserverFrameError(HostSpiError):
+    def __init__(self) -> None:
+        super().__init__("observer event frame exceeds the safe limit")
+
+
+class ObserverDeliveryBlockedError(HostSpiError):
+    def __init__(self) -> None:
+        super().__init__("observer delivery did not stop before the close deadline")
+
+
+class ObserverClockError(HostSpiUnavailableError):
+    def __init__(self) -> None:
+        HostSpiError.__init__(self, "observer runtime clock is unavailable")
+
+
+def _finite_number(
+    value: object,
+    field_name: str,
+    *,
+    positive: bool = False,
+) -> float:
+    if (
+        isinstance(value, bool)
+        or not isinstance(value, (int, float))
+        or not math.isfinite(value)
+    ):
+        raise ValueError(f"{field_name} must be finite numeric")
+    normalized = float(value)
+    if positive and normalized <= 0:
+        raise ValueError(f"{field_name} must be positive")
+    return normalized
+
+
+class _MonotonicGuard:
+    def __init__(self, source: Callable[[], float]) -> None:
+        if not callable(source):
+            raise ValueError("monotonic clock must be callable")
+        self._source = source
+        self._lock = threading.Lock()
+        self._last: float | None = None
+
+    def read(self) -> float:
+        with self._lock:
+            clock_failed = False
+            try:
+                observed = _finite_number(self._source(), "monotonic clock")
+            except BaseException:
+                clock_failed = True
+                observed = 0.0
+            if clock_failed:
+                raise ObserverClockError()
+            if self._last is not None and observed < self._last:
+                raise ObserverClockError()
+            self._last = observed
+            return observed
+
+
+def _canonical_text(value: object, field_name: str, *, max_length: int = 256) -> str:
+    if (
+        not isinstance(value, str)
+        or not value
+        or value != value.strip()
+        or len(value) > max_length
+        or any(
+            unicodedata.category(character) in {"Cc", "Cs"}
+            for character in value
+        )
+    ):
+        raise ValueError(f"{field_name} must be canonical text")
+    return value
+
+
+def _frozen_payload(value: object) -> Mapping[str, str]:
+    if not isinstance(value, Mapping):
+        raise TypeError("display-safe payload must be an object")
+    copied = copy.deepcopy(dict(value))
+    if any(
+        not isinstance(key, str)
+        or not key
+        or key != key.strip()
+        or any(
+            unicodedata.category(character) in {"Cc", "Cs"}
+            for character in key
+        )
+        for key in copied
+    ):
+        raise ValueError("display-safe payload keys must be canonical text")
+    if any(not isinstance(item, str) for item in copied.values()):
+        raise ValueError("display-safe payload values must be text")
+    for key, item in copied.items():
+        _canonical_text(item, f"payload.{key}", max_length=128 * 1024)
+    return MappingProxyType(copied)
+
+
+def _contains_sensitive_audit_key(value: object) -> bool:
+    if isinstance(value, Mapping):
+        for key, item in value.items():
+            normalized = "".join(
+                character.lower()
+                for character in str(key)
+                if character.isalnum()
+            )
+            if any(
+                fragment in normalized
+                for fragment in _AUDIT_SENSITIVE_KEY_FRAGMENTS
+            ):
+                return True
+            if _contains_sensitive_audit_key(item):
+                return True
+    elif isinstance(value, (list, tuple)):
+        return any(_contains_sensitive_audit_key(item) for item in value)
+    return False
+
+
+def _validate_safe_audit_event(event: SafeAuditEvent) -> None:
+    if event.name not in SAFE_AUDIT_EVENT_NAMES_V1:
+        raise HostSpiRegistrationError("safe audit event is unavailable")
+    attributes = event.attributes
+    if _contains_sensitive_audit_key(attributes):
+        raise HostSpiRegistrationError("safe audit event is unavailable")
+    if set(attributes) - _AUDIT_ALLOWED_ATTRIBUTES[event.name]:
+        raise HostSpiRegistrationError("safe audit event is unavailable")
+    for key, value in attributes.items():
+        if key in {"revision", "subscription_id"}:
+            if type(value) is not int or value < 0:
+                raise HostSpiRegistrationError("safe audit event is unavailable")
+        else:
+            try:
+                normalized = _canonical_text(value, f"audit.{key}")
+            except (TypeError, ValueError):
+                raise HostSpiRegistrationError(
+                    "safe audit event is unavailable"
+                ) from None
+            allowed_values = _AUDIT_ALLOWED_VALUES.get(key)
+            if allowed_values is not None and normalized not in allowed_values:
+                raise HostSpiRegistrationError("safe audit event is unavailable")
+
+
+@dataclass(frozen=True, repr=False)
+class DisplaySafeEventV1:
+    event_type: str
+    payload: Mapping[str, str]
+
+    def __post_init__(self) -> None:
+        event_type = _canonical_text(self.event_type, "event_type")
+        if event_type not in DISPLAY_SAFE_EVENT_TYPES_V1:
+            raise ValueError("event_type is not display-safe v1")
+        payload = _frozen_payload(self.payload)
+        fields = frozenset(payload)
+        required = _EVENT_REQUIRED_FIELDS[event_type]
+        allowed = required | _EVENT_OPTIONAL_FIELDS[event_type]
+        if not required.issubset(fields) or not fields.issubset(allowed):
+            raise ValueError("display-safe payload schema mismatch")
+        if event_type == "tool.status" and payload["status"] not in _TOOL_STATUSES:
+            raise ValueError("tool status is unavailable")
+        if (
+            event_type == "session.status"
+            and payload["status"] not in _SESSION_STATUSES
+        ):
+            raise ValueError("session status is unavailable")
+        object.__setattr__(self, "payload", payload)
+
+    def __repr__(self) -> str:
+        return (
+            "DisplaySafeEventV1("
+            f"event_type={self.event_type!r}, payload=[REDACTED])"
+        )
+
+
+@dataclass(frozen=True, repr=False)
+class ObserverSnapshotV1:
+    profile: str
+    durable_session_key: str
+    runtime_generation: str
+    watermark: int
+    events: tuple[ObserverEvent, ...] = field(default_factory=tuple)
+
+    def __post_init__(self) -> None:
+        _canonical_text(self.profile, "profile")
+        _canonical_text(self.durable_session_key, "durable_session_key")
+        _canonical_text(self.runtime_generation, "runtime_generation")
+        if type(self.watermark) is not int or self.watermark < 0:
+            raise ValueError("watermark must be a non-negative integer")
+        events = tuple(self.events)
+        if len(events) > MAX_SNAPSHOT_EVENTS:
+            raise ValueError("snapshot contains too many events")
+        if any(
+            event.profile != self.profile
+            or event.durable_session_key != self.durable_session_key
+            or event.runtime_generation != self.runtime_generation
+            for event in events
+        ):
+            raise ValueError("snapshot event identity mismatch")
+        object.__setattr__(self, "events", events)
+
+    def __repr__(self) -> str:
+        return (
+            "ObserverSnapshotV1("
+            f"profile={self.profile!r}, durable_session_key=[REDACTED], "
+            f"runtime_generation={self.runtime_generation!r}, "
+            f"watermark={self.watermark!r}, events=[REDACTED])"
+        )
+
+
+@dataclass(frozen=True, repr=False)
+class SessionAuthorityBinding:
+    profile: str
+    durable_session_key: str
+    runtime_generation: str
+    controller_id: str
+    lease_deadline_monotonic: float
+    revision: int
+
+    def __repr__(self) -> str:
+        return (
+            "SessionAuthorityBinding("
+            f"profile={self.profile!r}, durable_session_key=[REDACTED], "
+            f"runtime_generation={self.runtime_generation!r}, "
+            "controller_id=[REDACTED], "
+            f"lease_deadline_monotonic={self.lease_deadline_monotonic!r}, "
+            f"revision={self.revision!r})"
+        )
+
+
+@dataclass
+class _SessionRecord:
+    profile: str
+    durable_session_key: str
+    runtime_generation: str
+    controller_id: str | None = None
+    lease_deadline_monotonic: float = 0.0
+    revision: int = 0
+    token: object | None = None
+    lease_registration: Registration | None = None
+    sequence: int = 0
+    snapshot_events: deque[ObserverEvent] = field(
+        default_factory=lambda: deque(maxlen=MAX_SNAPSHOT_EVENTS)
+    )
+
+
+class _SessionAuthorityRegistration:
+    def __init__(
+        self,
+        registry: "SessionAuthorityRegistry",
+        identity: tuple[str, str],
+        token: object,
+    ) -> None:
+        self._registry = registry
+        self._identity = identity
+        self._token = token
+        self._lock = threading.Lock()
+        self._closed = False
+
+    def close(self) -> None:
+        with self._lock:
+            if self._closed:
+                return
+            self._registry._close_binding(self._identity, self._token)
+            self._closed = True
+
+
+class SessionAuthorityRegistry:
+    """Linearizable authority bindings sharing the observer runtime lock."""
+
+    def __init__(
+        self,
+        lock: threading.RLock | None = None,
+        *,
+        runtime_generation: str,
+        clock: _MonotonicGuard,
+        deadline_scheduler: Any,
+    ) -> None:
+        self._lock = lock or threading.RLock()
+        self._records: dict[tuple[str, str], _SessionRecord] = {}
+        self._runtime_generation = _canonical_text(
+            runtime_generation, "runtime_generation"
+        )
+        self._clock = clock
+        self._deadline_scheduler = deadline_scheduler
+        self._closed = False
+        self._revocation_listener: Callable[[SessionAuthorityBinding], None] | None = (
+            None
+        )
+
+    def set_revocation_listener(
+        self,
+        listener: Callable[[SessionAuthorityBinding], None],
+    ) -> None:
+        with self._lock:
+            if self._revocation_listener is not None:
+                raise RuntimeError("authority revocation listener already configured")
+            self._revocation_listener = listener
+
+    @property
+    def runtime_generation(self) -> str:
+        with self._lock:
+            return self._runtime_generation
+
+    def bind(
+        self,
+        *,
+        profile: str,
+        durable_session_key: str,
+        runtime_generation: str,
+        controller_id: str,
+        expected_revision: int,
+        lease_deadline_monotonic: float,
+    ) -> Registration:
+        profile = _canonical_text(profile, "profile")
+        durable_session_key = _canonical_text(
+            durable_session_key, "durable_session_key"
+        )
+        runtime_generation = _canonical_text(
+            runtime_generation, "runtime_generation"
+        )
+        controller_id = _canonical_text(controller_id, "controller_id")
+        if type(expected_revision) is not int or expected_revision < 0:
+            raise ValueError("expected_revision must be a non-negative integer")
+        lease_deadline_monotonic = _finite_number(
+            lease_deadline_monotonic,
+            "lease deadline",
+            positive=True,
+        )
+        identity = (profile, durable_session_key)
+        token = object()
+        revoked: list[SessionAuthorityBinding] = []
+        registrations_to_close: list[Registration] = []
+        with self._lock:
+            if self._closed:
+                raise HostSpiUnavailableError()
+            now = self._clock.read()
+            if lease_deadline_monotonic <= now:
+                raise HostSpiUnavailableError()
+            record = self._records.get(identity)
+            current_revision = record.revision if record is not None else 0
+            if current_revision != expected_revision:
+                raise HostSpiUnavailableError()
+            lease_is_live = (
+                record is not None
+                and record.token is not None
+                and record.lease_deadline_monotonic > now
+            )
+            if (
+                lease_is_live
+                and record is not None
+                and record.controller_id != controller_id
+            ):
+                raise HostSpiUnavailableError()
+
+            revision = current_revision + 1
+            lease_duration = _finite_number(
+                lease_deadline_monotonic - now,
+                "lease duration",
+                positive=True,
+            )
+            callback_state = {"armed": False, "fired": False}
+            callback_lock = threading.Lock()
+
+            def expire_candidate() -> None:
+                with callback_lock:
+                    if not callback_state["armed"]:
+                        callback_state["fired"] = True
+                        return
+                self._expire_binding(identity, token, revision)
+
+            schedule_failed = False
+            try:
+                lease_registration = self._deadline_scheduler.schedule(
+                    lease_duration,
+                    expire_candidate,
+                )
+            except BaseException:
+                schedule_failed = True
+                lease_registration = None
+            if schedule_failed or lease_registration is None:
+                if lease_registration is not None:
+                    try:
+                        lease_registration.close()
+                    except BaseException:
+                        pass
+                raise HostSpiUnavailableError()
+
+            with callback_lock:
+                early_fire = callback_state["fired"]
+                if not early_fire:
+                    generation_rollover = (
+                        runtime_generation != self._runtime_generation
+                    )
+                    if generation_rollover:
+                        for other in self._records.values():
+                            if other.token is None:
+                                continue
+                            revoked.append(self._binding_for_record(other))
+                            if other.lease_registration is not None:
+                                registrations_to_close.append(
+                                    other.lease_registration
+                                )
+                            other.lease_registration = None
+                            other.token = None
+                            other.controller_id = None
+                            other.lease_deadline_monotonic = 0.0
+                            if other is not record:
+                                other.revision += 1
+                        self._runtime_generation = runtime_generation
+                    elif record is not None and record.token is not None:
+                        revoked.append(self._binding_for_record(record))
+                        if record.lease_registration is not None:
+                            registrations_to_close.append(
+                                record.lease_registration
+                            )
+
+                    if record is None:
+                        record = _SessionRecord(
+                            profile=profile,
+                            durable_session_key=durable_session_key,
+                            runtime_generation=runtime_generation,
+                        )
+                        self._records[identity] = record
+                    elif record.runtime_generation != runtime_generation:
+                        record.snapshot_events.clear()
+                    record.runtime_generation = runtime_generation
+                    record.controller_id = controller_id
+                    record.lease_deadline_monotonic = lease_deadline_monotonic
+                    record.revision = revision
+                    record.token = token
+                    record.lease_registration = lease_registration
+                    callback_state["armed"] = True
+            if early_fire:
+                try:
+                    lease_registration.close()
+                except BaseException:
+                    pass
+                raise HostSpiUnavailableError()
+        for registration in registrations_to_close:
+            try:
+                registration.close()
+            except BaseException:
+                continue
+        for binding in revoked:
+            self._notify_revoked(binding)
+        return _SessionAuthorityRegistration(self, identity, token)
+
+    def resolve(
+        self,
+        *,
+        profile: str,
+        durable_session_key: str,
+        runtime_generation: str,
+    ) -> SessionAuthorityBinding:
+        with self._lock:
+            record = self._resolve_locked(
+                profile,
+                durable_session_key,
+                runtime_generation,
+            )
+            return SessionAuthorityBinding(
+                record.profile,
+                record.durable_session_key,
+                record.runtime_generation,
+                record.controller_id,
+                record.lease_deadline_monotonic,
+                record.revision,
+            )
+
+    def current_sequence(
+        self,
+        *,
+        profile: str,
+        durable_session_key: str,
+        runtime_generation: str,
+    ) -> int:
+        with self._lock:
+            return self._resolve_locked(
+                profile,
+                durable_session_key,
+                runtime_generation,
+            ).sequence
+
+    def _resolve_locked(
+        self,
+        profile: str,
+        durable_session_key: str,
+        runtime_generation: str,
+    ) -> _SessionRecord:
+        if self._closed:
+            raise HostSpiUnavailableError()
+        record = self._records.get((profile, durable_session_key))
+        if (
+            record is None
+            or record.token is None
+            or record.runtime_generation != runtime_generation
+            or record.runtime_generation != self._runtime_generation
+            or record.lease_deadline_monotonic <= self._clock.read()
+        ):
+            raise HostSpiUnavailableError()
+        return record
+
+    def _is_current_locked(
+        self,
+        request: ObserverRequest,
+        authority_revision: int,
+    ) -> bool:
+        if self._closed:
+            return False
+        record = self._records.get(
+            (request.profile, request.durable_session_key)
+        )
+        return (
+            record is not None
+            and record.token is not None
+            and record.runtime_generation == request.runtime_generation
+            and record.runtime_generation == self._runtime_generation
+            and record.lease_deadline_monotonic > self._clock.read()
+            and record.revision == authority_revision
+        )
+
+    def _close_binding(self, identity: tuple[str, str], token: object) -> None:
+        revoked: SessionAuthorityBinding | None = None
+        with self._lock:
+            current = self._records.get(identity)
+            if current is None or current.token is not token:
+                return
+            revoked = self._binding_for_record(current)
+            if current.lease_registration is not None:
+                current.lease_registration.close()
+                current.lease_registration = None
+            current.token = None
+            current.controller_id = None
+            current.lease_deadline_monotonic = 0.0
+        self._notify_revoked(revoked)
+
+    def close_all(self) -> None:
+        with self._lock:
+            if self._closed:
+                return
+            self._closed = True
+            revoked = [
+                self._binding_for_record(record)
+                for record in self._records.values()
+                if record.token is not None
+            ]
+            for record in self._records.values():
+                if record.lease_registration is not None:
+                    record.lease_registration.close()
+                    record.lease_registration = None
+            self._records.clear()
+        for binding in revoked:
+            self._notify_revoked(binding)
+
+    def _notify_revoked(self, binding: SessionAuthorityBinding) -> None:
+        listener = self._revocation_listener
+        if listener is not None:
+            listener(binding)
+
+    def _expire_binding(
+        self,
+        identity: tuple[str, str],
+        token: object,
+        revision: int,
+    ) -> None:
+        revoked: SessionAuthorityBinding | None = None
+        with self._lock:
+            record = self._records.get(identity)
+            if (
+                record is None
+                or record.token is not token
+                or record.revision != revision
+            ):
+                return
+            revoked = self._binding_for_record(record)
+            record.token = None
+            record.controller_id = None
+            record.lease_deadline_monotonic = 0.0
+            record.lease_registration = None
+        try:
+            self._notify_revoked(revoked)
+        except BaseException:
+            return
+
+    @staticmethod
+    def _binding_for_record(record: _SessionRecord) -> SessionAuthorityBinding:
+        if record.controller_id is None:
+            raise HostSpiUnavailableError()
+        return SessionAuthorityBinding(
+            record.profile,
+            record.durable_session_key,
+            record.runtime_generation,
+            record.controller_id,
+            record.lease_deadline_monotonic,
+            record.revision,
+        )
+
+
+class _CleanupState(str, Enum):
+    OPEN = "open"
+    CLOSING = "closing"
+    CLOSED = "closed"
+
+
+class _RetryableCleanup:
+    def __init__(self, registration: Registration) -> None:
+        self._registration = registration
+        self._condition = threading.Condition(threading.RLock())
+        self._state = _CleanupState.OPEN
+        self._closing_thread: int | None = None
+
+    @property
+    def closed(self) -> bool:
+        with self._condition:
+            return self._state is _CleanupState.CLOSED
+
+    def close(self) -> None:
+        current_thread = threading.get_ident()
+        with self._condition:
+            while self._state is _CleanupState.CLOSING:
+                if self._closing_thread == current_thread:
+                    raise HostSpiRegistrationError(
+                        "observer cleanup lifecycle re-entry is unavailable"
+                    )
+                self._condition.wait()
+            if self._state is _CleanupState.CLOSED:
+                return
+            self._state = _CleanupState.CLOSING
+            self._closing_thread = current_thread
+        try:
+            self._registration.close()
+        except BaseException:
+            with self._condition:
+                self._state = _CleanupState.OPEN
+                self._closing_thread = None
+                self._condition.notify_all()
+            raise
+        with self._condition:
+            self._state = _CleanupState.CLOSED
+            self._closing_thread = None
+            self._condition.notify_all()
+
+
+class _NoopRegistration:
+    def close(self) -> None:
+        return
+
+
+class _TimerRegistration:
+    def __init__(self, timer: threading.Timer) -> None:
+        self._timer = timer
+
+    def close(self) -> None:
+        self._timer.cancel()
+
+
+class _TimerDeadlineScheduler:
+    def schedule(
+        self,
+        delay_seconds: float,
+        callback: Callable[[], None],
+    ) -> Registration:
+        delay_seconds = _finite_number(
+            delay_seconds,
+            "deadline delay",
+            positive=True,
+        )
+        timer: threading.Timer | None = None
+        start_failed = False
+        try:
+            timer = threading.Timer(delay_seconds, callback)
+            timer.daemon = True
+            timer.start()
+        except BaseException:
+            start_failed = True
+        if start_failed:
+            if timer is not None:
+                try:
+                    timer.cancel()
+                except BaseException:
+                    pass
+            raise HostSpiUnavailableError()
+        if timer is None:
+            raise HostSpiUnavailableError()
+        return _TimerRegistration(timer)
+
+
+class _ObserverState(str, Enum):
+    PREPARED = "prepared"
+    ACTIVE = "active"
+    CLOSING = "closing"
+    CLOSED = "closed"
+
+
+@dataclass
+class _Subscription:
+    identifier: int
+    request: ObserverRequest
+    authority_revision: int
+    sink: EventSink
+    snapshot: ObserverSnapshotV1
+    activation_deadline_monotonic: float
+    cleanup: _RetryableCleanup
+    state: _ObserverState = _ObserverState.PREPARED
+    queue: deque[ObserverEvent] = field(default_factory=deque)
+    deadline_registration: Registration | None = None
+    worker: threading.Thread | None = None
+    cleanup_scheduled: bool = False
+    finish_lock: threading.Lock = field(default_factory=threading.Lock)
+
+
+@dataclass(frozen=True)
+class ObserverCloseFailure:
+    error_type: str
+
+
+@dataclass(frozen=True)
+class ObserverFailureStatus:
+    subscription_id: int
+    category: str
+    lifecycle_state: str
+
+
+class _PreparedObserver:
+    def __init__(self, broker: "ObserverBroker", subscription: _Subscription) -> None:
+        self._broker = broker
+        self._identifier = subscription.identifier
+        self.snapshot = subscription.snapshot
+        self.activation_deadline_monotonic = (
+            subscription.activation_deadline_monotonic
+        )
+
+    def activate(self) -> Registration:
+        return self._broker.activate(self._identifier)
+
+    def close(self) -> None:
+        self._broker.close_subscription(self._identifier, prepared_only=True)
+
+
+class _ActiveObserverRegistration:
+    def __init__(self, broker: "ObserverBroker", identifier: int) -> None:
+        self._broker = broker
+        self._identifier = identifier
+
+    def close(self) -> None:
+        self._broker.close_subscription(self._identifier)
+
+
+class ObserverBroker:
+    def __init__(
+        self,
+        sessions: SessionAuthorityRegistry,
+        lock: threading.RLock,
+        *,
+        activation_timeout_seconds: float,
+        deadline_scheduler: Any,
+        cleanup_factory: Callable[[ObserverRequest], Registration],
+        close_timeout_seconds: float,
+        clock: _MonotonicGuard,
+    ) -> None:
+        activation_timeout_seconds = _finite_number(
+            activation_timeout_seconds,
+            "activation timeout",
+            positive=True,
+        )
+        close_timeout_seconds = _finite_number(
+            close_timeout_seconds,
+            "observer close timeout",
+            positive=True,
+        )
+        self._sessions = sessions
+        self._condition = threading.Condition(lock)
+        self._activation_timeout_seconds = activation_timeout_seconds
+        self._deadline_scheduler = deadline_scheduler
+        self._cleanup_factory = cleanup_factory
+        self._close_timeout_seconds = close_timeout_seconds
+        self._clock = clock
+        self._subscriptions: dict[int, _Subscription] = {}
+        self._order: list[int] = []
+        self._next_identifier = 1
+        self._accepting = True
+        self._failure_statuses: deque[ObserverFailureStatus] = deque(
+            maxlen=MAX_OBSERVER_FAILURE_HISTORY
+        )
+        self._failure_counters: dict[str, int] = {}
+
+    @property
+    def prepared_count(self) -> int:
+        with self._condition:
+            return sum(
+                subscription.state is _ObserverState.PREPARED
+                for subscription in self._subscriptions.values()
+            )
+
+    @property
+    def active_count(self) -> int:
+        with self._condition:
+            return sum(
+                subscription.state is _ObserverState.ACTIVE
+                for subscription in self._subscriptions.values()
+            )
+
+    @property
+    def pending_cleanup_count(self) -> int:
+        with self._condition:
+            return sum(
+                subscription.state is _ObserverState.CLOSING
+                for subscription in self._subscriptions.values()
+            )
+
+    @property
+    def blocked_delivery_count(self) -> int:
+        with self._condition:
+            return sum(
+                subscription.state is _ObserverState.CLOSING
+                and subscription.worker is not None
+                and subscription.worker.is_alive()
+                for subscription in self._subscriptions.values()
+            )
+
+    @property
+    def failure_statuses(self) -> tuple[ObserverFailureStatus, ...]:
+        with self._condition:
+            return tuple(self._failure_statuses)
+
+    @property
+    def failure_counters(self) -> Mapping[str, int]:
+        with self._condition:
+            return MappingProxyType(dict(self._failure_counters))
+
+    def wait_for_pending_cleanup(self, *, minimum: int, timeout: float) -> bool:
+        if type(minimum) is not int or minimum < 0:
+            raise ValueError("minimum must be a non-negative integer")
+        timeout = _finite_number(timeout, "wait timeout", positive=True)
+        with self._condition:
+            return self._condition.wait_for(
+                lambda: sum(
+                    subscription.state is _ObserverState.CLOSING
+                    for subscription in self._subscriptions.values()
+                )
+                >= minimum,
+                timeout=timeout,
+            )
+
+    def prepare_observer(
+        self,
+        request: ObserverRequest,
+        sink: EventSink,
+    ) -> _PreparedObserver:
+        if not callable(sink):
+            raise HostSpiRegistrationError("observer sink must be callable")
+        cleanup_registration = self._cleanup_factory(request)
+        if not callable(getattr(cleanup_registration, "close", None)):
+            raise HostSpiRegistrationError(
+                "observer cleanup factory must return a Registration"
+            )
+        cleanup = _RetryableCleanup(cleanup_registration)
+        subscription: _Subscription | None = None
+        try:
+            with self._condition:
+                if not self._accepting:
+                    raise HostSpiUnavailableError()
+                closing_count = sum(
+                    item.state is _ObserverState.CLOSING
+                    for item in self._subscriptions.values()
+                )
+                if (
+                    len(self._subscriptions) >= MAX_OBSERVERS_TOTAL
+                    or closing_count >= MAX_BLOCKED_OBSERVERS
+                ):
+                    raise HostSpiUnavailableError()
+                record = self._sessions._resolve_locked(
+                    request.profile,
+                    request.durable_session_key,
+                    request.runtime_generation,
+                )
+                scope_count = sum(
+                    self._matches(
+                        item.request,
+                        request.profile,
+                        request.durable_session_key,
+                        request.runtime_generation,
+                    )
+                    for item in self._subscriptions.values()
+                )
+                if scope_count >= MAX_OBSERVERS_PER_SCOPE:
+                    raise HostSpiUnavailableError()
+                snapshot = ObserverSnapshotV1(
+                    profile=record.profile,
+                    durable_session_key=record.durable_session_key,
+                    runtime_generation=record.runtime_generation,
+                    watermark=record.sequence,
+                    events=tuple(record.snapshot_events),
+                )
+                identifier = self._next_identifier
+                self._next_identifier += 1
+                try:
+                    deadline = _finite_number(
+                        self._clock.read() + self._activation_timeout_seconds,
+                        "activation deadline",
+                    )
+                except (ObserverClockError, ValueError):
+                    raise HostSpiUnavailableError() from None
+                subscription = _Subscription(
+                    identifier=identifier,
+                    request=request,
+                    authority_revision=record.revision,
+                    sink=sink,
+                    snapshot=snapshot,
+                    activation_deadline_monotonic=deadline,
+                    cleanup=cleanup,
+                )
+                self._subscriptions[identifier] = subscription
+                self._order.append(identifier)
+            deadline_registration = self._deadline_scheduler.schedule(
+                self._activation_timeout_seconds,
+                lambda: self._expire(identifier),
+            )
+            with self._condition:
+                subscription.deadline_registration = deadline_registration
+                if subscription.state is not _ObserverState.PREPARED:
+                    deadline_registration.close()
+                    expired_before_return = True
+                else:
+                    expired_before_return = False
+            if expired_before_return:
+                raise ObserverStateError()
+            return _PreparedObserver(self, subscription)
+        except BaseException:
+            if subscription is not None:
+                self._transition_to_closing(subscription)
+                self._finish_close(subscription)
+            else:
+                cleanup.close()
+            raise
+
+    def activate(self, identifier: int) -> Registration:
+        subscription: _Subscription | None
+        worker_start_failed = False
+        with self._condition:
+            subscription = self._subscriptions.get(identifier)
+            if (
+                subscription is None
+                or subscription.state is not _ObserverState.PREPARED
+            ):
+                raise ObserverStateError()
+            try:
+                expired = (
+                    self._clock.read()
+                    >= subscription.activation_deadline_monotonic
+                    or not self._sessions._is_current_locked(
+                        subscription.request,
+                        subscription.authority_revision,
+                    )
+                )
+            except ObserverClockError:
+                expired = True
+            if expired:
+                self._transition_to_closing_locked(subscription)
+                rejected = True
+            else:
+                subscription.state = _ObserverState.ACTIVE
+                if subscription.deadline_registration is not None:
+                    subscription.deadline_registration.close()
+                    subscription.deadline_registration = None
+                worker = threading.Thread(
+                    target=self._worker,
+                    args=(subscription,),
+                    name=f"hermes-observer-{identifier}",
+                    daemon=True,
+                )
+                subscription.worker = worker
+                rejected = False
+                try:
+                    worker.start()
+                except BaseException:
+                    worker_start_failed = True
+                    self._transition_to_closing_locked(subscription)
+                    self._record_failure_locked(
+                        subscription,
+                        "worker_start_failed",
+                    )
+        if rejected:
+            self._finish_close(subscription)
+            raise ObserverStateError()
+        if worker_start_failed:
+            try:
+                self._finish_close(subscription)
+            except BaseException:
+                pass
+            raise HostSpiRegistrationError("observer worker start failed")
+        return _ActiveObserverRegistration(self, identifier)
+
+    def close_subscription(
+        self,
+        identifier: int,
+        *,
+        prepared_only: bool = False,
+    ) -> None:
+        with self._condition:
+            subscription = self._subscriptions.get(identifier)
+            if subscription is None or subscription.state is _ObserverState.CLOSED:
+                return
+            if prepared_only and subscription.state is _ObserverState.ACTIVE:
+                return
+            self._transition_to_closing_locked(subscription)
+        self._finish_close(subscription)
+
+    def publish(
+        self,
+        *,
+        profile: str,
+        durable_session_key: str,
+        runtime_generation: str,
+        sequence: int,
+        display_event: DisplaySafeEventV1,
+    ) -> ObserverEvent:
+        retire: list[_Subscription] = []
+        with self._condition:
+            record = self._sessions._resolve_locked(
+                profile,
+                durable_session_key,
+                runtime_generation,
+            )
+            if type(sequence) is not int or sequence != record.sequence + 1:
+                retire = self._retire_scope_locked(
+                    profile,
+                    durable_session_key,
+                    runtime_generation,
+                    record.revision,
+                )
+                sequence_error = True
+            else:
+                sequence_error = False
+                event = ObserverEvent(
+                    profile=profile,
+                    durable_session_key=durable_session_key,
+                    runtime_generation=runtime_generation,
+                    sequence=sequence,
+                    event_type=display_event.event_type,
+                    payload=display_event.payload,
+                )
+                if self._event_size(event) > MAX_OBSERVER_FRAME_BYTES:
+                    retire = self._retire_scope_locked(
+                        profile,
+                        durable_session_key,
+                        runtime_generation,
+                        record.revision,
+                    )
+                    frame_error = True
+                else:
+                    frame_error = False
+                    record.sequence = sequence
+                    record.snapshot_events.append(event)
+                    for subscription in list(self._subscriptions.values()):
+                        if (
+                            subscription.state
+                            not in {_ObserverState.PREPARED, _ObserverState.ACTIVE}
+                            or subscription.authority_revision != record.revision
+                            or not self._matches(
+                                subscription.request,
+                                profile,
+                                durable_session_key,
+                                runtime_generation,
+                            )
+                        ):
+                            continue
+                        if len(subscription.queue) >= MAX_OBSERVER_QUEUE_FRAMES:
+                            self._transition_to_closing_locked(subscription)
+                            retire.append(subscription)
+                            continue
+                        subscription.queue.append(event)
+                    self._condition.notify_all()
+        for subscription in retire:
+            self._schedule_finish_close(subscription)
+        if sequence_error:
+            raise ObserverSequenceError()
+        if frame_error:
+            raise ObserverFrameError()
+        return event
+
+    def reject_unsafe_event(
+        self,
+        *,
+        profile: str,
+        durable_session_key: str,
+        runtime_generation: str,
+    ) -> None:
+        with self._condition:
+            record = self._sessions._resolve_locked(
+                profile,
+                durable_session_key,
+                runtime_generation,
+            )
+            retire = self._retire_scope_locked(
+                profile,
+                durable_session_key,
+                runtime_generation,
+                record.revision,
+            )
+        for subscription in retire:
+            self._schedule_finish_close(subscription)
+
+    def revoke_scope(self, binding: SessionAuthorityBinding) -> None:
+        with self._condition:
+            retire = self._retire_scope_locked(
+                binding.profile,
+                binding.durable_session_key,
+                binding.runtime_generation,
+                binding.revision,
+            )
+        for subscription in retire:
+            try:
+                self._finish_close(subscription)
+            except BaseException:
+                # The retryable cleanup remains registered for close_all().
+                continue
+
+    def close_all(self) -> tuple[ObserverCloseFailure, ...]:
+        failures: list[ObserverCloseFailure] = []
+        absolute_deadline = time.monotonic() + self._close_timeout_seconds
+        with self._condition:
+            self._accepting = False
+            work = [
+                self._subscriptions[identifier]
+                for identifier in reversed(self._order)
+                if identifier in self._subscriptions
+            ]
+            for subscription in work:
+                self._transition_to_closing_locked(subscription)
+        for subscription in work:
+            try:
+                self._finish_close(
+                    subscription,
+                    absolute_deadline=absolute_deadline,
+                )
+            except BaseException as error:
+                failures.append(ObserverCloseFailure(type(error).__name__))
+        return tuple(failures)
+
+    def _expire(self, identifier: int) -> None:
+        with self._condition:
+            subscription = self._subscriptions.get(identifier)
+            if (
+                subscription is None
+                or subscription.state is not _ObserverState.PREPARED
+            ):
+                return
+            self._transition_to_closing_locked(subscription)
+        try:
+            self._finish_close(subscription)
+        except BaseException:
+            return
+
+    def _worker(self, subscription: _Subscription) -> None:
+        while True:
+            with self._condition:
+                while (
+                    subscription.state is _ObserverState.ACTIVE
+                    and not subscription.queue
+                ):
+                    self._condition.wait()
+                if subscription.state is not _ObserverState.ACTIVE:
+                    self._condition.notify_all()
+                    return
+                try:
+                    is_current = self._sessions._is_current_locked(
+                        subscription.request,
+                        subscription.authority_revision,
+                    )
+                except ObserverClockError:
+                    self._transition_to_closing_locked(subscription)
+                    self._record_failure_locked(
+                        subscription,
+                        "clock_failed",
+                    )
+                    stale = True
+                else:
+                    if not is_current:
+                        self._transition_to_closing_locked(subscription)
+                        stale = True
+                    else:
+                        stale = False
+                        event = subscription.queue.popleft()
+            if stale:
+                self._schedule_finish_close(subscription)
+                return
+            try:
+                subscription.sink(event)
+            except BaseException:
+                with self._condition:
+                    self._transition_to_closing_locked(subscription)
+                    self._record_failure_locked(
+                        subscription,
+                        "sink_delivery_failed",
+                    )
+                self._schedule_finish_close(subscription)
+                return
+
+    def _transition_to_closing(self, subscription: _Subscription) -> None:
+        with self._condition:
+            self._transition_to_closing_locked(subscription)
+
+    def _transition_to_closing_locked(self, subscription: _Subscription) -> None:
+        if subscription.state in {_ObserverState.CLOSING, _ObserverState.CLOSED}:
+            return
+        subscription.state = _ObserverState.CLOSING
+        subscription.queue.clear()
+        if subscription.deadline_registration is not None:
+            subscription.deadline_registration.close()
+            subscription.deadline_registration = None
+        self._condition.notify_all()
+
+    def _finish_close(
+        self,
+        subscription: _Subscription,
+        *,
+        absolute_deadline: float | None = None,
+    ) -> None:
+        if absolute_deadline is None:
+            absolute_deadline = time.monotonic() + self._close_timeout_seconds
+        with subscription.finish_lock:
+            worker = subscription.worker
+            if (
+                worker is not None
+                and worker.is_alive()
+                and worker.ident != threading.get_ident()
+            ):
+                remaining = max(0.0, absolute_deadline - time.monotonic())
+                worker.join(timeout=remaining)
+                if worker.is_alive():
+                    with self._condition:
+                        subscription.state = _ObserverState.CLOSING
+                        subscription.cleanup_scheduled = False
+                        self._record_failure_locked(
+                            subscription,
+                            "delivery_blocked",
+                        )
+                    raise ObserverDeliveryBlockedError()
+            cleanup_error: BaseException | None = None
+            try:
+                subscription.cleanup.close()
+            except BaseException as error:
+                cleanup_error = error
+                with self._condition:
+                    subscription.state = _ObserverState.CLOSING
+                    subscription.cleanup_scheduled = False
+                    self._record_failure_locked(
+                        subscription,
+                        "cleanup_failed",
+                    )
+            if cleanup_error is not None:
+                if isinstance(cleanup_error, Exception):
+                    raise HostSpiRegistrationError("observer cleanup failed")
+                raise cleanup_error
+            with self._condition:
+                subscription.state = _ObserverState.CLOSED
+                subscription.cleanup_scheduled = False
+                self._subscriptions.pop(subscription.identifier, None)
+                if subscription.identifier in self._order:
+                    self._order.remove(subscription.identifier)
+                self._condition.notify_all()
+
+    def _schedule_finish_close(self, subscription: _Subscription) -> None:
+        with self._condition:
+            if subscription.cleanup_scheduled:
+                return
+            subscription.cleanup_scheduled = True
+
+        def finish() -> None:
+            try:
+                self._finish_close(subscription)
+            except BaseException:
+                return
+
+        thread = threading.Thread(
+            target=finish,
+            name=f"hermes-observer-cleanup-{subscription.identifier}",
+            daemon=True,
+        )
+        try:
+            thread.start()
+        except BaseException:
+            with self._condition:
+                subscription.cleanup_scheduled = False
+                self._record_failure_locked(
+                    subscription,
+                    "cleanup_worker_start_failed",
+                )
+            try:
+                self._finish_close(subscription)
+            except BaseException:
+                return
+
+    def _retire_scope_locked(
+        self,
+        profile: str,
+        durable_session_key: str,
+        runtime_generation: str,
+        authority_revision: int,
+    ) -> list[_Subscription]:
+        retire: list[_Subscription] = []
+        for subscription in list(self._subscriptions.values()):
+            if (
+                subscription.state
+                in {_ObserverState.PREPARED, _ObserverState.ACTIVE}
+                and subscription.authority_revision == authority_revision
+                and self._matches(
+                    subscription.request,
+                    profile,
+                    durable_session_key,
+                    runtime_generation,
+                )
+            ):
+                self._transition_to_closing_locked(subscription)
+                retire.append(subscription)
+        return retire
+
+    def _record_failure_locked(
+        self,
+        subscription: _Subscription,
+        category: str,
+    ) -> None:
+        self._failure_statuses.append(
+            ObserverFailureStatus(
+                subscription_id=subscription.identifier,
+                category=category,
+                lifecycle_state=subscription.state.value,
+            )
+        )
+        self._failure_counters[category] = (
+            self._failure_counters.get(category, 0) + 1
+        )
+
+    @staticmethod
+    def _matches(
+        request: ObserverRequest,
+        profile: str,
+        durable_session_key: str,
+        runtime_generation: str,
+    ) -> bool:
+        return (
+            request.profile == profile
+            and request.durable_session_key == durable_session_key
+            and request.runtime_generation == runtime_generation
+        )
+
+    @staticmethod
+    def _event_size(event: ObserverEvent) -> int:
+        encoded = json.dumps(
+            {
+                "profile": event.profile,
+                "durable_session_key": event.durable_session_key,
+                "runtime_generation": event.runtime_generation,
+                "sequence": event.sequence,
+                "event_type": event.event_type,
+                "payload": dict(event.payload),
+            },
+            ensure_ascii=False,
+            sort_keys=True,
+            separators=(",", ":"),
+            allow_nan=False,
+        ).encode("utf-8")
+        return len(encoded)
+
+
+class ExtensionHostFacadeV1:
+    host_api_version: Literal[1] = 1
+
+    def __init__(self, runtime: "ExtensionRuntimeV1") -> None:
+        self._runtime = runtime
+
+    def runtime_descriptor(self) -> RuntimeDescriptor:
+        return self._runtime.runtime_descriptor()
+
+    def prepare_observer(
+        self,
+        request: ObserverRequest,
+        sink: EventSink,
+    ) -> _PreparedObserver:
+        capabilities = self._runtime.capabilities
+        missing = request.required_capabilities - capabilities
+        if missing or request.observer_contract != 1:
+            raise HostSpiCapabilityError(
+                missing or {"session.observe.output-parity.v1"}
+            )
+        descriptor = self.runtime_descriptor()
+        if (
+            request.profile != descriptor.profile
+            or request.runtime_generation != descriptor.runtime_generation
+        ):
+            raise HostSpiUnavailableError()
+        return self._runtime.observers.prepare_observer(request, sink)
+
+    def register_local_endpoint(self, _endpoint: object) -> Registration:
+        raise HostSpiUnavailableError()
+
+    def control_snapshot(self, _scope: ControlScope) -> object:
+        raise HostSpiUnavailableError()
+
+    def invoke_owner_action(self, _request: OwnerActionRequest) -> object:
+        raise HostSpiUnavailableError()
+
+    def add_runtime_listener(self, _listener: object) -> Registration:
+        raise HostSpiUnavailableError()
+
+    def audit(self, event: SafeAuditEvent) -> None:
+        self._runtime.audit(event)
+
+
+class ExtensionRuntimeV1:
+    """Protocol-neutral Stage 2 runtime; not a production composition root."""
+
+    def __init__(
+        self,
+        *,
+        profile: str,
+        runtime_generation: str,
+        host_bundle_id: str,
+        activation_timeout_seconds: float = 3.0,
+        observer_close_timeout_seconds: float = 0.25,
+        deadline_scheduler: Any | None = None,
+        authority_deadline_scheduler: Any | None = None,
+        observer_cleanup_factory: Callable[[ObserverRequest], Registration]
+        | None = None,
+        audit_sink: Callable[[SafeAuditEvent], None] | None = None,
+        monotonic: Callable[[], float] = time.monotonic,
+    ) -> None:
+        self._profile = _canonical_text(profile, "profile")
+        self._runtime_generation = _canonical_text(
+            runtime_generation, "runtime_generation"
+        )
+        self._host_bundle_id = _canonical_text(host_bundle_id, "host_bundle_id")
+        activation_timeout_seconds = _finite_number(
+            activation_timeout_seconds,
+            "activation timeout",
+            positive=True,
+        )
+        observer_close_timeout_seconds = _finite_number(
+            observer_close_timeout_seconds,
+            "observer close timeout",
+            positive=True,
+        )
+        if audit_sink is not None and not callable(audit_sink):
+            raise ValueError("audit sink must be callable")
+        self._lock = threading.RLock()
+        self._clock = _MonotonicGuard(monotonic)
+        self._audit_sink = audit_sink
+        self._accepting = True
+        self.sessions = SessionAuthorityRegistry(
+            self._lock,
+            runtime_generation=self._runtime_generation,
+            clock=self._clock,
+            deadline_scheduler=(
+                authority_deadline_scheduler or _TimerDeadlineScheduler()
+            ),
+        )
+        self.observers = ObserverBroker(
+            self.sessions,
+            self._lock,
+            activation_timeout_seconds=activation_timeout_seconds,
+            deadline_scheduler=deadline_scheduler or _TimerDeadlineScheduler(),
+            cleanup_factory=observer_cleanup_factory or (lambda _request: _NoopRegistration()),
+            close_timeout_seconds=observer_close_timeout_seconds,
+            clock=self._clock,
+        )
+        self.sessions.set_revocation_listener(self.observers.revoke_scope)
+        self.host = ExtensionHostFacadeV1(self)
+
+    @property
+    def capabilities(self) -> frozenset[str]:
+        with self._lock:
+            if not self._accepting:
+                return frozenset()
+            capabilities = {
+                "extension.lifecycle.v1",
+                "runtime.descriptor.v1",
+                "session.observe.v1",
+            }
+            if self._audit_sink is not None:
+                capabilities.add("audit.safe.v1")
+            return frozenset(capabilities)
+
+    def runtime_descriptor(self) -> RuntimeDescriptor:
+        with self._lock:
+            return RuntimeDescriptor(
+                profile=self._profile,
+                runtime_generation=self.sessions.runtime_generation,
+                host_bundle_id=self._host_bundle_id,
+                state="ready" if self._accepting else "unavailable",
+                capabilities={capability: 1 for capability in self.capabilities},
+            )
+
+    def publish_event(
+        self,
+        *,
+        profile: str,
+        durable_session_key: str,
+        runtime_generation: str,
+        sequence: int,
+        event_type: str,
+        payload: Mapping[str, object],
+    ) -> ObserverEvent:
+        with self._lock:
+            if not self._accepting:
+                raise HostSpiUnavailableError()
+        try:
+            display_event = DisplaySafeEventV1(
+                event_type=event_type,
+                payload=payload,  # type: ignore[arg-type]
+            )
+        except (TypeError, ValueError, UnicodeError):
+            self.observers.reject_unsafe_event(
+                profile=profile,
+                durable_session_key=durable_session_key,
+                runtime_generation=runtime_generation,
+            )
+            raise ObserverFrameError() from None
+        return self.observers.publish(
+            profile=profile,
+            durable_session_key=durable_session_key,
+            runtime_generation=runtime_generation,
+            sequence=sequence,
+            display_event=display_event,
+        )
+
+    def audit(self, event: SafeAuditEvent) -> None:
+        if not isinstance(event, SafeAuditEvent):
+            raise HostSpiRegistrationError("safe audit event is unavailable")
+        with self._lock:
+            if not self._accepting:
+                raise HostSpiUnavailableError()
+            if (
+                event.profile != self._profile
+                or event.runtime_generation != self.sessions.runtime_generation
+            ):
+                raise HostSpiUnavailableError()
+        sink = self._audit_sink
+        if sink is None:
+            raise HostSpiUnavailableError()
+        try:
+            _validate_safe_audit_event(event)
+        except HostSpiRegistrationError:
+            raise
+        except BaseException:
+            raise HostSpiRegistrationError(
+                "safe audit event is unavailable"
+            ) from None
+        delivery_failed = False
+        try:
+            sink(event)
+        except BaseException:
+            delivery_failed = True
+        if delivery_failed:
+            raise HostSpiRegistrationError("safe audit sink failed")
+
+    def close(self) -> tuple[ObserverCloseFailure, ...]:
+        with self._lock:
+            self._accepting = False
+        failures = self.observers.close_all()
+        self.sessions.close_all()
+        return failures
+
+
