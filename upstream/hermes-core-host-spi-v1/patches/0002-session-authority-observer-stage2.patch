+        ("reasoning.delta", {"text": "hidden"}),
+        ("assistant.delta", {"reasoning": "hidden", "text": "visible"}),
+        ("tool.status", {"tool_name": "shell", "status": "running", "output": "raw"}),
+        ("session.status", {"status": "waiting", "approval": "secret"}),
+    )
+    for event_type, payload in invalid:
+        with pytest.raises(ValueError):
+            DisplaySafeEventV1(event_type=event_type, payload=payload)
+
+    runtime = _runtime()
+    _bind(runtime)
+    runtime.host.prepare_observer(_request(), _RecordingSink())
+    with pytest.raises(ObserverFrameError):
+        runtime.publish_event(
+            profile="default",
+            durable_session_key="session-1",
+            runtime_generation="generation-1",
+            sequence=1,
+            event_type="assistant.delta",
+            payload={"text": "界" * (MAX_OBSERVER_FRAME_BYTES // 2)},
+        )
+    assert runtime.sessions.current_sequence(
+        profile="default",
+        durable_session_key="session-1",
+        runtime_generation="generation-1",
+    ) == 0
+    assert runtime.close() == ()
