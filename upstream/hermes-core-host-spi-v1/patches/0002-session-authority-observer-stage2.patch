+def test_sink_failure_during_close_does_not_deadlock_worker_and_closer() -> None:
+    close_events: list[str] = []
+    runtime = _runtime(
+        observer_cleanup_factory=lambda request: _CloseRegistration(
+            request.durable_session_key,
+            close_events,
+        ),
+        observer_close_timeout_seconds=0.2,
+    )
+    _bind(runtime)
+    sink = _BlockingFailingSink()
+    runtime.host.prepare_observer(_request(), sink).activate()
+    runtime.publish_event(
+        profile="default",
+        durable_session_key="session-1",
+        runtime_generation="generation-1",
+        sequence=1,
+        event_type="assistant.delta",
+        payload={"text": "in-flight"},
+    )
+    assert sink.started.wait(timeout=3)
+    close_results = []
+    closer = threading.Thread(target=lambda: close_results.append(runtime.close()))
+    closer.start()
+    assert runtime.observers.wait_for_pending_cleanup(minimum=1, timeout=1.0)
+    sink.release_for_test_cleanup.set()
+    closer.join(timeout=1)
+
+    assert not closer.is_alive()
+    assert close_results == [()]
+    assert close_events == ["close:session-1"]
+    assert runtime.observers.pending_cleanup_count == 0
