+def _wait_until(predicate: Callable[[], bool], *, timeout: float = 3.0) -> None:
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        if predicate():
+            return
+        time.sleep(0.005)
+    raise AssertionError("condition did not become true before timeout")
+
+
+class _RecordingSink:
+    def __init__(self) -> None:
+        self.events = []
+        self._lock = threading.Lock()
+
+    def __call__(self, event) -> None:
+        with self._lock:
+            self.events.append(event)
+
+    @property
+    def count(self) -> int:
+        with self._lock:
+            return len(self.events)
+
+
+class _BlockingSink(_RecordingSink):
+    def __init__(self) -> None:
+        super().__init__()
+        self.started = threading.Event()
+        self.release = threading.Event()
+
+    def __call__(self, event) -> None:
+        self.started.set()
+        if not self.release.wait(timeout=5):
+            raise RuntimeError("blocking sink timed out")
+        super().__call__(event)
+
+
+class _PermanentBlockingSink:
+    def __init__(self) -> None:
+        self.started = threading.Event()
+        self.release_for_test_cleanup = threading.Event()
+
+    def __call__(self, _event) -> None:
+        self.started.set()
+        self.release_for_test_cleanup.wait()
+
+
+class _BlockingFailingSink(_PermanentBlockingSink):
+    def __call__(self, event) -> None:
+        super().__call__(event)
+        raise RuntimeError("private sink failure")
+
+
+class _FailingSink:
+    def __init__(self) -> None:
+        self.calls = 0
+
+    def __call__(self, _event) -> None:
+        self.calls += 1
+        raise RuntimeError("private sink detail")
+
+
+class _CloseRegistration:
+    def __init__(
+        self,
+        label: str,
+        events: list[str],
+        *,
+        failures: int = 0,
+    ) -> None:
+        self.label = label
+        self.events = events
+        self.failures = failures
+        self.attempts = 0
+
+    def close(self) -> None:
+        self.attempts += 1
+        self.events.append(f"close:{self.label}")
+        if self.failures:
+            self.failures -= 1
+            raise RuntimeError("private close detail")
+
+
+class _ScheduledHandle:
+    def __init__(self) -> None:
+        self.cancelled = False
+
+    def close(self) -> None:
+        self.cancelled = True
+
+
+class _ManualDeadlineScheduler:
+    def __init__(self) -> None:
+        self.callbacks: list[Callable[[], None]] = []
+        self.handles: list[_ScheduledHandle] = []
+
+    def schedule(self, _delay_seconds: float, callback: Callable[[], None]):
+        handle = _ScheduledHandle()
+        self.callbacks.append(callback)
+        self.handles.append(handle)
+        return handle
+
+    def fire(self, index: int = -1) -> None:
+        # Fire even if cancellation won to exercise the lifecycle race gate.
+        self.callbacks[index]()
+
+
+class _ImmediateDeadlineScheduler:
+    def schedule(self, _delay_seconds: float, callback: Callable[[], None]):
+        handle = _ScheduledHandle()
+        callback()
+        return handle
+
+
+class _FailingCallDeadlineScheduler(_ManualDeadlineScheduler):
+    def __init__(self, *fail_on_calls: int) -> None:
+        super().__init__()
+        self._fail_on_calls = set(fail_on_calls)
+        self.calls = 0
+
+    def schedule(self, delay_seconds: float, callback: Callable[[], None]):
+        self.calls += 1
+        if self.calls in self._fail_on_calls:
+            raise RuntimeError("private scheduler failure")
+        return super().schedule(delay_seconds, callback)
+
+
+class _ImmediateOnceDeadlineScheduler(_ManualDeadlineScheduler):
+    def __init__(self) -> None:
+        super().__init__()
+        self.calls = 0
+
+    def schedule(self, delay_seconds: float, callback: Callable[[], None]):
+        self.calls += 1
+        if self.calls == 1:
+            handle = _ScheduledHandle()
+            callback()
+            return handle
+        return super().schedule(delay_seconds, callback)
+
+
+class _AsyncEarlyFireDeadlineScheduler(_ManualDeadlineScheduler):
+    def __init__(self, *early_fire_calls: int) -> None:
+        super().__init__()
+        self._early_fire_calls = set(early_fire_calls)
+        self.calls = 0
+        self.threads: list[threading.Thread] = []
+
+    def schedule(self, delay_seconds: float, callback: Callable[[], None]):
+        self.calls += 1
+        if self.calls not in self._early_fire_calls:
+            return super().schedule(delay_seconds, callback)
+        handle = _ScheduledHandle()
+        entered = threading.Barrier(2)
+        completed = threading.Event()
+
+        def fire_on_independent_thread() -> None:
+            try:
+                entered.wait(timeout=3)
+                callback()
+            finally:
+                completed.set()
+
+        thread = threading.Thread(target=fire_on_independent_thread, daemon=True)
+        self.threads.append(thread)
+        thread.start()
+        entered.wait(timeout=3)
+        # A correct pre-commit callback completes without acquiring the registry
+        # lock. The timeout only prevents an old deadlocking implementation from
+        # leaking the test thread; it is not used to order the passing path.
+        completed.wait(timeout=3)
+        return handle
+
+    def join_threads(self) -> None:
+        for thread in self.threads:
+            thread.join(timeout=3)
+            assert not thread.is_alive()
+
