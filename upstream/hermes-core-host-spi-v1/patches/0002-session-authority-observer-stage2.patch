+def test_utf8_exact_frame_boundary_passes_and_surrogate_retires_scope() -> None:
+    def text_for_exact_frame(*, key: str, sequence: int) -> str:
+        frame = {
+            "profile": "default",
+            "durable_session_key": key,
+            "runtime_generation": "generation-1",
+            "sequence": sequence,
+            "event_type": "assistant.delta",
+            "payload": {"text": ""},
+        }
+        empty_size = len(
+            json.dumps(
+                frame,
+                ensure_ascii=False,
+                sort_keys=True,
+                separators=(",", ":"),
+                allow_nan=False,
+            ).encode("utf-8")
+        )
+        remaining = MAX_OBSERVER_FRAME_BYTES - empty_size
+        text = "界" * (remaining // 3) + "a" * (remaining % 3)
+        frame["payload"] = {"text": text}
+        assert len(
+            json.dumps(
+                frame,
+                ensure_ascii=False,
+                sort_keys=True,
+                separators=(",", ":"),
+                allow_nan=False,
+            ).encode("utf-8")
+        ) == MAX_OBSERVER_FRAME_BYTES
+        return text
+
+    runtime = _runtime()
+    _bind(runtime, "boundary")
+    sink = _RecordingSink()
+    runtime.host.prepare_observer(_request("boundary"), sink).activate()
+    runtime.publish_event(
+        profile="default",
+        durable_session_key="boundary",
+        runtime_generation="generation-1",
+        sequence=1,
+        event_type="assistant.delta",
+        payload={"text": text_for_exact_frame(key="boundary", sequence=1)},
+    )
+    _wait_until(lambda: sink.count == 1)
+    with pytest.raises(ObserverFrameError):
+        runtime.publish_event(
+            profile="default",
+            durable_session_key="boundary",
+            runtime_generation="generation-1",
+            sequence=2,
+            event_type="assistant.delta",
+            payload={
+                "text": text_for_exact_frame(key="boundary", sequence=2) + "a"
+            },
+        )
+    _wait_until(lambda: runtime.observers.active_count == 0)
+    assert runtime.sessions.current_sequence(
+        profile="default",
+        durable_session_key="boundary",
+        runtime_generation="generation-1",
+    ) == 1
+
+    _bind(runtime, "surrogate")
+    runtime.host.prepare_observer(
+        _request("surrogate"), _RecordingSink()
+    ).activate()
+    with pytest.raises(ObserverFrameError) as error:
+        runtime.publish_event(
+            profile="default",
+            durable_session_key="surrogate",
+            runtime_generation="generation-1",
+            sequence=1,
+            event_type="assistant.delta",
+            payload={"text": "unsafe-\ud800"},
+        )
+    assert error.value.__cause__ is None
+    _wait_until(lambda: runtime.observers.active_count == 0)
+    assert runtime.close() == ()
+
