+) -> None:
+    runtime = _runtime(monotonic=lambda: 10.0)
+    original_timer = runtime_module.threading.Timer
+    if failure_point == "creation":
+
+        def fail_timer_creation(*_args, **_kwargs):
+            raise RuntimeError("private timer creation failure")
+
+        monkeypatch.setattr(runtime_module.threading, "Timer", fail_timer_creation)
+    else:
+        original_start = original_timer.start
+
+        def fail_timer_start(_timer) -> None:
+            raise RuntimeError("private timer start failure")
+
+        monkeypatch.setattr(original_timer, "start", fail_timer_start)
+
+    with pytest.raises(HostSpiUnavailableError) as error:
