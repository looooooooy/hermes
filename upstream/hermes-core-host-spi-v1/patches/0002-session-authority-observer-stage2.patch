+def test_runtime_descriptor_advertises_only_real_stage2_components() -> None:
+    runtime = _runtime()
+
+    descriptor = runtime.host.runtime_descriptor()
+
+    assert descriptor.profile == "default"
+    assert descriptor.runtime_generation == "generation-1"
+    assert descriptor.state == "ready"
+    assert descriptor.capabilities == {
+        "extension.lifecycle.v1": 1,
+        "runtime.descriptor.v1": 1,
+        "session.observe.v1": 1,
+    }
+    assert "session.owner-actions.v1" not in descriptor.capabilities
+    assert "session.observe.output-parity.v1" not in descriptor.capabilities
+    assert set(vars(descriptor)) == {
+        "profile",
+        "runtime_generation",
+        "host_bundle_id",
+        "state",
+        "capabilities",
+    }
+    assert not any(
+        sensitive in repr(descriptor).lower()
+        for sensitive in ("socket_path", "token", "credential", "command")
+    )
+
+    _bind(runtime)
+    with pytest.raises(HostSpiCapabilityError):
+        runtime.host.prepare_observer(
+            _request(
+                observer_contract=2,
+                required_capabilities=frozenset(
+                    {"session.observe.output-parity.v1"}
+                ),
+            ),
+            _RecordingSink(),
+        )
+    with pytest.raises(HostSpiUnavailableError):
+        runtime.host.invoke_owner_action(
+            OwnerActionRequest(
+                profile="default",
+                durable_session_key="session-1",
+                runtime_generation="generation-1",
+                command_id="command-1",
+                method="prompt.submit",
+                payload={"text": "not-executed"},
+            )
+        )
+    assert runtime.close() == ()
+    closed_descriptor = runtime.host.runtime_descriptor()
+    assert closed_descriptor.state == "unavailable"
+    assert closed_descriptor.capabilities == {}
