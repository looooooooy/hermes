+    original_listener = runtime.sessions._revocation_listener
+    assert original_listener is not None
+    notification_started = threading.Event()
+    allow_notification = threading.Event()
+
+    def delayed_revocation(binding) -> None:
+        notification_started.set()
+        assert allow_notification.wait(timeout=3)
+        original_listener(binding)
+
+    runtime.sessions._revocation_listener = delayed_revocation
+    rebind_results = []
+    rebind_thread = threading.Thread(
+        target=lambda: rebind_results.append(
+            _bind(
