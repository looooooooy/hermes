+def test_concurrent_close_on_one_registration_includes_finish_lock_wait() -> None:
+    close_timeout = 0.08
+    closer_count = 4
+    runtime = _runtime(
+        monotonic=lambda: 10.0,
+        observer_close_timeout_seconds=close_timeout,
+        authority_deadline_scheduler=_ManualDeadlineScheduler(),
+    )
+    _bind(runtime, lease_deadline_monotonic=20.0)
+    sink = _PermanentBlockingSink()
+    registration = runtime.host.prepare_observer(_request(), sink).activate()
+    runtime.publish_event(
+        profile="default",
+        durable_session_key="session-1",
+        runtime_generation="generation-1",
+        sequence=1,
+        event_type="assistant.delta",
+        payload={"text": "blocks-concurrent-close"},
+    )
+    assert sink.started.wait(timeout=3)
+
+    start_barrier = threading.Barrier(closer_count + 1)
+    durations: list[float] = []
+    failures: list[str] = []
+    result_lock = threading.Lock()
+
+    def close_concurrently() -> None:
+        started = time.monotonic()
+        start_barrier.wait(timeout=3)
+        try:
+            registration.close()
+        except BaseException as error:
+            error_type = type(error).__name__
+        else:
+            error_type = "none"
+        elapsed = time.monotonic() - started
+        with result_lock:
+            durations.append(elapsed)
+            failures.append(error_type)
+
+    threads = [
+        threading.Thread(target=close_concurrently, daemon=True)
+        for _ in range(closer_count)
+    ]
+    for thread in threads:
+        thread.start()
+    start_barrier.wait(timeout=3)
+    for thread in threads:
+        thread.join(timeout=3)
+        assert not thread.is_alive()
+
+    try:
+        assert failures == ["ObserverDeliveryBlockedError"] * closer_count
+        assert len(durations) == closer_count
+        assert max(durations) < close_timeout * 2.5
+    finally:
+        sink.release_for_test_cleanup.set()
+        _wait_until(
+            lambda: not any(
+                thread.name.startswith("hermes-observer-")
+                and not thread.name.startswith("hermes-observer-cleanup-")
+                for thread in threading.enumerate()
+            )
+        )
+        cleanup_failures = runtime.close()
+    assert cleanup_failures == ()
