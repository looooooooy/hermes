+def test_permanently_blocked_sink_has_bounded_close_and_retryable_lifecycle() -> None:
+    close_events: list[str] = []
+
+    def cleanup_factory(request):
+        return _CloseRegistration(request.durable_session_key, close_events)
+
+    runtime = _runtime(
+        observer_cleanup_factory=cleanup_factory,
+        observer_close_timeout_seconds=0.03,
+    )
+    _bind(runtime, "blocked")
+    _bind(runtime, "healthy")
+    blocked = _PermanentBlockingSink()
+    healthy = _RecordingSink()
+    runtime.host.prepare_observer(_request("blocked"), blocked).activate()
+    runtime.host.prepare_observer(_request("healthy"), healthy).activate()
+    runtime.publish_event(
+        profile="default",
+        durable_session_key="blocked",
+        runtime_generation="generation-1",
+        sequence=1,
+        event_type="assistant.delta",
+        payload={"text": "blocks-forever"},
+    )
+    assert blocked.started.wait(timeout=3)
+    runtime.publish_event(
+        profile="default",
+        durable_session_key="healthy",
+        runtime_generation="generation-1",
+        sequence=1,
+        event_type="assistant.message",
+        payload={"text": "healthy"},
+    )
+    _wait_until(lambda: healthy.count == 1)
+
+    started = time.monotonic()
+    failures = runtime.close()
+    elapsed = time.monotonic() - started
+
+    assert elapsed < 0.5
+    assert [failure.error_type for failure in failures] == [
+        "ObserverDeliveryBlockedError"
+    ]
+    assert close_events == ["close:healthy"]
+    assert runtime.observers.pending_cleanup_count == 1
+    assert runtime.observers.blocked_delivery_count == 1
+    assert not any(
+        thread.name.startswith("hermes-observer-cleanup-")
+        for thread in threading.enumerate()
+    )
+
+    blocked.release_for_test_cleanup.set()
+    _wait_until(
+        lambda: not any(
+            thread.name.startswith("hermes-observer-")
+            and not thread.name.startswith("hermes-observer-cleanup-")
+            for thread in threading.enumerate()
+        )
+    )
+    assert runtime.close() == ()
+    assert close_events == ["close:healthy", "close:blocked"]
+    assert runtime.observers.pending_cleanup_count == 0
+    assert runtime.observers.blocked_delivery_count == 0
+
