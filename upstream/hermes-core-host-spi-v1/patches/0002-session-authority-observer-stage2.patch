+def test_close_all_is_reverse_isolated_and_retains_failure_for_retry() -> None:
+    close_events: list[str] = []
+    resources: list[_CloseRegistration] = []
+
+    def cleanup_factory(request):
+        cleanup = _CloseRegistration(
+            request.durable_session_key,
+            close_events,
+            failures=1 if request.durable_session_key == "first" else 0,
+        )
+        resources.append(cleanup)
+        return cleanup
+
+    runtime = _runtime(observer_cleanup_factory=cleanup_factory)
+    _bind(runtime, "first")
+    _bind(runtime, "second")
+    runtime.host.prepare_observer(_request("first"), _RecordingSink()).activate()
+    runtime.host.prepare_observer(_request("second"), _RecordingSink()).activate()
+
+    failures = runtime.close()
+
+    assert len(failures) == 1
+    assert close_events == ["close:second", "close:first"]
+    assert runtime.observers.pending_cleanup_count == 1
+    assert resources[0].attempts == 1
+    assert resources[1].attempts == 1
+
+    assert runtime.close() == ()
+    assert close_events[-1] == "close:first"
+    assert resources[0].attempts == 2
+    assert resources[1].attempts == 1
+    assert runtime.observers.pending_cleanup_count == 0
+
