+def test_session_authority_concurrent_controllers_have_one_atomic_winner() -> None:
+    now = 10.0
+    runtime = _runtime(monotonic=lambda: now)
+    barrier = threading.Barrier(3)
+    winners = []
+    losers = []
+
+    def compete(controller_id: str) -> None:
+        barrier.wait()
+        try:
+            winners.append(
+                _bind(
+                    runtime,
+                    controller_id=controller_id,
+                    expected_revision=0,
+                    lease_deadline_monotonic=20.0,
+                )
+            )
+        except HostSpiUnavailableError as error:
+            losers.append(error)
+
+    threads = [
+        threading.Thread(target=compete, args=("controller-a",)),
+        threading.Thread(target=compete, args=("controller-b",)),
+    ]
+    for thread in threads:
+        thread.start()
+    barrier.wait()
+    for thread in threads:
+        thread.join(timeout=3)
+        assert not thread.is_alive()
+
+    assert len(winners) == 1
+    assert len(losers) == 1
+    binding = runtime.sessions.resolve(
+        profile="default",
+        durable_session_key="session-1",
+        runtime_generation="generation-1",
+    )
+    assert binding.controller_id in {"controller-a", "controller-b"}
+    assert binding.lease_deadline_monotonic == 20.0
+    assert binding.revision == 1
+    assert "controller-a" not in repr(binding)
+    assert "controller-b" not in repr(binding)
+    assert runtime.close() == ()
