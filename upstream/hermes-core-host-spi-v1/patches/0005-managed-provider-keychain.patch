@@ -0,0 +1,204 @@
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+
+def _write_metadata(tmp_path: Path, **overrides: object) -> Path:
+    payload: dict[str, object] = {
+        "schema_version": 1,
+        "provider": "deepseek",
+        "model": "deepseek-chat",
+        "base_url": "https://api.deepseek.com",
+        "key_env": "DEEPSEEK_API_KEY",
+        "keychain_service": "com.hermes.runtime.provider.v1",
+        "keychain_account": "work:deepseek",
+    }
+    payload.update(overrides)
+    root = tmp_path / "managed"
+    root.mkdir(mode=0o700, exist_ok=True)
+    path = root / "provider-v1.json"
+    path.write_text(json.dumps(payload), encoding="utf-8")
+    path.chmod(0o600)
+    return path
+
+
+def test_managed_provider_metadata_is_strict_and_never_mutates_environment(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    from hermes_cli.managed_provider import (
+        ManagedProviderError,
+        load_managed_provider,
+        overlay_managed_provider_config,
+    )
+
+    path = _write_metadata(tmp_path)
+    monkeypatch.setenv("HERMES_MANAGED_PROVIDER_CONFIG", str(path))
+    before = dict(os.environ)
+
+    metadata = load_managed_provider()
+    effective = overlay_managed_provider_config({"model": {"max_tokens": 4096}})
+
+    assert metadata is not None
+    assert effective["model"] == {
+        "provider": "deepseek",
+        "default": "deepseek-chat",
+        "base_url": "https://api.deepseek.com",
+        "max_tokens": 4096,
+    }
+    assert dict(os.environ) == before
+
+    for overrides in (
+        {"provider": "openai"},
+        {"model": "unknown"},
+        {"base_url": "http://api.deepseek.com"},
+        {"key_env": "OPENAI_API_KEY"},
+        {"unexpected": "field"},
+    ):
+        bad = _write_metadata(tmp_path, **overrides)
+        monkeypatch.setenv("HERMES_MANAGED_PROVIDER_CONFIG", str(bad))
+        with pytest.raises(ManagedProviderError, match="managed provider configuration is invalid"):
+            load_managed_provider()
+
+
+def test_managed_provider_rejects_unsafe_metadata_files(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    from hermes_cli.managed_provider import ManagedProviderError, load_managed_provider
+
+    path = _write_metadata(tmp_path)
+    path.chmod(0o644)
+    monkeypatch.setenv("HERMES_MANAGED_PROVIDER_CONFIG", str(path))
+    with pytest.raises(ManagedProviderError, match="managed provider configuration is unsafe"):
+        load_managed_provider()
+
+    path.chmod(0o600)
+    link = tmp_path / "provider-link.json"
+    link.symlink_to(path)
+    monkeypatch.setenv("HERMES_MANAGED_PROVIDER_CONFIG", str(link))
+    with pytest.raises(ManagedProviderError, match="managed provider configuration is unsafe"):
+        load_managed_provider()
+
+
+def test_only_declared_deepseek_key_reaches_fixed_keychain_reference(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    import hermes_cli.managed_provider as managed
+
+    path = _write_metadata(tmp_path)
+    monkeypatch.setenv("HERMES_MANAGED_PROVIDER_CONFIG", str(path))
+    calls: list[tuple[str, str]] = []
+
+    secret_buffer = bytearray(b"sk-managed-secret-value")
+
+    def fake_reader(service: str, account: str) -> bytearray:
+        calls.append((service, account))
+        return secret_buffer
+
+    monkeypatch.setattr(managed, "_read_keychain_secret", fake_reader)
+
+    secret = managed.resolve_managed_provider_secret(
+        "deepseek", "DEEPSEEK_API_KEY"
+    )
+    assert secret == "sk-managed-secret-value"
+    assert secret_buffer == bytearray(len(secret_buffer))
+    assert calls == [("com.hermes.runtime.provider.v1", "work:deepseek")]
+
+    assert managed.resolve_managed_provider_secret("openai", "OPENAI_API_KEY") is None
+    assert calls == [("com.hermes.runtime.provider.v1", "work:deepseek")]
+
+
+def test_auth_and_ephemeral_pool_use_managed_key_without_persisting_it(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    import agent.credential_pool as pool_module
+    import hermes_cli.managed_provider as managed
+    from agent.credential_pool import CredentialPool, PooledCredential
+    from hermes_cli.auth import (
+        PROVIDER_REGISTRY,
+        _resolve_api_key_provider_secret,
+        resolve_api_key_provider_credentials,
+    )
+
+    path = _write_metadata(tmp_path)
+    monkeypatch.setenv("HERMES_MANAGED_PROVIDER_CONFIG", str(path))
+    monkeypatch.delenv("DEEPSEEK_API_KEY", raising=False)
+    monkeypatch.setattr(
+        managed,
+        "_read_keychain_secret",
+        lambda _service, _account: bytearray(b"sk-managed-secret-value"),
+    )
+
+    secret, source = _resolve_api_key_provider_secret(
+        "deepseek", PROVIDER_REGISTRY["deepseek"]
+    )
+    assert secret == "sk-managed-secret-value"
+    assert source == "managed_keychain:DEEPSEEK_API_KEY"
+    monkeypatch.setenv("DEEPSEEK_BASE_URL", "https://ambient.invalid")
+    monkeypatch.setattr(
+        managed,
+        "_read_keychain_secret",
+        lambda _service, _account: bytearray(b"sk-managed-secret-value"),
+    )
+    credentials = resolve_api_key_provider_credentials("deepseek")
+    assert credentials["base_url"] == "https://api.deepseek.com"
+
+    ephemeral = PooledCredential(
+        provider="deepseek",
+        id="managed",
+        label="DEEPSEEK_API_KEY",
+        auth_type="api_key",
+        priority=0,
+        source="managed_keychain:DEEPSEEK_API_KEY",
+        access_token="sk-managed-secret-value",
+        base_url="https://api.deepseek.com",
+    )
+    persisted: list[dict[str, object]] = []
+    monkeypatch.setattr(
+        pool_module,
+        "write_credential_pool",
+        lambda _provider, entries, **_kwargs: persisted.extend(entries),
+    )
+    CredentialPool("deepseek", [ephemeral])._persist()
+    assert persisted == []
+
+
+def test_managed_errors_are_redacted(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    import hermes_cli.managed_provider as managed
+
+    path = _write_metadata(tmp_path)
+    monkeypatch.setenv("HERMES_MANAGED_PROVIDER_CONFIG", str(path))
+    secret_marker = "sk-must-never-appear"
+
+    def failing_reader(_service: str, _account: str) -> bytearray:
+        raise RuntimeError(secret_marker)
+
+    monkeypatch.setattr(managed, "_read_keychain_secret", failing_reader)
+    with pytest.raises(managed.ManagedProviderError) as captured:
+        managed.resolve_managed_provider_secret("deepseek", "DEEPSEEK_API_KEY")
+    assert secret_marker not in str(captured.value)
+    assert captured.value.__cause__ is None
+
