+def test_managed_cli_defaults_do_not_override_explicit_arguments(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    from hermes_cli.managed_provider import apply_managed_cli_defaults
+
+    path = _write_metadata(tmp_path)
+    monkeypatch.setenv("HERMES_MANAGED_PROVIDER_CONFIG", str(path))
+    assert apply_managed_cli_defaults(None, None, None) == (
+        "deepseek-chat",
+        "deepseek",
+        "https://api.deepseek.com",
+    )
+    assert apply_managed_cli_defaults(
+        "deepseek-reasoner", "deepseek", "https://explicit.example"
+    ) == (
+        "deepseek-reasoner",
+        "deepseek",
+        "https://explicit.example",
+    )
