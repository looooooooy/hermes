diff --git a/hermes_cli/managed_provider.py b/hermes_cli/managed_provider.py
new file mode 100644
index 0000000000000000000000000000000000000000..f2097acb22e57e7ca13c9ff8618a4cfd9898544c
--- /dev/null
+++ b/hermes_cli/managed_provider.py
@@ -0,0 +1,341 @@
+"""Fail-closed managed provider metadata and macOS Keychain access."""
+
+from __future__ import annotations
+
+import copy
+import ctypes
+import json
+import os
+import stat
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Mapping
+from urllib.parse import urlsplit
+
+
+MANAGED_PROVIDER_ENV = "HERMES_MANAGED_PROVIDER_CONFIG"
+KEYCHAIN_SERVICE = "com.hermes.runtime.provider.v1"
+KEYCHAIN_ACCOUNT = "work:deepseek"
+KEY_ENV = "DEEPSEEK_API_KEY"
+PROVIDER = "deepseek"
+MODELS = frozenset({"deepseek-chat", "deepseek-reasoner"})
+MAX_METADATA_BYTES = 16 * 1024
+MAX_SECRET_BYTES = 16 * 1024
+_FIELDS = frozenset(
+    {
+        "schema_version",
+        "provider",
+        "model",
+        "base_url",
+        "key_env",
+        "keychain_service",
+        "keychain_account",
+    }
+)
+
+
+class ManagedProviderError(RuntimeError):
+    """A redacted managed-provider configuration or secret-store failure."""
+
+
+@dataclass(frozen=True)
+class ManagedProviderV1:
+    provider: str
+    model: str
+    base_url: str | None
+    key_env: str
+    keychain_service: str
+    keychain_account: str
+
+
+def _reject_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    result: dict[str, Any] = {}
+    for key, value in pairs:
+        if key in result:
+            raise ManagedProviderError("managed provider configuration is invalid")
+        result[key] = value
+    return result
+
+
+def _metadata_path() -> Path | None:
+    raw = os.environ.get(MANAGED_PROVIDER_ENV)
+    if raw is None:
+        return None
+    if not raw or "\x00" in raw:
+        raise ManagedProviderError("managed provider configuration is invalid")
+    path = Path(raw)
+    if not path.is_absolute() or ".." in path.parts:
+        raise ManagedProviderError("managed provider configuration is invalid")
+    return path
+
+
+def _read_metadata(path: Path) -> bytes:
+    try:
+        metadata = path.lstat()
+        parent = path.parent.lstat()
+        if (
+            stat.S_ISLNK(metadata.st_mode)
+            or not stat.S_ISREG(metadata.st_mode)
+            or metadata.st_uid != os.geteuid()
+            or stat.S_IMODE(metadata.st_mode) != 0o600
+            or metadata.st_size <= 0
+            or metadata.st_size > MAX_METADATA_BYTES
+            or stat.S_ISLNK(parent.st_mode)
+            or not stat.S_ISDIR(parent.st_mode)
+            or parent.st_uid != os.geteuid()
+            or stat.S_IMODE(parent.st_mode) & 0o077
+        ):
+            raise ManagedProviderError("managed provider configuration is unsafe")
+        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
+        try:
+            opened = os.fstat(descriptor)
+            if (
+                opened.st_dev != metadata.st_dev
+                or opened.st_ino != metadata.st_ino
+                or opened.st_size != metadata.st_size
+            ):
+                raise ManagedProviderError("managed provider configuration is unsafe")
+            payload = bytearray()
+            while len(payload) <= MAX_METADATA_BYTES:
+                chunk = os.read(descriptor, min(4096, MAX_METADATA_BYTES + 1 - len(payload)))
+                if not chunk:
+                    break
+                payload.extend(chunk)
+            if not payload or len(payload) > MAX_METADATA_BYTES:
+                raise ManagedProviderError("managed provider configuration is unsafe")
+            return bytes(payload)
+        finally:
+            os.close(descriptor)
+    except ManagedProviderError:
+        raise
+    except OSError as error:
+        raise ManagedProviderError("managed provider configuration is unsafe") from error
+
+
+def _valid_https_url(value: object) -> bool:
+    if value is None:
+        return True
+    if not isinstance(value, str) or not value or len(value) > 2048:
+        return False
+    parsed = urlsplit(value)
+    return (
+        parsed.scheme == "https"
+        and bool(parsed.hostname)
+        and parsed.username is None
+        and parsed.password is None
+        and not parsed.fragment
+    )
+
+
+def load_managed_provider() -> ManagedProviderV1 | None:
+    path = _metadata_path()
+    if path is None:
+        return None
+    try:
+        raw = json.loads(_read_metadata(path), object_pairs_hook=_reject_duplicates)
+    except ManagedProviderError:
+        raise
+    except (UnicodeDecodeError, json.JSONDecodeError, TypeError, ValueError) as error:
+        raise ManagedProviderError("managed provider configuration is invalid") from error
+    if (
+        not isinstance(raw, dict)
+        or set(raw) != _FIELDS
+        or raw.get("schema_version") != 1
+        or raw.get("provider") != PROVIDER
+        or raw.get("model") not in MODELS
+        or not _valid_https_url(raw.get("base_url"))
+        or raw.get("key_env") != KEY_ENV
+        or raw.get("keychain_service") != KEYCHAIN_SERVICE
+        or raw.get("keychain_account") != KEYCHAIN_ACCOUNT
+    ):
+        raise ManagedProviderError("managed provider configuration is invalid")
+    return ManagedProviderV1(
+        provider=PROVIDER,
+        model=raw["model"],
+        base_url=raw["base_url"].rstrip("/") if raw["base_url"] else None,
+        key_env=KEY_ENV,
+        keychain_service=KEYCHAIN_SERVICE,
+        keychain_account=KEYCHAIN_ACCOUNT,
+    )
+
+
+def overlay_managed_provider_config(config: Mapping[str, Any]) -> dict[str, Any]:
+    metadata = load_managed_provider()
+    if metadata is None:
+        return copy.deepcopy(dict(config))
+    effective = copy.deepcopy(dict(config))
+    model = effective.get("model")
+    model = copy.deepcopy(model) if isinstance(model, dict) else {}
+    model["provider"] = metadata.provider
+    model["default"] = metadata.model
+    if metadata.base_url is not None:
+        model["base_url"] = metadata.base_url
+    else:
+        model.pop("base_url", None)
+    effective["model"] = model
+    return effective
+
+
+def managed_provider_base_url(provider_id: str) -> tuple[bool, str | None]:
+    metadata = load_managed_provider()
+    if metadata is None or provider_id != metadata.provider:
+        return False, None
+    return True, metadata.base_url
+
+
+def resolve_managed_provider_secret(
+    provider_id: str, requested_key_env: str
+) -> str | None:
+    metadata = load_managed_provider()
+    if (
+        metadata is None
+        or provider_id != metadata.provider
+        or requested_key_env != metadata.key_env
+    ):
+        return None
+    try:
+        secret = _read_keychain_secret(
+            metadata.keychain_service, metadata.keychain_account
+        )
+        if not secret:
+            return ""
+        if len(secret) > MAX_SECRET_BYTES:
+            raise ManagedProviderError("managed provider secure storage failed")
+        try:
+            value = secret.decode("utf-8")
+        finally:
+            secret[:] = b"\x00" * len(secret)
+        if (
+            len(value) < 16
+            or len(value.encode("utf-8")) > MAX_SECRET_BYTES
+            or any(ord(character) < 0x20 or ord(character) == 0x7F for character in value)
+        ):
+            raise ManagedProviderError("managed provider secure storage failed")
+        return value
+    except ManagedProviderError:
+        raise
+    except Exception:
+        raise ManagedProviderError("managed provider secure storage failed") from None
+
+
+def managed_provider_credential(provider_id: str) -> dict[str, str] | None:
+    metadata = load_managed_provider()
+    if metadata is None or provider_id != metadata.provider:
+        return None
+    secret = resolve_managed_provider_secret(provider_id, metadata.key_env)
+    if not secret:
+        return None
+    return {
+        "source": f"managed_keychain:{metadata.key_env}",
+        "auth_type": "api_key",
+        "access_token": secret,
+        "base_url": metadata.base_url or "https://api.deepseek.com",
+        "label": metadata.key_env,
+    }
+
+
+def apply_managed_cli_defaults(
+    model: str | None, provider: str | None, base_url: str | None
+) -> tuple[str | None, str | None, str | None]:
+    metadata = load_managed_provider()
+    if metadata is None:
+        return model, provider, base_url
+    return (
+        model or metadata.model,
+        provider or metadata.provider,
+        base_url or metadata.base_url,
+    )
+
+
+def _read_keychain_secret(service: str, account: str) -> bytearray:
+    if sys.platform != "darwin":
+        raise ManagedProviderError("managed provider secure storage failed")
+    if service != KEYCHAIN_SERVICE or account != KEYCHAIN_ACCOUNT:
+        raise ManagedProviderError("managed provider secure storage failed")
+
+    core = ctypes.CDLL(
+        "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation"
+    )
+    security = ctypes.CDLL(
+        "/System/Library/Frameworks/Security.framework/Security"
+    )
+    pointer = ctypes.c_void_p
+    core.CFStringCreateWithBytes.restype = pointer
+    core.CFStringCreateWithBytes.argtypes = [
+        pointer,
+        ctypes.c_char_p,
+        ctypes.c_long,
+        ctypes.c_uint32,
+        ctypes.c_bool,
+    ]
+    core.CFDictionaryCreate.restype = pointer
+    core.CFDictionaryCreate.argtypes = [
+        pointer,
+        ctypes.POINTER(pointer),
+        ctypes.POINTER(pointer),
+        ctypes.c_long,
+        pointer,
+        pointer,
+    ]
+    core.CFDataGetLength.restype = ctypes.c_long
+    core.CFDataGetLength.argtypes = [pointer]
+    core.CFDataGetBytePtr.restype = ctypes.POINTER(ctypes.c_ubyte)
+    core.CFDataGetBytePtr.argtypes = [pointer]
+    core.CFRelease.argtypes = [pointer]
+    security.SecItemCopyMatching.restype = ctypes.c_int32
+    security.SecItemCopyMatching.argtypes = [pointer, ctypes.POINTER(pointer)]
+
+    def constant(library: ctypes.CDLL, name: str) -> pointer:
+        return pointer.in_dll(library, name)
+
+    def cf_string(value: str) -> pointer:
+        encoded = value.encode("utf-8")
+        result = core.CFStringCreateWithBytes(
+            None, encoded, len(encoded), 0x08000100, False
+        )
+        if not result:
+            raise ManagedProviderError("managed provider secure storage failed")
+        return result
+
+    service_ref = cf_string(service)
+    account_ref = cf_string(account)
+    query = pointer()
+    result = pointer()
+    try:
+        keys = (pointer * 5)(
+            constant(security, "kSecClass"),
+            constant(security, "kSecAttrService"),
+            constant(security, "kSecAttrAccount"),
+            constant(security, "kSecReturnData"),
+            constant(security, "kSecMatchLimit"),
+        )
+        values = (pointer * 5)(
+            constant(security, "kSecClassGenericPassword"),
+            service_ref,
+            account_ref,
+            constant(core, "kCFBooleanTrue"),
+            constant(security, "kSecMatchLimitOne"),
+        )
+        query = core.CFDictionaryCreate(None, keys, values, 5, None, None)
+        if not query:
+            raise ManagedProviderError("managed provider secure storage failed")
+        status = security.SecItemCopyMatching(query, ctypes.byref(result))
+        if status == -25300:
+            return bytearray()
+        if status != 0 or not result:
+            raise ManagedProviderError("managed provider secure storage failed")
+        length = core.CFDataGetLength(result)
+        if length <= 0 or length > MAX_SECRET_BYTES:
+            raise ManagedProviderError("managed provider secure storage failed")
+        data = core.CFDataGetBytePtr(result)
+        if not data:
+            raise ManagedProviderError("managed provider secure storage failed")
+        return bytearray(ctypes.string_at(data, length))
+    finally:
+        if result:
+            core.CFRelease(result)
+        if query:
+            core.CFRelease(query)
+        core.CFRelease(account_ref)
+        core.CFRelease(service_ref)
