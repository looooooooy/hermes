+def test_concurrent_install_is_included_in_the_same_drain() -> None:
+    host = _RecordingHost()
+    manager = PluginManager(
+        gateway_extension_host=host,
+        gateway_extension_capabilities=GATEWAY_EXTENSION_CAPABILITIES_V1,
+    )
+    context = PluginContext(PluginManifest(name="concurrent"), manager)
+    install_started = threading.Event()
+    release_install = threading.Event()
+    drain_entered = threading.Event()
+    register_errors: list[BaseException] = []
+    drain_results: list[tuple] = []
+
+    class BlockingExtension:
+        def install(self, _host):
+            host.events.append("install:late-start")
+            install_started.set()
+            if not release_install.wait(timeout=5):
+                raise RuntimeError("test install release timed out")
+            host.events.append("install:late-finish")
+            return _CloseRegistration("late", host.events)
+
+    def register() -> None:
+        try:
+            context.register_gateway_extension(BlockingExtension(), spi_version=1)
+        except BaseException as error:
+            register_errors.append(error)
+
+    def drain() -> None:
+        drain_entered.set()
+        drain_results.append(manager.shutdown_extensions())
+
+    register_thread = threading.Thread(target=register)
+    drain_thread = threading.Thread(target=drain)
+    register_thread.start()
+    assert install_started.wait(timeout=5)
+    drain_thread.start()
+    assert drain_entered.wait(timeout=5)
+    release_install.set()
+    register_thread.join(timeout=5)
+    drain_thread.join(timeout=5)
+
+    assert not register_thread.is_alive()
+    assert not drain_thread.is_alive()
+    assert register_errors == []
+    assert drain_results == [()]
+    assert manager.pending_extension_shutdowns == frozenset()
+    assert host.events == [
+        "install:late-start",
+        "install:late-finish",
+        "close:late",
+    ]
+
