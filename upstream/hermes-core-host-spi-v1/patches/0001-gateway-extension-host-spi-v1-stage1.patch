+class _ExtensionLifecycleState(str, Enum):
+    OPEN = "open"
+    CLOSING = "closing"
+    CLOSED = "closed"
+
+
+class _ManagedExtensionRegistration:
+    """Idempotent registration wrapper that remains retryable after failure."""
+
+    def __init__(self, registration: Registration) -> None:
+        self._registration = registration
+        self._condition = threading.Condition(threading.RLock())
+        self._state = _ExtensionLifecycleState.OPEN
+        self._closing_thread: int | None = None
+
+    @property
+    def closed(self) -> bool:
+        with self._condition:
+            return self._state is _ExtensionLifecycleState.CLOSED
+
+    def close(self) -> None:
+        current_thread = threading.get_ident()
+        with self._condition:
+            while self._state is _ExtensionLifecycleState.CLOSING:
+                if self._closing_thread == current_thread:
+                    raise HostSpiRegistrationError(
+                        "gateway extension lifecycle re-entry is unavailable"
+                    )
+                self._condition.wait()
+            if self._state is _ExtensionLifecycleState.CLOSED:
+                return
+            self._state = _ExtensionLifecycleState.CLOSING
+            self._closing_thread = current_thread
+        try:
+            self._registration.close()
+        except BaseException:
+            with self._condition:
+                self._state = _ExtensionLifecycleState.OPEN
+                self._closing_thread = None
+                self._condition.notify_all()
+            raise
+        with self._condition:
+            self._state = _ExtensionLifecycleState.CLOSED
+            self._closing_thread = None
+            self._condition.notify_all()
 
 
