+def test_install_is_rejected_while_drain_is_closing() -> None:
+    host = _RecordingHost()
+    manager = PluginManager(
+        gateway_extension_host=host,
+        gateway_extension_capabilities=GATEWAY_EXTENSION_CAPABILITIES_V1,
+    )
+    context = PluginContext(PluginManifest(name="closing-gate"), manager)
+    close_started = threading.Event()
+    release_close = threading.Event()
+    drain_results: list[tuple] = []
+
+    class BlockingRegistration:
+        def close(self) -> None:
+            host.events.append("close:first")
+            close_started.set()
+            if not release_close.wait(timeout=5):
+                raise RuntimeError("test close release timed out")
+
+    class FirstExtension:
+        def install(self, _host):
+            host.events.append("install:first")
+            return BlockingRegistration()
+
+    class LateExtension:
+        def install(self, _host):
+            host.events.append("install:late")
+            return _CloseRegistration("late", host.events)
+
+    context.register_gateway_extension(FirstExtension(), spi_version=1)
+    drain_thread = threading.Thread(
+        target=lambda: drain_results.append(manager.shutdown_extensions())
+    )
+    drain_thread.start()
+    assert close_started.wait(timeout=5)
+    observed: BaseException | None = None
+    try:
+        context.register_gateway_extension(LateExtension(), spi_version=1)
+    except BaseException as error:
+        observed = error
+    finally:
+        release_close.set()
+        drain_thread.join(timeout=5)
+
+    assert isinstance(observed, HostSpiUnavailableError)
+    assert not drain_thread.is_alive()
+    assert drain_results == [()]
+    assert manager.pending_extension_shutdowns == frozenset()
+    assert "install:late" not in host.events
+
