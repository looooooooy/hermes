+"""Behavior contract for the public Gateway Extension Host SPI v1."""
+
+from dataclasses import FrozenInstanceError
+
+import pytest
+
+from hermes_cli.extension_host_v1 import (
+    GATEWAY_EXTENSION_CAPABILITIES_V1,
+    GATEWAY_EXTENSION_SPI_VERSION,
+    ControlScope,
+    ControlSnapshot,
+    HostSpiCapabilityError,
+    HostSpiUnavailableError,
+    HostSpiVersionError,
+    ObserverEvent,
+    ObserverRequest,
+    OwnerActionRequest,
+    OwnerActionResult,
+    OwnerActionStatus,
+    RuntimeDescriptor,
+    SafeAuditEvent,
+)
+
+
+def test_v1_identity_and_required_context_capabilities_are_stable() -> None:
+    assert GATEWAY_EXTENSION_SPI_VERSION == 1
+    assert GATEWAY_EXTENSION_CAPABILITIES_V1 == frozenset(
+        {
+            "audit.safe.v1",
+            "extension.lifecycle.v1",
+            "runtime.descriptor.v1",
+            "session.observe.v1",
+            "session.owner-actions.v1",
+        }
+    )
+
+
+def test_runtime_and_scope_dtos_are_frozen_and_canonical() -> None:
+    descriptor = RuntimeDescriptor(
+        profile="default",
+        runtime_generation="generation-1",
+        host_bundle_id="ai.hermes.agent",
+        state="ready",
+        capabilities={"prompt.submit": 1, "session.observe.output-parity.v1": 1},
+    )
+    scope = ControlScope(
+        profile="default",
+        durable_session_key="session-1",
+        runtime_generation="generation-1",
+    )
+
+    assert descriptor.capabilities["prompt.submit"] == 1
+    assert scope.durable_session_key == "session-1"
+    with pytest.raises(FrozenInstanceError):
+        descriptor.state = "unavailable"  # type: ignore[misc]
+    with pytest.raises(TypeError):
+        descriptor.capabilities["prompt.submit"] = 2  # type: ignore[index]
+    with pytest.raises(ValueError, match="profile must be canonical text"):
+        RuntimeDescriptor(
+            profile=" default",
+            runtime_generation="generation-1",
+            host_bundle_id="ai.hermes.agent",
+            state="ready",
+        )
+    with pytest.raises(ValueError, match="capability versions"):
+        RuntimeDescriptor(
+            profile="default",
+            runtime_generation="generation-1",
+            host_bundle_id="ai.hermes.agent",
+            state="ready",
+            capabilities={"prompt.submit": True},
+        )
+
+
+def test_observer_contract_is_snapshot_first_and_payload_repr_is_redacted() -> None:
+    request = ObserverRequest(
+        profile="default",
+        durable_session_key="session-1",
+        runtime_generation="generation-1",
+        observer_contract=2,
+        required_capabilities=frozenset({"session.observe.output-parity.v1"}),
+    )
+    event = ObserverEvent(
+        profile="default",
+        durable_session_key="session-1",
+        runtime_generation="generation-1",
+        sequence=4,
+        event_type="message.delta",
+        payload={"token": "must-not-appear", "parts": [{"text": "private"}]},
+    )
+
+    assert request.observer_contract == 2
+    assert event.payload["parts"][0]["text"] == "private"
+    assert "session-1" not in repr(request)
+    assert "session-1" not in repr(event)
+    assert "must-not-appear" not in repr(event)
+    assert "private" not in repr(event)
+    with pytest.raises(TypeError):
+        event.payload["parts"][0]["text"] = "changed"  # type: ignore[index]
+    with pytest.raises(ValueError, match="sequence must be a non-negative integer"):
+        ObserverEvent(
+            profile="default",
+            durable_session_key="session-1",
+            runtime_generation="generation-1",
+            sequence=-1,
+            event_type="message.delta",
+            payload={},
+        )
+
+
+def test_owner_action_and_control_payloads_never_leak_through_repr() -> None:
+    request = OwnerActionRequest(
+        profile="default",
+        durable_session_key="session-1",
+        runtime_generation="generation-1",
+        command_id="command-1",
+        method="approval.respond",
+        payload={"approval": "secret-approval-body"},
+    )
+    result = OwnerActionResult(
+        status=OwnerActionStatus.EFFECT_UNKNOWN,
+        payload={"tool_output": "secret-tool-output"},
+    )
+    snapshot = ControlSnapshot(
+        profile="default",
+        durable_session_key="session-1",
+        runtime_generation="generation-1",
+        control_revision=3,
+        payload={"pending_approval": "secret-pending-body"},
+    )
+    audit = SafeAuditEvent(
+        name="extension.install.failed",
+        profile="default",
+        runtime_generation="generation-1",
+        attributes={"token": "secret-token"},
+    )
+
+    combined_repr = repr((request, result, snapshot, audit))
+    assert "session-1" not in combined_repr
+    assert "command-1" not in combined_repr
+    assert "secret-approval-body" not in combined_repr
+    assert "secret-tool-output" not in combined_repr
+    assert "secret-pending-body" not in combined_repr
+    assert "secret-token" not in combined_repr
+    assert result.status is OwnerActionStatus.EFFECT_UNKNOWN
+    with pytest.raises(ValueError, match="owner action method is unavailable"):
+        OwnerActionRequest(
+            profile="default",
+            durable_session_key="session-1",
+            runtime_generation="generation-1",
+            command_id="command-2",
+            method="tool.dispatch",
+            payload={},
+        )
+
+
+def test_public_errors_have_stable_non_sensitive_messages() -> None:
+    assert str(HostSpiVersionError(expected=1, observed=2)) == (
+        "gateway extension SPI version mismatch: expected 1, observed 2"
+    )
+    assert str(HostSpiCapabilityError({"session.observe.v1"})) == (
+        "gateway extension capabilities unavailable: session.observe.v1"
+    )
+    assert str(HostSpiUnavailableError()) == "gateway extension host is unavailable"
+
+
+def test_scope_repr_hides_session_identifier_and_canonical_text_rejects_controls() -> None:
+    scope = ControlScope(
+        profile="default",
+        durable_session_key="sensitive-session-id",
+        runtime_generation="generation-1",
+    )
+    assert "sensitive-session-id" not in repr(scope)
+
+    for control_text in ("line\nbreak", "nul\x00byte", "delete\x7fbyte"):
+        with pytest.raises(ValueError, match="canonical text"):
+            RuntimeDescriptor(
+                profile=control_text,
+                runtime_generation="generation-1",
+                host_bundle_id="ai.hermes.agent",
+                state="ready",
+            )
+        with pytest.raises(ValueError, match="required_capabilities"):
+            ObserverRequest(
+                profile="default",
+                durable_session_key="session-1",
+                runtime_generation="generation-1",
+                required_capabilities=frozenset({control_text}),
+            )
+        with pytest.raises(ValueError, match="command_id"):
+            OwnerActionRequest(
+                profile="default",
+                durable_session_key="session-1",
+                runtime_generation="generation-1",
+                command_id=control_text,
+                method="approval.respond",
+                payload={},
+            )
+        with pytest.raises(ValueError, match="capability names"):
+            RuntimeDescriptor(
+                profile="default",
+                runtime_generation="generation-1",
+                host_bundle_id="ai.hermes.agent",
+                state="ready",
+                capabilities={control_text: 1},
+            )
