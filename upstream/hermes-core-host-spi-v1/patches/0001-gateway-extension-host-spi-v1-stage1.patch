+            )
+            if state is _ExtensionLifecycleState.CLOSING:
+                raise HostSpiUnavailableError()
+            if state is _ExtensionLifecycleState.CLOSED:
+                if (
+                    self._extension_registrations.get(plugin_key)
+                    or self._extension_active_installs.get(plugin_key, 0)
+                ):
+                    raise HostSpiRegistrationError(
+                        "gateway extension lifecycle cannot reopen before drain"
+                    )
+                self._extension_plugin_states[plugin_key] = (
+                    _ExtensionLifecycleState.OPEN
+                )
+
+    def _finish_extension_install_locked(
+        self,
+        plugin_key: str,
+        thread_id: int,
+    ) -> None:
+        active = self._extension_active_installs.get(plugin_key, 0) - 1
+        if active > 0:
+            self._extension_active_installs[plugin_key] = active
+        else:
+            self._extension_active_installs.pop(plugin_key, None)
+        thread_counts = self._extension_install_threads.get(plugin_key, {})
+        thread_active = thread_counts.get(thread_id, 0) - 1
+        if thread_active > 0:
+            thread_counts[thread_id] = thread_active
+        else:
+            thread_counts.pop(thread_id, None)
+        if not thread_counts:
+            self._extension_install_threads.pop(plugin_key, None)
+        self._extension_condition.notify_all()
+
+    def _register_gateway_extension(
+        self,
+        plugin_key: str,
+        extension: GatewayExtensionV1,
+        *,
+        spi_version: int,
+    ) -> Registration:
+        if type(spi_version) is not int or spi_version != GATEWAY_EXTENSION_SPI_VERSION:
+            raise HostSpiVersionError(
+                expected=GATEWAY_EXTENSION_SPI_VERSION,
+                observed=spi_version,
+            )
+        missing = (
+            GATEWAY_EXTENSION_CAPABILITIES_V1
+            - self._gateway_extension_capabilities
+        )
+        if missing:
+            raise HostSpiCapabilityError(missing)
+        host = self._gateway_extension_host
+        if host is None:
+            raise HostSpiUnavailableError()
+        observed_host_version = getattr(host, "host_api_version", None)
+        if (
+            type(observed_host_version) is not int
+            or observed_host_version != GATEWAY_EXTENSION_SPI_VERSION
+        ):
+            raise HostSpiVersionError(
+                expected=GATEWAY_EXTENSION_SPI_VERSION,
+                observed=observed_host_version,
+            )
+        install = getattr(extension, "install", None)
+        if not callable(install):
+            raise HostSpiRegistrationError(
+                "gateway extension must provide install(host)"
+            )
+        thread_id = threading.get_ident()
+        with self._extension_condition:
+            plugin_state = self._extension_plugin_states.get(
+                plugin_key, _ExtensionLifecycleState.OPEN
+            )
+            if (
+                self._extension_state is not _ExtensionLifecycleState.OPEN
+                or plugin_state is not _ExtensionLifecycleState.OPEN
+            ):
+                raise HostSpiUnavailableError()
+            self._extension_active_installs[plugin_key] = (
+                self._extension_active_installs.get(plugin_key, 0) + 1
+            )
+            thread_counts = self._extension_install_threads.setdefault(
+                plugin_key, {}
+            )
+            thread_counts[thread_id] = thread_counts.get(thread_id, 0) + 1
+        try:
+            try:
+                registration = install(host)
+            except Exception as error:
+                raise HostSpiRegistrationError(
+                    "gateway extension installation failed"
+                ) from error
+            if not callable(getattr(registration, "close", None)):
+                raise HostSpiRegistrationError(
+                    "gateway extension install() must return a Registration"
+                )
+            managed = _ManagedExtensionRegistration(registration)
+            with self._extension_condition:
+                self._extension_registrations.setdefault(plugin_key, []).append(
+                    managed
+                )
+            return managed
+        finally:
+            with self._extension_condition:
+                self._finish_extension_install_locked(plugin_key, thread_id)
+
+    def shutdown_extensions(
+        self,
+        plugin_key: Optional[str] = None,
+    ) -> tuple[ExtensionShutdownFailure, ...]:
+        """Close managed registrations in reverse order without skipping failures.
+
+        Failed registrations stay in the store so a later drain can retry.
+        Error messages from plugin resources are not copied into the public
+        result or logs because they may contain payloads or credentials.
+        """
+        current_thread = threading.get_ident()
+        with self._extension_condition:
+            if plugin_key is None:
+                if any(
+                    current_thread in thread_counts
+                    for thread_counts in self._extension_install_threads.values()
+                ):
+                    raise HostSpiRegistrationError(
+                        "gateway extension lifecycle re-entry is unavailable"
+                    )
+                while (
+                    self._extension_state is _ExtensionLifecycleState.CLOSING
+                    or any(
+                        state is _ExtensionLifecycleState.CLOSING
+                        for state in self._extension_plugin_states.values()
+                    )
+                ):
+                    if (
+                        self._extension_closing_thread == current_thread
+                        or current_thread
