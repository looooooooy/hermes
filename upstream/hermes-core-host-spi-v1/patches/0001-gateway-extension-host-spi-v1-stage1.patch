+def _plugin_source(register_lines: str) -> str:
+    body = textwrap.indent(register_lines, "    ")
+    return f"""
+class Extension:
+    def __init__(self, label):
+        self.label = label
+
+    def install(self, host):
+        return host.install(self.label)
+
+def register(ctx):
+{body}
+    """
+
