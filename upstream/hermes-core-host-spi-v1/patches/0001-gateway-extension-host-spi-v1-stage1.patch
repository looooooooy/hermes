+                self._extension_plugin_states[plugin_key] = (
+                    _ExtensionLifecycleState.CLOSING
+                )
+                self._extension_plugin_closing_threads[plugin_key] = current_thread
+                while self._extension_active_installs.get(plugin_key, 0):
+                    self._extension_condition.wait()
+                keys = [plugin_key]
+            work = {
+                key: list(reversed(self._extension_registrations.get(key, [])))
+                for key in keys
+            }
+
+        failures: List[ExtensionShutdownFailure] = []
+        for key in keys:
+            for registration in work[key]:
+                try:
+                    registration.close()
+                except BaseException as error:
+                    failures.append(
+                        ExtensionShutdownFailure(
+                            plugin_key=key,
+                            error_type=type(error).__name__,
+                        )
+                    )
+                    logger.warning(
+                        "Gateway extension close failed for plugin '%s' (%s); "
+                        "registration retained for retry",
+                        key,
+                        type(error).__name__,
+                    )
+                    continue
+                with self._extension_condition:
+                    current = self._extension_registrations.get(key, [])
+                    if registration in current:
+                        current.remove(registration)
+                    if not current:
+                        self._extension_registrations.pop(key, None)
+
+            loaded = self._plugins.get(key)
+            if loaded is not None:
+                with self._extension_condition:
+                    loaded.extension_registrations = list(
+                        self._extension_registrations.get(key, [])
+                    )
+                loaded.extension_error = (
+                    "extension shutdown failed"
+                    if any(failure.plugin_key == key for failure in failures)
+                    else None
+                )
+        failed_keys = {failure.plugin_key for failure in failures}
+        with self._extension_condition:
+            for key in keys:
+                self._extension_plugin_states[key] = (
+                    _ExtensionLifecycleState.OPEN
+                    if key in failed_keys
+                    else _ExtensionLifecycleState.CLOSED
+                )
+                self._extension_plugin_closing_threads.pop(key, None)
+            if plugin_key is None:
+                self._extension_state = (
+                    _ExtensionLifecycleState.OPEN
+                    if failures
+                    else _ExtensionLifecycleState.CLOSED
+                )
+                self._extension_closing_thread = None
+            self._extension_condition.notify_all()
+        return tuple(failures)
+
+    def unload_plugin(
+        self,
+        plugin_key: str,
+    ) -> tuple[ExtensionShutdownFailure, ...]:
+        """Disable one loaded plugin's process extension lifecycle."""
+        failures = self.shutdown_extensions(plugin_key)
+        if not failures and plugin_key in self._plugins:
+            loaded = self._plugins[plugin_key]
+            loaded.enabled = False
+            loaded.error = "unloaded"
+        return failures
