+                        )
+                    self._extension_condition.wait()
+                if self._extension_state is _ExtensionLifecycleState.CLOSED:
+                    return ()
+                self._extension_state = _ExtensionLifecycleState.CLOSING
+                self._extension_closing_thread = current_thread
+                while self._extension_active_installs:
+                    self._extension_condition.wait()
