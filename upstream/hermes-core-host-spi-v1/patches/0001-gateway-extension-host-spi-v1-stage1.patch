+"""Real entry-point discovery tests for gateway extension lifecycle v1."""
+
+from __future__ import annotations
+
+import builtins
+import importlib
+import textwrap
+import threading
+from pathlib import Path
+
+import pytest
+import yaml
+
+from hermes_cli.extension_host_v1 import (
+    GATEWAY_EXTENSION_CAPABILITIES_V1,
+    HostSpiCapabilityError,
+    HostSpiRegistrationError,
+    HostSpiUnavailableError,
+)
+from hermes_cli.plugins import PluginContext, PluginManager, PluginManifest
+
+
+class _CloseRegistration:
+    def __init__(
+        self,
+        label: str,
+        events: list[str],
+        *,
+        failures: int = 0,
+    ) -> None:
+        self.label = label
+        self.events = events
+        self.failures = failures
+        self.closed = False
+
+    def close(self) -> None:
+        self.events.append(f"close:{self.label}")
+        if self.failures:
+            self.failures -= 1
+            raise RuntimeError(f"close failed: {self.label}")
+        self.closed = True
+
+
+class _RecordingHost:
+    host_api_version = 1
+
+    def __init__(
+        self,
+        *,
+        close_failures: dict[str, int] | None = None,
+        install_failures: set[str] | None = None,
+    ) -> None:
+        self.events: list[str] = []
+        self.close_failures = close_failures or {}
+        self.install_failures = install_failures or set()
+
+    def install(self, label: str) -> _CloseRegistration:
+        self.events.append(f"install:{label}")
+        if label in self.install_failures:
+            raise RuntimeError(f"install failed: {label}")
+        return _CloseRegistration(
+            label,
+            self.events,
+            failures=self.close_failures.get(label, 0),
+        )
+
+
+def _write_entrypoint(
+    site: Path,
+    *,
+    name: str,
+    module_name: str,
+    source: str,
+) -> None:
+    site.mkdir(parents=True, exist_ok=True)
+    (site / f"{module_name}.py").write_text(textwrap.dedent(source), encoding="utf-8")
+    dist_info = site / f"{module_name}-1.0.dist-info"
+    dist_info.mkdir()
+    (dist_info / "METADATA").write_text(
+        f"Metadata-Version: 2.1\nName: {module_name}\nVersion: 1.0\n",
+        encoding="utf-8",
+    )
+    (dist_info / "entry_points.txt").write_text(
+        f"[hermes_agent.plugins]\n{name} = {module_name}\n",
+        encoding="utf-8",
+    )
+
+
+def _manager_with_entrypoints(
+    tmp_path: Path,
+    monkeypatch,
+    host: _RecordingHost | None,
+    plugins: dict[str, str],
+    *,
+    capabilities=frozenset(GATEWAY_EXTENSION_CAPABILITIES_V1),
+) -> PluginManager:
+    site = tmp_path / "site"
+    for index, (name, source) in enumerate(plugins.items()):
+        _write_entrypoint(
+            site,
+            name=name,
+            module_name=f"stage1_entrypoint_{index}_{tmp_path.name.replace('-', '_')}",
+            source=source,
+        )
+    monkeypatch.syspath_prepend(str(site))
+    importlib.invalidate_caches()
+
+    hermes_home = tmp_path / "hermes-home"
+    hermes_home.mkdir()
