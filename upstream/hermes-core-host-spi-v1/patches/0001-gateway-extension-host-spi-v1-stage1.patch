+def test_same_thread_install_and_close_reentry_fail_closed_and_remain_retryable() -> None:
+    host = _RecordingHost()
+    manager = PluginManager(
+        gateway_extension_host=host,
+        gateway_extension_capabilities=GATEWAY_EXTENSION_CAPABILITIES_V1,
+    )
+    install_context = PluginContext(PluginManifest(name="install-reentry"), manager)
+
+    class ReentrantInstall:
+        def install(self, _host):
+            manager.shutdown_extensions()
+            return _CloseRegistration("never", host.events)
+
+    with pytest.raises(HostSpiRegistrationError):
+        install_context.register_gateway_extension(ReentrantInstall(), spi_version=1)
+    assert manager.pending_extension_shutdowns == frozenset()
+
+    close_context = PluginContext(PluginManifest(name="close-reentry"), manager)
+
+    class ReentrantRegistration:
+        def __init__(self) -> None:
+            self.reenter = True
+
+        def close(self) -> None:
+            host.events.append("close:reentrant")
+            if self.reenter:
+                self.reenter = False
+                manager.shutdown_extensions()
+
+    class ReentrantClose:
+        def install(self, _host):
+            return ReentrantRegistration()
+
+    close_context.register_gateway_extension(ReentrantClose(), spi_version=1)
+    first_failures = manager.shutdown_extensions()
+    assert len(first_failures) == 1
+    assert first_failures[0].plugin_key == "close-reentry"
+    assert manager.pending_extension_shutdowns == frozenset({"close-reentry"})
+
+    assert manager.shutdown_extensions() == ()
+    assert manager.pending_extension_shutdowns == frozenset()
+    assert host.events[-2:] == ["close:reentrant", "close:reentrant"]
