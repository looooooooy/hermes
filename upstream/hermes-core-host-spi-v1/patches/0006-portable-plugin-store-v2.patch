+def test_portable_v2_bundle_derives_immutable_artifact_and_private_store(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    manifest, trust_store, store_root, application_root = _signed_portable_v2_bundle(
+        tmp_path
+    )
+    monkeypatch.setenv("HERMES_HOME", str(application_root))
+
+    candidate = _prepare(manifest, trust_store)
+
+    assert candidate.store_root == store_root
+    assert candidate.slot_path.is_relative_to(store_root)
+    candidate.activate()
+    assert (store_root / "active.json").is_file()
+
+
+def test_portable_v2_bundle_accepts_release_build_metadata(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    manifest, trust_store, store_root, application_root = _signed_portable_v2_bundle(
+        tmp_path
+    )
+    release = manifest.parents[2]
+    release_with_build_metadata = release.with_name(
+        f"{release.name}+run.31512192653.1"
+    )
+    release.rename(release_with_build_metadata)
+    manifest = release_with_build_metadata / "plugin" / "metadata" / manifest.name
+    trust_store = release_with_build_metadata / "plugin" / "metadata" / trust_store.name
+    monkeypatch.setenv("HERMES_HOME", str(application_root))
+
+    candidate = _prepare(manifest, trust_store)
+
+    assert candidate.store_root == store_root
+
+
+def test_portable_v2_bundle_rejects_manifest_outside_managed_release(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    manifest, trust_store, store_root, application_root = _signed_portable_v2_bundle(
+        tmp_path
+    )
+    escaped_manifest = application_root / "portable-plugin-manifest.json"
+    manifest.replace(escaped_manifest)
+    monkeypatch.setenv("HERMES_HOME", str(application_root))
+
+    with pytest.raises(Exception, match="managed release"):
+        _prepare(escaped_manifest, trust_store)
+
+    assert not (store_root / "slots").exists()
+
