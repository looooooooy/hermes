+def _signed_portable_v2_bundle(
+    tmp_path: Path,
+) -> tuple[Path, Path, Path, Path]:
+    application_root = tmp_path / "managed"
+    release = application_root / "releases" / "desktop-0.1.0-macos-aarch64"
+    metadata = release / "plugin" / "metadata"
+    metadata.mkdir(parents=True)
+    private_key = Ed25519PrivateKey.generate()
+    public_key = private_key.public_key().public_bytes(
+        encoding=serialization.Encoding.Raw,
+        format=serialization.PublicFormat.Raw,
+    )
+    now = datetime.now(timezone.utc)
+    trust_store = metadata / "trust-store.json"
+    trust_store.write_text(
+        json.dumps(
+            {
+                "schema_version": 1,
+                "keys": [
+                    {
+                        "key_id": "release-key-1",
+                        "signature_algorithm": "ed25519",
+                        "public_key": base64.b64encode(public_key).decode("ascii"),
+                        "not_before": (now - timedelta(hours=1)).isoformat(),
+                        "not_after": (now + timedelta(days=30)).isoformat(),
+                    }
+                ],
+            },
+            sort_keys=True,
+        ),
+        encoding="utf-8",
+    )
+    artifact_filename = "hermes_agent_plugin-1.2.3-py3-none-any.whl"
+    artifact_root = release / "plugin" / "artifacts" / PLUGIN_ID / "1.2.3"
+    artifact_root.mkdir(parents=True)
+    temporary_wheel = artifact_root / artifact_filename
+    _write_wheel(temporary_wheel)
+    wheel_sha256 = hashlib.sha256(temporary_wheel.read_bytes()).hexdigest()
+    wheel = artifact_root / wheel_sha256 / artifact_filename
+    wheel.parent.mkdir()
+    temporary_wheel.replace(wheel)
+    payload: dict[str, object] = {
+        "schema_version": 2,
+        "plugin_id": PLUGIN_ID,
+        "version": "1.2.3",
+        "artifact_filename": artifact_filename,
+        "wheel_sha256": wheel_sha256,
+        "entrypoint": ENTRYPOINT,
+        "signature_algorithm": "ed25519",
+        "key_id": "release-key-1",
+        "issued_at": now.isoformat(),
+        "expires_at": (now + timedelta(hours=1)).isoformat(),
+    }
+    payload["signature"] = base64.b64encode(
+        private_key.sign(_canonical_manifest_bytes(payload))
+    ).decode("ascii")
+    manifest = metadata / "signed-plugin-manifest.json"
+    manifest.write_text(json.dumps(payload, sort_keys=True), encoding="utf-8")
+    state_root = application_root / "state" / "default" / "plugin-store"
+    state_root.mkdir(parents=True)
+    state_root.chmod(0o700)
+    for path in (manifest, trust_store, wheel):
+        path.chmod(0o444)
+    return manifest, trust_store, state_root, application_root
+
+
