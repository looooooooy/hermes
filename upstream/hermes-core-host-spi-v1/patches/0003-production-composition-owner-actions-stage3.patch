+def _new_extension_turn_admission(turn_id: str) -> dict:
+    return {
+        "event": threading.Event(),
+        "lock": threading.Lock(),
+        "status": "pending",
+        "reason": None,
+        "turn_id": turn_id,
+        "turn_generation": None,
+    }
+
+
+def _resolve_extension_turn_admission(
+    session: dict,
+    *,
+    status: str,
+    reason: str | None = None,
+    turn_id: str | None = None,
+    turn_generation: int | None = None,
+    admission: dict | None = None,
+) -> bool:
+    """Resolve one owner prompt exactly once at the real turn boundary."""
+    if not isinstance(admission, dict):
+        admission = session.get("_extension_turn_admission")
+    if not isinstance(admission, dict):
+        return False
+    lock = admission.get("lock")
+    event = admission.get("event")
+    if lock is None or event is None:
+        return False
+    with lock:
+        if admission.get("status") != "pending":
+            return False
+        expected_turn_id = str(admission.get("turn_id") or "")
+        if turn_id is not None and str(turn_id) != expected_turn_id:
+            admission["status"] = "effect_unknown"
+            admission["reason"] = "turn_identity_mismatch"
+        else:
+            admission["status"] = status
+            admission["reason"] = reason
+            if turn_generation is not None:
+                admission["turn_generation"] = int(turn_generation)
+        event.set()
+        return True
+
+
+def _extension_turn_admission_result(admission: dict) -> dict:
+    result = {"status": str(admission.get("status") or "effect_unknown")}
+    reason = admission.get("reason")
+    if isinstance(reason, str) and reason:
+        result["reason"] = reason
+    turn_id = admission.get("turn_id")
+    if isinstance(turn_id, str) and turn_id:
+        result["turn_id"] = turn_id
+    generation = admission.get("turn_generation")
+    if type(generation) is int and generation > 0:
+        result["turn_generation"] = generation
+    return result
 
 
