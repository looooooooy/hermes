+def prepare_plugin_bundle(
+    manifest_path: str | os.PathLike[str],
+    trust_store_path: str | os.PathLike[str],
+    *,
+    now: datetime | None = None,
+) -> PluginStoreCandidate:
+    """Verify and prepare one signed immutable Plugin Store candidate."""
+
+    manifest_file = _canonical_read_only_file(
+        Path(manifest_path), label="plugin bundle manifest"
+    )
+    trust_file = _canonical_read_only_file(
+        Path(trust_store_path), label="trust store"
+    )
+    payload = _read_json_object(manifest_file, label="plugin bundle manifest")
+    _require_exact_fields(payload, _MANIFEST_FIELDS, label="plugin bundle manifest")
+    if payload.get("schema_version") != 1:
+        raise PluginStoreError("plugin bundle schema is unsupported")
