+    def _gateway_extension_observer_snapshot(
+        self, session_key: str, session_entry: SessionEntry
+    ) -> dict:
+        agent = getattr(self, "_running_agents", {}).get(session_key)
+        if agent is _AGENT_PENDING_SENTINEL:
+            agent = None
+        messages = []
+        for item in list(getattr(agent, "_session_messages", ()) or ())[-500:]:
+            if not isinstance(item, dict) or item.get("role") not in {"user", "assistant"}:
