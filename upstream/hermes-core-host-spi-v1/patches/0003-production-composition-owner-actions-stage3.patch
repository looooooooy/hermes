+"""One process-level production composition for Gateway Extension Host v1."""
+
+from __future__ import annotations
+
+import logging
+import threading
+import uuid
+from collections.abc import Callable
+
+from hermes_cli.extension_host_v1 import (
+    GATEWAY_EXTENSION_CAPABILITIES_V1,
+    HostSpiRegistrationError,
+)
+from hermes_cli.extension_runtime import ExtensionRuntimeV1
+
+_log = logging.getLogger(__name__)
+_lock = threading.Lock()
+_composition: "ExtensionCompositionV1 | None" = None
+
+
+class _OwnerRevisionLedger:
+    def __init__(self, revision_query: Callable[..., int]) -> None:
+        self._lock = threading.RLock()
+        self._revision_query = revision_query
+
+    def open(
+        self,
+        identity: tuple[str, str, str],
+        open_registration: Callable[[int], object],
+    ) -> object:
+        with self._lock:
+            authority_identity = identity[:2]
+            expected_revision = self._revision_query(
+                profile=authority_identity[0],
+                durable_session_key=authority_identity[1],
+            )
+            if type(expected_revision) is not int or expected_revision < 0:
+                raise HostSpiRegistrationError(
+                    "owner registration revision is unavailable"
+                )
+            registration = open_registration(expected_revision)
+            revision = getattr(registration, "revision", None)
+            close = getattr(registration, "close", None)
+            if type(revision) is not int or revision != expected_revision + 1 or not callable(close):
+                if callable(close):
+                    try:
+                        close()
+                    except BaseException:
+                        pass
+                raise HostSpiRegistrationError(
+                    "owner registration revision is unavailable"
+                )
+            return registration
+
+
+class RevisionAwareOwnerRegistrationSlot:
+    """Transactional owner-registration replacement with per-key CAS memory."""
+
+    def __init__(self, ledger: _OwnerRevisionLedger) -> None:
+        self._ledger = ledger
+        self._lock = threading.RLock()
+        self._identity: tuple[str, str, str] | None = None
+        self._registration: object | None = None
+
+    @property
+    def registration(self) -> object | None:
+        with self._lock:
+            return self._registration
+
+    def replace(
+        self,
+        *,
+        profile: str,
+        durable_session_key: str,
+        runtime_generation: str,
+        open_registration: Callable[[int], object],
+    ) -> object:
+        identity = (profile, durable_session_key, runtime_generation)
+        if any(not isinstance(value, str) or not value for value in identity):
+            raise ValueError("owner registration identity is unavailable")
+        if not callable(open_registration):
+            raise TypeError("owner registration opener must be callable")
+        with self._lock:
+            if self._identity == identity and self._registration is not None:
+                return self._registration
+            replacement = self._ledger.open(identity, open_registration)
+            previous = self._registration
+            if previous is not None:
+                try:
+                    previous.close()
+                except BaseException:
+                    try:
+                        replacement.close()
+                    except BaseException:
+                        pass
+                    raise
+            self._identity = identity
+            self._registration = replacement
+            return replacement
+
+    def close(self) -> None:
+        with self._lock:
+            registration = self._registration
+            if registration is None:
+                return
+            registration.close()
+            self._registration = None
+            self._identity = None
+
+
+class ExtensionCompositionV1:
+    """Own the sole extension runtime used by every surface in this process."""
+
+    def __init__(self, runtime: ExtensionRuntimeV1) -> None:
+        self.runtime = runtime
+        self.host = runtime.host
+        self._owner_revision_ledger = _OwnerRevisionLedger(runtime.owner_revision)
+
+    @property
+    def capabilities(self) -> frozenset[str]:
+        return GATEWAY_EXTENSION_CAPABILITIES_V1 & self.runtime.capabilities
+
+    def register_owner_session(self, **kwargs):
+        return self.runtime.register_owner_session(**kwargs)
+
+    def register_pending_interaction(self, **kwargs):
+        return self.runtime.register_pending_interaction(**kwargs)
+
+    def new_owner_registration_slot(self) -> RevisionAwareOwnerRegistrationSlot:
+        return RevisionAwareOwnerRegistrationSlot(self._owner_revision_ledger)
+
+    def close(self) -> None:
+        self.runtime.close()
+
+
+def _active_profile() -> str:
+    try:
+        from hermes_cli.profiles import get_active_profile_name
+
+        return get_active_profile_name() or "default"
+    except BaseException:
+        return "default"
+
+
+def _audit(event: object) -> None:
+    _log.info(
+        "gateway extension audit name=%s profile=%s generation=%s",
+        getattr(event, "name", "unavailable"),
+        getattr(event, "profile", "unavailable"),
+        getattr(event, "runtime_generation", "unavailable"),
+    )
+
+
+def _new_composition() -> ExtensionCompositionV1:
+    runtime = ExtensionRuntimeV1(
+        profile=_active_profile(),
+        runtime_generation=str(uuid.uuid4()),
+        host_bundle_id="ai.hermes.agent",
+        audit_sink=_audit,
+    )
+    return ExtensionCompositionV1(runtime)
+
+
+def get_extension_composition() -> ExtensionCompositionV1:
+    global _composition
+    with _lock:
+        if _composition is None:
+            _composition = _new_composition()
+        return _composition
+
+
+__all__ = [
+    "ExtensionCompositionV1",
+    "RevisionAwareOwnerRegistrationSlot",
+    "get_extension_composition",
+]
