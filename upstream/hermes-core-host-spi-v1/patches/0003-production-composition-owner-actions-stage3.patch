+    SessionCatalogRequest,
+)
+from hermes_cli.extension_runtime import ExtensionRuntimeV1
+
+
+class _ManualHandle:
+    def __init__(self) -> None:
+        self.closed = False
+
+    def close(self) -> None:
+        self.closed = True
+
+
+class _ManualScheduler:
+    def __init__(self) -> None:
+        self.callbacks = []
+
+    def schedule(self, _delay: float, callback):
+        self.callbacks.append(callback)
+        return _ManualHandle()
+
+
+def _runtime(**kwargs) -> ExtensionRuntimeV1:
+    kwargs.setdefault("monotonic", lambda: 1.0)
+    return ExtensionRuntimeV1(
+        profile="default",
+        runtime_generation="generation-3",
+        host_bundle_id="ai.hermes.agent",
+        authority_deadline_scheduler=_ManualScheduler(),
+        **kwargs,
+    )
+
+
+def _request(command_id: str, method: str, payload: dict) -> OwnerActionRequest:
+    return OwnerActionRequest(
+        profile="default",
+        durable_session_key="session-real",
+        runtime_generation="generation-3",
+        command_id=command_id,
+        method=method,
+        payload=payload,
+    )
+
+
+def test_owner_action_router_is_exactly_once_and_preserves_authority_cas() -> None:
+    runtime = _runtime()
+    effects = []
+
+    def invoke(request: OwnerActionRequest) -> OwnerActionResult:
+        effects.append((request.method, dict(request.payload)))
+        return OwnerActionResult(
+            status=OwnerActionStatus.ACCEPTED,
+            payload={"turn_id": request.payload.get("client_turn_id", "")},
+        )
+
+    registration = runtime.register_owner_session(
+        profile="default",
+        durable_session_key="session-real",
+        runtime_generation="generation-3",
+        controller_id="tui-owner",
+        expected_revision=0,
+        lease_deadline_monotonic=100.0,
+        surface="tui",
+        invoke=invoke,
+        snapshot=lambda: {"status": "waiting"},
+    )
+    request = _request(
+        "command-1",
+        "prompt.submit",
+        {"client_turn_id": "turn-1", "text": "Run focused tests"},
+    )
+
+    first = runtime.host.invoke_owner_action(request)
+    replay = runtime.host.invoke_owner_action(request)
+    collision = runtime.host.invoke_owner_action(
+        _request(
+            "command-1",
+            "prompt.submit",
+            {"client_turn_id": "turn-1", "text": "Different effect"},
+        )
+    )
+    snapshot = runtime.host.control_snapshot(
+        ControlScope("default", "session-real", "generation-3")
+    )
+
+    assert first.status is OwnerActionStatus.ACCEPTED
+    assert replay == first
+    assert collision.status is OwnerActionStatus.REJECTED
+    assert collision.payload == {"reason": "command_id_conflict"}
+    assert effects == [
+        (
+            "prompt.submit",
+            {"client_turn_id": "turn-1", "text": "Run focused tests"},
+        )
+    ]
+    assert snapshot.control_revision == 1
+    assert snapshot.payload == {"status": "waiting"}
+
+    registration.close()
+    with pytest.raises(HostSpiUnavailableError):
+        runtime.host.invoke_owner_action(_request("command-2", "session.interrupt", {}))
+
