+def test_rollback_version_is_rejected_after_higher_version_was_activated(
+    tmp_path: Path,
+) -> None:
+    high_manifest, high_trust, store_root, _ = _signed_bundle(
+        tmp_path / "high",
+        version="2.0.0",
+    )
+    high_candidate = _prepare(high_manifest, high_trust)
+    high_candidate.activate()
+    high_candidate.deactivate()
+
+    low_manifest, low_trust, _, _ = _signed_bundle(
+        tmp_path / "low",
+        version="1.9.9",
+    )
+    low_payload = json.loads(low_manifest.read_text(encoding="utf-8"))
+    low_payload["store_root"] = str(store_root)
+    # A different key cannot re-sign the high release's trust store, so make the
+    # rollback candidate use its own explicit trust store and valid signature.
+    low_key = Ed25519PrivateKey.generate()
+    low_public = low_key.public_key().public_bytes(
+        encoding=serialization.Encoding.Raw,
+        format=serialization.PublicFormat.Raw,
+    )
+    trust_payload = json.loads(low_trust.read_text(encoding="utf-8"))
+    trust_payload["keys"][0]["public_key"] = base64.b64encode(low_public).decode("ascii")
+    low_trust.chmod(0o644)
+    low_trust.write_text(json.dumps(trust_payload), encoding="utf-8")
+    low_trust.chmod(0o444)
+    low_payload["signature"] = base64.b64encode(
+        low_key.sign(_canonical_manifest_bytes(low_payload))
+    ).decode("ascii")
+    low_manifest.chmod(0o644)
+    low_manifest.write_text(json.dumps(low_payload), encoding="utf-8")
+    low_manifest.chmod(0o444)
+
+    with pytest.raises(Exception, match="rollback"):
+        _prepare(low_manifest, low_trust)
