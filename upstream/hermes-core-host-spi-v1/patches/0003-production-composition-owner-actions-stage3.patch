+    delivered = []
+    prepared = runtime.host.prepare_observer(
+        ObserverRequest(
+            profile="default",
+            durable_session_key=durable_session_key,
+            runtime_generation="generation-1",
+            observer_contract=2,
+            required_capabilities=frozenset(
+                {"session.observe.output-parity.v1"}
+            ),
+        ),
+        delivered.append,
+    )
+    active = prepared.activate()
+    return prepared.snapshot, delivered, active
