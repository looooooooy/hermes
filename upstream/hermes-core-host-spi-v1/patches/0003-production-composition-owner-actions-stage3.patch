+"""Signed, immutable Plugin Store loader for Host SPI v1.
+
+The loader intentionally does not install anything into the Agent environment.
+It verifies a release manifest against an operator-selected trust store, expands
+the wheel into an immutable content-addressed slot, and imports the declared
+module directly from that slot without mutating ``sys.path``.
+"""
+
+from __future__ import annotations
+
+import base64
+import configparser
+import hashlib
+import importlib.util
+import json
+import os
+import re
+import shutil
+import stat
+import sys
+import tempfile
+import types
+import zipfile
+from dataclasses import dataclass, field
+from datetime import datetime, timezone
+from email.parser import BytesParser
+from pathlib import Path, PurePosixPath
+from typing import Any, Mapping
+
+from cryptography.exceptions import InvalidSignature
+from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
+from packaging.version import InvalidVersion, Version
+
+
+_MANIFEST_FIELDS = {
+    "schema_version",
+    "plugin_id",
+    "version",
+    "wheel_path",
+    "wheel_sha256",
+    "store_root",
+    "entrypoint",
+    "signature_algorithm",
+    "key_id",
+    "issued_at",
+    "expires_at",
+    "signature",
+}
+_ENTRYPOINT_FIELDS = {"group", "name", "value"}
+_TRUST_STORE_FIELDS = {"schema_version", "keys"}
+_TRUST_KEY_FIELDS = {
+    "key_id",
+    "signature_algorithm",
+    "public_key",
+    "not_before",
+    "not_after",
+}
+_SAFE_ID = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?\Z")
+_SHA256 = re.compile(r"[0-9a-f]{64}\Z")
+
+
+class PluginStoreError(RuntimeError):
+    """A signed Plugin Store bundle failed closed."""
+
+
+def _read_json_object(path: Path, *, label: str) -> dict[str, Any]:
+    try:
+        raw = path.read_bytes()
+        value = json.loads(raw)
+    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
+        raise PluginStoreError(f"{label} is not valid JSON") from error
+    if not isinstance(value, dict):
+        raise PluginStoreError(f"{label} must be a JSON object")
+    return value
+
+
+def _require_exact_fields(
+    value: Mapping[str, Any], expected: set[str], *, label: str
+) -> None:
+    observed = set(value)
+    if observed != expected:
+        missing = sorted(expected - observed)
+        extra = sorted(observed - expected)
+        raise PluginStoreError(
+            f"{label} schema mismatch (missing={missing}, extra={extra})"
+        )
+
+
+def _canonical_manifest_bytes(payload: Mapping[str, Any]) -> bytes:
+    unsigned = {key: value for key, value in payload.items() if key != "signature"}
+    try:
+        return json.dumps(
+            unsigned,
+            ensure_ascii=False,
+            allow_nan=False,
+            separators=(",", ":"),
+            sort_keys=True,
+        ).encode("utf-8")
+    except (TypeError, ValueError) as error:
+        raise PluginStoreError("manifest is not canonical JSON") from error
+
+
+def _parse_time(value: Any, *, label: str) -> datetime:
+    if not isinstance(value, str):
+        raise PluginStoreError(f"{label} must be an RFC3339 timestamp")
+    try:
+        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    except ValueError as error:
+        raise PluginStoreError(f"{label} must be an RFC3339 timestamp") from error
+    if parsed.tzinfo is None or parsed.utcoffset() is None:
+        raise PluginStoreError(f"{label} must include a timezone")
+    return parsed.astimezone(timezone.utc)
+
+
+def _assert_no_symlink_components(path: Path, *, label: str) -> None:
+    if not path.is_absolute():
+        raise PluginStoreError(f"{label} must be an absolute canonical path")
+    current = Path(path.anchor)
+    for part in path.parts[1:]:
+        current /= part
+        try:
+            mode = current.lstat().st_mode
+        except FileNotFoundError:
+            break
+        if stat.S_ISLNK(mode):
+            raise PluginStoreError(f"{label} must not contain a symlink")
+
+
+def _canonical_existing_path(path: Path, *, label: str, directory: bool) -> Path:
+    _assert_no_symlink_components(path, label=label)
+    try:
+        resolved = path.resolve(strict=True)
+    except OSError as error:
+        raise PluginStoreError(f"{label} does not exist") from error
+    if resolved != path:
+        raise PluginStoreError(f"{label} must be a canonical path")
+    if directory and not path.is_dir():
+        raise PluginStoreError(f"{label} must be a directory")
+    if not directory and not path.is_file():
+        raise PluginStoreError(f"{label} must be a regular file")
+    return path
+
+
+def _canonical_read_only_file(path: Path, *, label: str) -> Path:
+    canonical = _canonical_existing_path(path, label=label, directory=False)
+    if canonical.stat().st_mode & 0o222:
+        raise PluginStoreError(f"{label} must be read-only")
+    return canonical
+
+
+def _decode_base64(value: Any, *, label: str) -> bytes:
+    if not isinstance(value, str):
+        raise PluginStoreError(f"{label} must be base64 text")
+    try:
+        return base64.b64decode(value, validate=True)
+    except (ValueError, TypeError) as error:
+        raise PluginStoreError(f"{label} must be valid base64") from error
+
+
+def _verify_signature(
+    payload: Mapping[str, Any], trust_store_path: Path, *, now: datetime
+) -> None:
+    trust = _read_json_object(trust_store_path, label="trust store")
+    _require_exact_fields(trust, _TRUST_STORE_FIELDS, label="trust store")
+    if trust["schema_version"] != 1 or not isinstance(trust["keys"], list):
+        raise PluginStoreError("trust store schema is unsupported")
+    key_id = payload.get("key_id")
+    matches: list[Mapping[str, Any]] = []
+    for candidate in trust["keys"]:
+        if not isinstance(candidate, dict):
+            raise PluginStoreError("trust store key must be an object")
+        _require_exact_fields(candidate, _TRUST_KEY_FIELDS, label="trust store key")
+        if candidate.get("key_id") == key_id:
+            matches.append(candidate)
+    if len(matches) != 1:
+        raise PluginStoreError("unknown or duplicate signing key")
+    key = matches[0]
+    if (
+        payload.get("signature_algorithm") != "ed25519"
+        or key.get("signature_algorithm") != "ed25519"
+    ):
+        raise PluginStoreError("signature algorithm is unsupported")
+    if not (_parse_time(key["not_before"], label="key not_before") <= now):
+        raise PluginStoreError("signing key is not yet valid")
+    if now >= _parse_time(key["not_after"], label="key not_after"):
+        raise PluginStoreError("signing key is expired")
+    public_bytes = _decode_base64(key["public_key"], label="public key")
+    signature = _decode_base64(payload.get("signature"), label="signature")
+    try:
+        public_key = Ed25519PublicKey.from_public_bytes(public_bytes)
+        public_key.verify(signature, _canonical_manifest_bytes(payload))
+    except (ValueError, InvalidSignature) as error:
+        raise PluginStoreError("manifest signature verification failed") from error
+
+
+def _normalized_distribution_name(value: str) -> str:
+    return re.sub(r"[-_.]+", "-", value).lower()
+
+
+def _validate_archive_member(info: zipfile.ZipInfo, seen: set[str]) -> PurePosixPath:
+    name = info.filename
+    if name in seen:
+        raise PluginStoreError("wheel contains a duplicate member")
+    seen.add(name)
+    if "\\" in name:
+        raise PluginStoreError("wheel member path is not canonical")
+    relative = PurePosixPath(name)
+    if relative.is_absolute() or not relative.parts or ".." in relative.parts:
+        raise PluginStoreError("wheel member path escapes the slot")
+    if any(part in {"", "."} for part in relative.parts):
+        raise PluginStoreError("wheel member path is not canonical")
+    member_mode = info.external_attr >> 16
+    if stat.S_ISLNK(member_mode):
+        raise PluginStoreError("wheel member must not be a symlink")
+    lowered = name.lower()
+    if lowered.endswith(".pth") or "__editable__" in lowered:
+        raise PluginStoreError("editable or pth wheel content is forbidden")
+    if lowered.endswith(".dist-info/direct_url.json"):
+        raise PluginStoreError("direct_url wheel metadata is forbidden")
+    return relative
+
+
+def _inspect_wheel(
+    wheel_path: Path,
+    *,
+    plugin_id: str,
+    version: str,
+    entrypoint: Mapping[str, str],
+) -> tuple[zipfile.ZipInfo, ...]:
+    try:
+        archive = zipfile.ZipFile(wheel_path)
+    except (OSError, zipfile.BadZipFile) as error:
+        raise PluginStoreError("plugin artifact is not a valid wheel") from error
+    with archive:
+        infos = tuple(archive.infolist())
+        seen: set[str] = set()
+        for info in infos:
+            _validate_archive_member(info, seen)
+        metadata_infos = [
+            info for info in infos if info.filename.endswith(".dist-info/METADATA")
+        ]
+        entry_infos = [
+            info
+            for info in infos
+            if info.filename.endswith(".dist-info/entry_points.txt")
+        ]
+        if len(metadata_infos) != 1 or len(entry_infos) != 1:
+            raise PluginStoreError("wheel must contain exactly one metadata entrypoint")
+        metadata = BytesParser().parsebytes(archive.read(metadata_infos[0]))
+        if _normalized_distribution_name(metadata.get("Name", "")) != (
+            _normalized_distribution_name(plugin_id)
+        ):
+            raise PluginStoreError("wheel project name does not match plugin_id")
+        if metadata.get("Version") != version:
+            raise PluginStoreError("wheel version does not match manifest")
+        parser = configparser.ConfigParser(interpolation=None, strict=True)
+        parser.optionxform = str
+        try:
+            parser.read_string(archive.read(entry_infos[0]).decode("utf-8"))
+        except (UnicodeDecodeError, configparser.Error) as error:
+            raise PluginStoreError("wheel entrypoint metadata is invalid") from error
+        group = entrypoint["group"]
+        if parser.sections() != [group]:
+            raise PluginStoreError("wheel must declare exactly one plugin entrypoint")
+        entries = list(parser.items(group))
+        if entries != [(entrypoint["name"], entrypoint["value"])]:
+            raise PluginStoreError("wheel must declare exactly one plugin entrypoint")
+        return infos
+
+
+def _fsync_directory(path: Path) -> None:
+    descriptor = os.open(path, os.O_RDONLY)
+    try:
+        os.fsync(descriptor)
+    finally:
+        os.close(descriptor)
+
+
+def _atomic_json_write(path: Path, payload: Mapping[str, Any]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    _assert_no_symlink_components(path.parent, label="state directory")
+    contents = json.dumps(
+        payload,
+        ensure_ascii=False,
+        allow_nan=False,
+        separators=(",", ":"),
+        sort_keys=True,
+    ).encode("utf-8")
+    descriptor, raw_temp = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
+    temp = Path(raw_temp)
+    try:
+        with os.fdopen(descriptor, "wb") as handle:
+            handle.write(contents)
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.chmod(temp, 0o600)
+        os.replace(temp, path)
+        _fsync_directory(path.parent)
+    finally:
+        temp.unlink(missing_ok=True)
+
+
+def _extract_immutable_slot(
+    wheel_path: Path,
+    infos: tuple[zipfile.ZipInfo, ...],
+    slot_path: Path,
+    *,
+    wheel_sha256: str,
+) -> None:
+    slot_parent = slot_path.parent
+    slot_parent.mkdir(parents=True, exist_ok=True)
+    _assert_no_symlink_components(slot_parent, label="slot parent")
+    if slot_path.exists():
+        _canonical_existing_path(slot_path, label="plugin slot", directory=True)
+        marker = slot_path / ".hermes-wheel-sha256"
+        if marker.read_text(encoding="ascii") != wheel_sha256:
+            raise PluginStoreError("existing immutable slot does not match wheel")
+        return
+    temp = Path(tempfile.mkdtemp(prefix=f".{slot_path.name}.", dir=slot_parent))
+    try:
+        with zipfile.ZipFile(wheel_path) as archive:
+            for info in infos:
+                relative = PurePosixPath(info.filename)
+                target = temp.joinpath(*relative.parts)
+                if info.is_dir():
+                    target.mkdir(parents=True, exist_ok=True)
+                    continue
+                target.parent.mkdir(parents=True, exist_ok=True)
+                flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
+                if hasattr(os, "O_NOFOLLOW"):
+                    flags |= os.O_NOFOLLOW
+                descriptor = os.open(target, flags, 0o600)
+                with os.fdopen(descriptor, "wb") as handle:
+                    handle.write(archive.read(info))
+                    handle.flush()
+                    os.fsync(handle.fileno())
+        marker = temp / ".hermes-wheel-sha256"
+        marker.write_text(wheel_sha256, encoding="ascii")
+        os.chmod(marker, 0o444)
+        for child in temp.rglob("*"):
+            os.chmod(child, 0o555 if child.is_dir() else 0o444)
+        os.chmod(temp, 0o555)
+        try:
+            os.replace(temp, slot_path)
+        except OSError:
+            if not slot_path.exists():
+                raise
+        _fsync_directory(slot_parent)
+    finally:
+        if temp.exists():
+            shutil.rmtree(temp)
+
+
+def _assert_module_origins(module_prefix: str, slot_path: Path) -> None:
+    for name, module in tuple(sys.modules.items()):
+        if name != module_prefix and not name.startswith(f"{module_prefix}."):
+            continue
+        origin = getattr(module, "__file__", None)
+        if origin is None:
+            continue
+        path = Path(origin).resolve(strict=True)
+        if not path.is_relative_to(slot_path):
+            raise PluginStoreError("loaded plugin module origin escapes immutable slot")
+
+
+@dataclass
+class PluginStoreCandidate:
+    plugin_id: str
+    version: str
+    wheel_sha256: str
+    store_root: Path
+    entrypoint: dict[str, str]
+    slot_path: Path
+    manifest_path: Path
+    _module: types.ModuleType | None = field(default=None, init=False, repr=False)
+    _replaced_modules: dict[str, types.ModuleType] = field(
+        default_factory=dict, init=False, repr=False
+    )
+
+    @property
+    def module_name(self) -> str:
+        return self.entrypoint["value"].split(":", 1)[0]
+
+    def load_module(self) -> types.ModuleType:
+        if self._module is not None:
+            return self._module
+        module_name = self.module_name
+        parts = module_name.split(".")
+        if any(not part.isidentifier() for part in parts):
+            raise PluginStoreError("entrypoint module name is invalid")
+        package = self.slot_path.joinpath(*parts, "__init__.py")
+        module_file = self.slot_path.joinpath(*parts).with_suffix(".py")
+        if package.is_file():
+            origin = package
+            submodule_paths: list[str] | None = [str(package.parent)]
+        elif module_file.is_file():
+            origin = module_file
+            submodule_paths = None
+        else:
+            raise PluginStoreError("entrypoint module is missing from immutable slot")
+        prefix = parts[0]
+        replaced = {
+            name: module
+            for name, module in tuple(sys.modules.items())
+            if name == prefix or name.startswith(f"{prefix}.")
+        }
+        for name in replaced:
+            sys.modules.pop(name, None)
+        try:
+            spec = importlib.util.spec_from_file_location(
+                module_name,
+                origin,
+                submodule_search_locations=submodule_paths,
+            )
+            if spec is None or spec.loader is None:
+                raise PluginStoreError("entrypoint module cannot be loaded")
+            module = importlib.util.module_from_spec(spec)
+            sys.modules[module_name] = module
+            spec.loader.exec_module(module)
+            _assert_module_origins(prefix, self.slot_path)
+        except BaseException:
+            for name in tuple(sys.modules):
+                if name == prefix or name.startswith(f"{prefix}."):
+                    sys.modules.pop(name, None)
+            sys.modules.update(replaced)
+            raise
+        self._replaced_modules = replaced
+        self._module = module
+        return module
+
+    def unload_module(self) -> None:
+        module = self._module
+        if module is None:
+            return
+        prefix = self.module_name.split(".", 1)[0]
+        for name in tuple(sys.modules):
+            if name == prefix or name.startswith(f"{prefix}."):
+                current = sys.modules.get(name)
+                origin = getattr(current, "__file__", None)
+                if origin is None or Path(origin).resolve().is_relative_to(self.slot_path):
+                    sys.modules.pop(name, None)
+        sys.modules.update(self._replaced_modules)
+        self._replaced_modules.clear()
+        self._module = None
+
+    def activate(self) -> None:
+        floor_dir = self.store_root / "version-floor"
+        floor_path = floor_dir / f"{self.plugin_id}.json"
+        active_path = self.store_root / "active.json"
+        floor = {
+            "schema_version": 1,
+            "plugin_id": self.plugin_id,
+            "version": self.version,
+            "wheel_sha256": self.wheel_sha256,
+            "activated_at": datetime.now(timezone.utc).isoformat(),
+        }
+        if floor_path.exists():
+            current = _read_json_object(floor_path, label="rollback floor")
+            if Version(self.version) < Version(str(current.get("version", ""))):
+                raise PluginStoreError("plugin version rollback is forbidden")
+            if (
+                current.get("version") == self.version
+                and current.get("wheel_sha256") != self.wheel_sha256
+            ):
+                raise PluginStoreError("plugin version artifact drift is forbidden")
+            if current.get("version") == self.version:
+                floor = current
+        _atomic_json_write(floor_path, floor)
+        active = {
+            "schema_version": 1,
+            "plugin_id": self.plugin_id,
+            "version": self.version,
+            "wheel_sha256": self.wheel_sha256,
+            "slot_path": str(self.slot_path),
+        }
+        if active_path.exists():
+            current_active = _read_json_object(active_path, label="active pointer")
+            if current_active == active:
+                return
+        _atomic_json_write(active_path, active)
+
+    def deactivate(self) -> None:
+        active_path = self.store_root / "active.json"
+        if not active_path.exists():
+            return
