+def _owner_inbox(*, wait_timeout_seconds: float = 0.25):
+    from hermes_cli import extension_owner_runtime
+
+    inbox_type = getattr(extension_owner_runtime, "OwnerActionInbox", None)
+    assert inbox_type is not None, "OwnerActionInbox must be a public Core adapter"
+    inbox = inbox_type(wait_timeout_seconds=wait_timeout_seconds)
+    inbox.rebind(
+        profile="default",
+        durable_session_key="session-1",
+        runtime_generation="generation-1",
+    )
+    return inbox
+
+
+def _submit_in_thread(inbox, request, *, queued: bool):
+    results = []
+    thread = threading.Thread(
+        target=lambda: results.append(inbox.submit(request, queued=queued)),
+    )
+    thread.start()
+    return thread, results
+
+
+def test_owner_inbox_waits_for_main_loop_ack_before_accepting_idle_or_queued_prompt() -> None:
+    for queued, disposition in ((False, "accepted"), (True, "queued")):
+        inbox = _owner_inbox()
+        consumer = inbox.open_consumer()
+        request = _cli_owner_request(
+            "prompt.submit",
+            {"client_turn_id": f"client-{disposition}", "text": disposition},
+        )
+        thread, results = _submit_in_thread(inbox, request, queued=queued)
+
+        delivery = consumer.receive(timeout_seconds=0.1)
+        assert delivery is not None
+        assert results == []
+        assert delivery.request is request
+        assert delivery.accept(
+            turn_id=f"real-{disposition}",
+            disposition=disposition,
+        )
+        thread.join(timeout=1.0)
+
+        assert not thread.is_alive()
+        assert results[0].status is OwnerActionStatus.ACCEPTED
+        assert results[0].payload == {
+            "turn_id": f"real-{disposition}",
+            "disposition": disposition,
+        }
+        consumer.close()
+        inbox.close()
+
+
+def test_owner_inbox_rejects_pending_delivery_on_rebind_and_shutdown() -> None:
+    inbox = _owner_inbox()
+    consumer = inbox.open_consumer()
+    request = _cli_owner_request(
+        "prompt.submit",
+        {"client_turn_id": "client-turn-1", "text": "first"},
+    )
+    thread, results = _submit_in_thread(inbox, request, queued=False)
+    delivery = consumer.receive(timeout_seconds=0.1)
+    assert delivery is not None
+
+    inbox.rebind(
+        profile="default",
+        durable_session_key="session-2",
+        runtime_generation="generation-1",
+    )
+    thread.join(timeout=1.0)
+
+    assert results[0].status is OwnerActionStatus.REJECTED
+    assert results[0].payload == {"reason": "binding_replaced"}
+    assert delivery.accept(turn_id="stale-turn", disposition="accepted") is False
+    consumer.close()
+
+    replacement = inbox.open_consumer()
+    next_request = OwnerActionRequest(
+        profile="default",
+        durable_session_key="session-2",
+        runtime_generation="generation-1",
+        command_id="command-next",
+        method="prompt.submit",
+        payload={"client_turn_id": "client-next", "text": "next"},
+    )
+    next_thread, next_results = _submit_in_thread(inbox, next_request, queued=False)
+    assert replacement.receive(timeout_seconds=0.1) is not None
+    inbox.close()
+    next_thread.join(timeout=1.0)
+
+    assert next_results[0].status is OwnerActionStatus.REJECTED
+    assert next_results[0].payload == {"reason": "turn_consumer_unavailable"}
+
