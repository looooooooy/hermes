+def test_owner_turn_scheduler_waits_for_the_real_main_loop_before_ack() -> None:
+    from hermes_cli import extension_owner_runtime
+
+    scheduler_type = getattr(extension_owner_runtime, "OwnerTurnScheduler", None)
+    assert scheduler_type is not None, "Core must provide a main-turn scheduler"
+    inbox = _owner_inbox(wait_timeout_seconds=0.5)
+    scheduler = scheduler_type(inbox, turn_id_factory=lambda: "real-running-turn")
+    scheduler.start()
+    request = _cli_owner_request(
+        "prompt.submit",
+        {"client_turn_id": "client-running", "text": "after current turn"},
+    )
+    thread, results = _submit_in_thread(inbox, request, queued=True)
+
+    thread.join(timeout=0.1)
+
+    assert thread.is_alive(), "scheduler staging is not a main-loop delivery ack"
+    assert results == []
+    bound = []
+    scheduled = scheduler.receive(
+        timeout_seconds=0.1,
+        bind=lambda item: bound.append(item.turn_id) or True,
+    )
+    assert scheduled is not None
+    assert scheduled.request is request
+    assert scheduled.turn_id == "real-running-turn"
+    thread.join(timeout=1.0)
+    assert not thread.is_alive()
+    assert bound == ["real-running-turn"]
+    assert results[0].status is OwnerActionStatus.ACCEPTED
+    assert results[0].payload == {
+        "turn_id": "real-running-turn",
+        "disposition": "queued",
+    }
+    scheduler.close()
+    inbox.close()
