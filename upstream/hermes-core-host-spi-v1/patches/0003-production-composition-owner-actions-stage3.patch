+def test_worker_registration_slots_recover_after_post_bind_partial_failure(
+    monkeypatch,
+    surface: str,
+    failure_stage: str,
+) -> None:
+    from hermes_cli.extension_host_v1 import (
+        HostSpiRegistrationError,
+        HostSpiUnavailableError,
+    )
+
+    composition = _production_composition(monkeypatch)
+    target = (
+        composition.runtime.owner_actions
+        if failure_stage == "owner"
+        else composition.runtime.output_parity
+    )
+    real_register = target.register
+    attempts = 0
+
+    def fail_once_after_authority_bind(**kwargs):
+        nonlocal attempts
+        attempts += 1
+        if attempts == 1:
+            raise HostSpiRegistrationError(
+                f"{failure_stage} registration failed after bind"
+            )
+        return real_register(**kwargs)
+
+    monkeypatch.setattr(target, "register", fail_once_after_authority_bind)
+
+    if surface == "acp":
+        from acp_adapter.session import SessionManager, SessionState
+
+        manager = SessionManager.__new__(SessionManager)
+        state = SessionState(
+            session_id="session-partial",
+            agent=SimpleNamespace(),
+        )
+        manager._register_extension_session(state)
+        assert state.extension_registration is None
+    else:
+        from cron.scheduler import _register_worker_extension_session
+
+        descriptor = composition.runtime.runtime_descriptor()
+        slot = composition.new_owner_registration_slot()
+        with pytest.raises(
+            HostSpiRegistrationError,
+            match=f"{failure_stage} registration failed after bind",
+        ):
+            _register_worker_extension_session(
+                slot,
+                composition=composition,
+                descriptor=descriptor,
+                agent=SimpleNamespace(session_id="session-partial"),
+                job_id="job-1",
+                durable_session_key="session-partial",
+                prompt="run",
+            )
+
+    with pytest.raises(HostSpiUnavailableError):
+        composition.runtime.sessions.resolve(
+            profile="default",
+            durable_session_key="session-partial",
+            runtime_generation="generation-1",
+        )
+
+    if surface == "acp":
+        manager._register_extension_session(state)
+        recovered = state.extension_registration
+        slot = state.extension_registration_slot
+    else:
+        recovered = _register_worker_extension_session(
+            slot,
+            composition=composition,
+            descriptor=descriptor,
+            agent=SimpleNamespace(session_id="session-partial"),
+            job_id="job-1",
+            durable_session_key="session-partial",
+            prompt="run again",
+        )
+
+    assert recovered.revision == 2
+    assert composition.runtime.sessions.resolve(
+        profile="default",
+        durable_session_key="session-partial",
+        runtime_generation="generation-1",
+    ).revision == 2
+    slot.close()
