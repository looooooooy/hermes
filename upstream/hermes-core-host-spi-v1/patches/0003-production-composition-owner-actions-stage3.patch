+def test_tui_terminal_running_revision_is_idempotent_under_callback_race(
+    monkeypatch,
+) -> None:
+    import threading
+
+    from tui_gateway import server
+
+    delivered = []
+    running_barrier = threading.Barrier(2)
+
+    def publish(event_type, payload):
+        if event_type == "terminal.update" and payload.get("status") == "running":
+            try:
+                running_barrier.wait(timeout=0.2)
+            except threading.BrokenBarrierError:
+                pass
+        delivered.append((event_type, payload))
+
+    registration = SimpleNamespace(publish_output_event=publish)
+    monkeypatch.setattr(
+        server,
+        "_sessions",
+        {
+            "session-1": _bound_tui_output_session(
+                registration,
+                _extension_turn_id="turn-1",
+            )
+        },
+    )
+
+    threads = [
+        threading.Thread(
+            target=server._publish_extension_output,
+            args=(
+                "agent.terminal.lifecycle",
+                "session-1",
+                {"process_id": "process-1", "status": "running", "revision": 1},
+            ),
+        ),
+        threading.Thread(
+            target=server._publish_extension_output,
+            args=(
+                "agent.terminal.output",
+                "session-1",
+                {"process_id": "process-1", "chunk": "visible output"},
+            ),
+        ),
+    ]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join(timeout=1.0)
+
+    running = [
+        payload
+        for event_type, payload in delivered
+        if event_type == "terminal.update" and payload.get("status") == "running"
+    ]
+    assert running == [
+        {
+            "turn_id": "turn-1",
+            "process_id": "process-1",
+            "status": "running",
+            "revision": 1,
+        }
+    ]
+
