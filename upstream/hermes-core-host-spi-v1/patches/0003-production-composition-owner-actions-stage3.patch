+    _verify_signature(payload, trust_file, now=observed_now)
+    issued_at = _parse_time(payload["issued_at"], label="issued_at")
+    expires_at = _parse_time(payload["expires_at"], label="expires_at")
+    if issued_at > observed_now:
+        raise PluginStoreError("plugin bundle is not yet valid")
+    if observed_now >= expires_at:
+        raise PluginStoreError("plugin bundle is expired")
+
+    plugin_id = payload["plugin_id"]
+    version = payload["version"]
+    wheel_sha256 = payload["wheel_sha256"]
+    if not isinstance(plugin_id, str) or _SAFE_ID.fullmatch(plugin_id) is None:
+        raise PluginStoreError("plugin_id is not canonical")
+    if not isinstance(version, str) or _SAFE_ID.fullmatch(version) is None:
+        raise PluginStoreError("plugin version is not canonical")
+    try:
+        parsed_version = Version(version)
+    except InvalidVersion as error:
+        raise PluginStoreError("plugin version is invalid") from error
+    if not isinstance(wheel_sha256, str) or _SHA256.fullmatch(wheel_sha256) is None:
+        raise PluginStoreError("wheel_sha256 is invalid")
+    entrypoint = payload["entrypoint"]
+    if not isinstance(entrypoint, dict):
+        raise PluginStoreError("entrypoint must be an object")
+    _require_exact_fields(entrypoint, _ENTRYPOINT_FIELDS, label="entrypoint")
+    if (
+        entrypoint.get("group") != "hermes_agent.plugins"
+        or entrypoint.get("name") != plugin_id
+        or not isinstance(entrypoint.get("value"), str)
+        or not entrypoint["value"]
+    ):
+        raise PluginStoreError("entrypoint does not match plugin identity")
+
+    wheel_path = _canonical_existing_path(
+        Path(payload["wheel_path"]), label="plugin wheel", directory=False
+    )
+    store_root = _canonical_existing_path(
+        Path(payload["store_root"]), label="plugin store root", directory=True
+    )
+    observed_sha256 = hashlib.sha256(wheel_path.read_bytes()).hexdigest()
+    if observed_sha256 != wheel_sha256:
+        raise PluginStoreError("plugin wheel SHA256 mismatch")
+    floor = _read_rollback_floor(store_root, plugin_id)
+    if floor is not None:
+        try:
+            floor_version = Version(str(floor["version"]))
+        except (KeyError, InvalidVersion) as error:
+            raise PluginStoreError("rollback floor is invalid") from error
+        if parsed_version < floor_version:
+            raise PluginStoreError("plugin version rollback is forbidden")
+        if (
+            parsed_version == floor_version
+            and floor.get("wheel_sha256") != wheel_sha256
+        ):
+            raise PluginStoreError("plugin version artifact drift is forbidden")
+    infos = _inspect_wheel(
+        wheel_path,
+        plugin_id=plugin_id,
+        version=version,
+        entrypoint=entrypoint,
+    )
+    slot_path = (
+        store_root / "slots" / plugin_id / version / wheel_sha256
+    )
+    _extract_immutable_slot(
+        wheel_path,
+        infos,
+        slot_path,
+        wheel_sha256=wheel_sha256,
+    )
+    return PluginStoreCandidate(
+        plugin_id=plugin_id,
+        version=version,
+        wheel_sha256=wheel_sha256,
+        store_root=store_root,
+        entrypoint=dict(entrypoint),
+        slot_path=slot_path,
+        manifest_path=manifest_file,
+    )
+
