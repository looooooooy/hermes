+        for session_key, slot in tuple(slots.items()):
+            try:
+                slot.close()
+            except Exception:
+                logger.debug(
+                    "Failed to close gateway extension session", exc_info=True
+                )
+                continue
+            slots.pop(session_key, None)
+            registrations.pop(session_key, None)
