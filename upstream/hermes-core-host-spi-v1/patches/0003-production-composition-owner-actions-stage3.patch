+def _prepare(manifest: Path, trust_store: Path):
+    from hermes_cli.plugin_store_v1 import prepare_plugin_bundle
+
+    return prepare_plugin_bundle(manifest, trust_store)
+
+
+def _project_root() -> Path:
+    for parent in Path(__file__).resolve().parents:
+        if (parent / "hermes-agent-plugin" / "dist").is_dir():
+            return parent
+    raise AssertionError("Hermes Mobile project root is unavailable")
+
+
+def _signed_real_plugin_bundle(
+    root: Path,
+) -> tuple[Path, Path, Path]:
+    manifest, trust_store, store_root, private_key = _signed_bundle(
+        root,
+        version="0.1.0",
+    )
+    payload = json.loads(manifest.read_text(encoding="utf-8"))
+    wheel = Path(payload["wheel_path"])
+    real_wheel = (
+        _project_root()
+        / "hermes-agent-plugin"
+        / "dist"
+        / "hermes_agent_plugin-0.1.0-py3-none-any.whl"
+    )
+    shutil.copy2(real_wheel, wheel)
+    wheel.chmod(0o444)
+    payload["wheel_sha256"] = hashlib.sha256(wheel.read_bytes()).hexdigest()
+    payload["signature"] = base64.b64encode(
+        private_key.sign(_canonical_manifest_bytes(payload))
+    ).decode("ascii")
+    manifest.chmod(0o644)
+    manifest.write_text(json.dumps(payload), encoding="utf-8")
+    manifest.chmod(0o444)
+    return manifest, trust_store, store_root
+
