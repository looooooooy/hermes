+class _ShutdownSpyPluginManager:
+    def __init__(self) -> None:
+        self.calls = 0
+        self.running_loops = []
+
+    def shutdown_extensions(self):
+        self.calls += 1
+        loop = asyncio.get_running_loop()
+        assert not loop.is_closed()
+        self.running_loops.append(loop)
+        return ()
+
+
+def _install_shutdown_spy(monkeypatch) -> _ShutdownSpyPluginManager:
+    from hermes_cli import plugins
+
+    manager = _ShutdownSpyPluginManager()
+    monkeypatch.setattr(plugins, "_plugin_manager", manager)
+    monkeypatch.setattr(
+        plugins,
+        "_plugin_manager_shutdown_owner",
+        None,
+        raising=False,
+    )
+    return manager
+
