+            "    def install(self, host):\n"
+            "        return builtins._store_retry_registration\n"
+            "def register(ctx):\n"
+            "    ctx.register_gateway_extension(Extension(), spi_version=1)\n"
+            "    raise RuntimeError('register rejected after install')\n"
+        ),
+    )
+
+    class RetryRegistration:
+        def __init__(self) -> None:
+            self.attempts = 0
+
+        def close(self) -> None:
+            self.attempts += 1
+            if self.attempts == 1:
+                raise RuntimeError("first close fails")
+
+    registration = RetryRegistration()
+    monkeypatch.setattr(
+        __import__("builtins"),
+        "_store_retry_registration",
+        registration,
+        raising=False,
+    )
+    monkeypatch.setattr(plugins.PluginManager, "_scan_directory", lambda *args, **kwargs: [])
+    monkeypatch.setattr(plugins.PluginManager, "_scan_entry_points", lambda _self: [])
+    monkeypatch.setattr(plugins, "_get_disabled_plugins", lambda: set())
+    monkeypatch.setattr(plugins, "_get_enabled_plugins", lambda: set())
