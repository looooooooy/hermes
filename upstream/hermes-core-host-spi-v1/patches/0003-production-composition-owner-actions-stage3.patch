+def _owner_action_result(value: object) -> OwnerActionResult:
+    if isinstance(value, OwnerActionResult):
+        return value
+    if isinstance(value, Mapping):
+        status, payload = value.get("status"), value.get("payload", {})
+    else:
+        status, payload = getattr(value, "status", None), getattr(value, "payload", {})
+    if hasattr(status, "value"):
+        status = status.value
+    return OwnerActionResult(status=status, payload=payload)  # type: ignore[arg-type]
+
+
+def _validate_owner_payload(request: OwnerActionRequest) -> None:
+    payload = dict(request.payload)
+    optional_runtime = {"runtime_session_id"}
+    if request.method == "prompt.submit":
+        required, optional = {"client_turn_id", "text"}, optional_runtime
+    elif request.method == "session.interrupt":
+        required, optional = set(), optional_runtime
+    elif request.method == "session.steer":
+        required, optional = {"text"}, optional_runtime
+    elif request.method == "approval.respond":
+        required, optional = {"request_id", "choice"}, optional_runtime
+    else:
+        required, optional = (
+            {"request_id"},
+            optional_runtime | {"choice_id", "other_text"},
+        )
+    if set(payload) - required - optional or not required.issubset(payload):
+        raise ValueError("owner action payload does not match the method")
+    for field in required | ({"runtime_session_id"} & set(payload)):
+        _required_text(payload[field], field)
+    if request.method == "approval.respond" and payload["choice"] not in {
+        "allow_once",
+        "allow_session",
+        "allow_always",
+        "deny",
+    }:
+        raise ValueError("approval choice is unavailable")
+    if request.method == "clarify.respond":
+        answers = {"choice_id", "other_text"} & set(payload)
+        if len(answers) != 1:
+            raise ValueError("clarify response requires exactly one answer")
+        _required_text(payload[next(iter(answers))], "clarify answer")
+
