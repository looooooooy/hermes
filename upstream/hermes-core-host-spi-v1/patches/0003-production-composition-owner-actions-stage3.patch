@@ -0,0 +1,391 @@
+"""Display-safe output-parity state owned by the production Host runtime."""
+
+from __future__ import annotations
+
+import json
+import threading
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from typing import Any
+
+from hermes_cli.extension_host_v1 import (
+    HostSpiUnavailableError,
+    OutputParityEventV2,
+    OutputParitySnapshotV2,
+)
+
+_EMPTY_INFLIGHT = {
+    "user": None,
+    "assistant": None,
+    "streaming": False,
+    "error": None,
+}
+_COLLECTION_IDENTITIES = {
+    "todo.update": ("todo_sections", ("turn_id", "section_id")),
+    "subagent.update": ("subagents", ("turn_id", "subagent_id")),
+    "tool.update": ("tools", ("turn_id", "tool_call_id")),
+    "terminal.update": ("terminals", ("turn_id", "process_id")),
+}
+_MAX_FRAME_BYTES = 256 * 1024
+_DISPLAY_TEXT_FIELDS = {
+    "assistant",
+    "call_label",
+    "content",
+    "error",
+    "goal",
+    "label",
+    "name",
+    "summary",
+    "text",
+    "user",
+}
+_NONEMPTY_DISPLAY_FIELDS = {
+    "assistant",
+    "call_label",
+    "content",
+    "error",
+    "label",
+    "name",
+    "user",
+}
+
+
+def _snapshot_source(value: object) -> Mapping[str, Any]:
+    source = value() if callable(value) else value
+    if not isinstance(source, Mapping):
+        raise TypeError("observer snapshot source must be an object")
+    return source
+
+
+def _mutable_json(value: object) -> object:
+    if isinstance(value, Mapping):
+        return {key: _mutable_json(item) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_mutable_json(item) for item in value]
+    return value
+
+
+def _safe_messages(value: object) -> list[dict[str, object]]:
+    if not isinstance(value, (list, tuple)):
+        raise TypeError("observer messages must be an array")
+    messages: list[dict[str, object]] = []
+    for raw in value[-500:]:
+        if not isinstance(raw, Mapping):
+            continue
+        role = raw.get("role")
+        content = raw.get("content")
+        if role not in {"user", "assistant", "system"}:
+            continue
+        if content is not None and not isinstance(content, str):
+            continue
+        messages.append(
+            {
+                "role": role,
+                "content": content[:4_096] if isinstance(content, str) else None,
+            }
+        )
+    return messages
+
+
+def _safe_inflight(value: object) -> dict[str, object]:
+    if not isinstance(value, Mapping):
+        return dict(_EMPTY_INFLIGHT)
+    result = dict(_EMPTY_INFLIGHT)
+    for name in ("user", "assistant", "error"):
+        item = value.get(name)
+        result[name] = item[:4_096] if isinstance(item, str) else None
+    result["streaming"] = bool(value.get("streaming"))
+    return result
+
+
+def _safe_collection(value: object, limit: int) -> list[Mapping[str, object]]:
+    if not isinstance(value, (list, tuple)):
+        return []
+    return [
+        _mutable_json(item) for item in value[:limit] if isinstance(item, Mapping)
+    ]
+
+
+def _display_text_slots(value: object):
+    if isinstance(value, dict):
+        for key, item in value.items():
+            if key in _DISPLAY_TEXT_FIELDS and isinstance(item, str):
+                yield value, key, 1 if key in _NONEMPTY_DISPLAY_FIELDS else 0
+            else:
+                yield from _display_text_slots(item)
+    elif isinstance(value, list):
+        for item in value:
+            yield from _display_text_slots(item)
+
+
+@dataclass
+class _OutputSession:
+    token: object
+    runtime_session_id: str
+    running: bool
+    status: str
+    messages: list[Mapping[str, object]]
+    inflight: dict[str, object]
+    todo_sections: list[Mapping[str, object]]
+    subagents: list[Mapping[str, object]]
+    tools: list[Mapping[str, object]]
+    terminals: list[Mapping[str, object]]
+
+
+class OutputParityRegistry:
+    """Current display projection plus the only production v2 event producer."""
+
+    def __init__(self, lock: threading.RLock) -> None:
+        self._lock = lock
+        self._records: dict[tuple[str, str], _OutputSession] = {}
+
+    def register(
+        self,
+        *,
+        profile: str,
+        durable_session_key: str,
+        observer_snapshot: object,
+    ) -> tuple[object, Callable[[], None]]:
+        source = _snapshot_source(observer_snapshot)
+        runtime_session_id = source.get("runtime_session_id")
+        status = source.get("status")
+        running = source.get("running")
+        if not isinstance(runtime_session_id, str) or not runtime_session_id:
+            raise ValueError("runtime_session_id is unavailable")
+        if not isinstance(status, str) or not status:
+            raise ValueError("observer status is unavailable")
+        if type(running) is not bool:
+            raise ValueError("observer running state is unavailable")
+        token = object()
+        record = _OutputSession(
+            token=token,
+            runtime_session_id=runtime_session_id,
+            running=running,
+            status=status,
+            messages=_safe_messages(source.get("messages", ())),
+            inflight=_safe_inflight(source.get("inflight")),
+            todo_sections=_safe_collection(source.get("todo_sections", ()), 64),
+            subagents=_safe_collection(source.get("subagents", ()), 128),
+            tools=_safe_collection(source.get("tools", ()), 128),
+            terminals=_safe_collection(source.get("terminals", ()), 128),
+        )
+        identity = (profile, durable_session_key)
+        with self._lock:
+            self._records[identity] = record
+
+        def close() -> None:
+            with self._lock:
+                current = self._records.get(identity)
+                if current is not None and current.token is token:
+                    del self._records[identity]
+
+        return token, close
+
+    def revoke(self, *, profile: str, durable_session_key: str) -> None:
+        with self._lock:
+            self._records.pop((profile, durable_session_key), None)
+
+    def snapshot(
+        self,
+        *,
+        profile: str,
+        durable_session_key: str,
+        runtime_generation: str,
+        event_sequence: int,
+    ) -> OutputParitySnapshotV2:
+        with self._lock:
+            record = self._records.get((profile, durable_session_key))
+            if record is None:
+                raise HostSpiUnavailableError()
+            messages = [_mutable_json(item) for item in record.messages]
+            inflight = _mutable_json(record.inflight)
+            collections = {
+                "todo_sections": [
+                    _mutable_json(item) for item in record.todo_sections
+                ],
+                "subagents": [_mutable_json(item) for item in record.subagents],
+                "tools": [_mutable_json(item) for item in record.tools],
+                "terminals": [_mutable_json(item) for item in record.terminals],
+            }
+            while True:
+                frame_bytes = len(
+                    json.dumps(
+                        {
+                            "observer_contract": 2,
+                            "profile": profile,
+                            "runtime_generation": runtime_generation,
+                            "session_key": durable_session_key,
+                            "runtime_session_id": record.runtime_session_id,
+                            "running": record.running,
+                            "status": record.status,
+                            "event_sequence": event_sequence,
+                            "snapshot_event_sequence": event_sequence,
+                            "messages": messages,
+                            "inflight": inflight,
+                            "todo_sections": collections["todo_sections"],
+                            "subagents": collections["subagents"],
+                            "tools": collections["tools"],
+                            "terminals": collections["terminals"],
+                            "replay_events": [],
+                        },
+                        ensure_ascii=False,
+                        sort_keys=True,
+                        separators=(",", ":"),
+                        allow_nan=False,
+                    ).encode("utf-8")
+                )
+                if frame_bytes <= _MAX_FRAME_BYTES:
+                    return OutputParitySnapshotV2(
+                        profile=profile,
+                        runtime_generation=runtime_generation,
+                        session_key=durable_session_key,
+                        runtime_session_id=record.runtime_session_id,
+                        running=record.running,
+                        status=record.status,
+                        event_sequence=event_sequence,
+                        snapshot_event_sequence=event_sequence,
+                        messages=tuple(messages),
+                        inflight=inflight,
+                        todo_sections=tuple(collections["todo_sections"]),
+                        subagents=tuple(collections["subagents"]),
+                        tools=tuple(collections["tools"]),
+                        terminals=tuple(collections["terminals"]),
+                        replay_events=(),
+                    )
+                slots = [
+                    slot
+                    for slot in _display_text_slots(
+                        [messages, inflight, *collections.values()]
+                    )
+                    if len(slot[0][slot[1]]) > slot[2]
+                ]
+                if not slots:
+                    raise HostSpiUnavailableError()
+                container, key, minimum = max(
+                    slots,
+                    key=lambda slot: len(slot[0][slot[1]].encode("utf-8")),
+                )
+                text = container[key]
+                overflow = frame_bytes - _MAX_FRAME_BYTES
+                remove = min(len(text) - minimum, max(1, overflow))
+                container[key] = text[: len(text) - remove]
+
+    def event(
+        self,
+        *,
+        profile: str,
+        durable_session_key: str,
+        runtime_generation: str,
+        event_sequence: int,
+        event_type: str,
+        payload: Mapping[str, Any],
+        event_sequence_start: int | None = None,
+    ) -> OutputParityEventV2:
+        with self._lock:
+            record = self._records.get((profile, durable_session_key))
+            if record is None:
+                raise HostSpiUnavailableError()
+            normalized_payload = dict(payload)
+            lifecycle = _COLLECTION_IDENTITIES.get(event_type)
+            if lifecycle is not None:
+                collection_name, identity_fields = lifecycle
+                collection = getattr(record, collection_name)
+                identity = tuple(normalized_payload.get(name) for name in identity_fields)
+                previous = next(
+                    (
+                        item
+                        for item in collection
+                        if tuple(item.get(name) for name in identity_fields) == identity
+                    ),
+                    None,
+                )
+                normalized_payload.setdefault("operation", "upsert")
+                normalized_payload["revision"] = (
+                    int(previous.get("revision", 0)) + 1
+                    if previous is not None
+                    else 1
+                )
+                normalized_payload["first_event_sequence"] = (
+                    int(previous.get("first_event_sequence", event_sequence))
+                    if previous is not None
+                    else event_sequence
+                )
+            return OutputParityEventV2(
+                profile=profile,
+                runtime_generation=runtime_generation,
+                session_key=durable_session_key,
+                session_id=record.runtime_session_id,
+                type=event_type,
+                event_sequence=event_sequence,
+                event_sequence_start=event_sequence_start,
+                payload=normalized_payload,
+            )
+
+    def apply(self, event: OutputParityEventV2) -> None:
+        with self._lock:
+            record = self._records.get((event.profile, event.session_key))
+            if record is None or record.runtime_session_id != event.session_id:
+                raise HostSpiUnavailableError()
+            payload = event.payload
+            if event.type == "message.start":
+                record.running = True
+                record.status = "working"
+                record.inflight = {
+                    "user": None,
+                    "assistant": "",
+                    "streaming": True,
+                    "error": None,
+                }
+            elif event.type == "message.delta":
+                text = payload.get("text")
+                if isinstance(text, str):
+                    current = record.inflight.get("assistant")
+                    record.inflight["assistant"] = (
+                        (current if isinstance(current, str) else "") + text
+                    )
+                    record.inflight["streaming"] = True
+            elif event.type == "message.complete":
+                text = payload.get("text")
+                if not isinstance(text, str):
+                    current = record.inflight.get("assistant")
+                    text = current if isinstance(current, str) else ""
+                if text:
+                    record.messages.append({"role": "assistant", "content": text})
+                    del record.messages[:-500]
+                failed = payload.get("status") == "error"
+                record.running = False
+                record.status = "error" if failed else "idle"
+                record.inflight = dict(_EMPTY_INFLIGHT)
+                if failed:
+                    error = payload.get("error")
+                    record.inflight["error"] = error if isinstance(error, str) else None
+            elif event.type == "status.update":
+                status = payload.get("status")
+                running = payload.get("running")
+                if isinstance(status, str) and status:
+                    record.status = status
+                if type(running) is bool:
+                    record.running = running
+            elif event.type in _COLLECTION_IDENTITIES:
+                collection_name, identity_fields = _COLLECTION_IDENTITIES[event.type]
+                collection = getattr(record, collection_name)
+                identity = tuple(payload.get(name) for name in identity_fields)
+                index = next(
+                    (
+                        offset
+                        for offset, item in enumerate(collection)
+                        if tuple(item.get(name) for name in identity_fields) == identity
+                    ),
+                    None,
+                )
+                if payload.get("operation") == "delete":
+                    if index is not None:
+                        collection.pop(index)
+                else:
+                    state = _mutable_json(payload)
+                    assert isinstance(state, dict)
+                    state.pop("operation", None)
+                    if index is None:
+                        collection.append(state)
+                    else:
+                        collection[index] = state
