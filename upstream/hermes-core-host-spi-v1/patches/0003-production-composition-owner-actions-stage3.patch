+            )
+        if status == "effect_unknown":
+            return _extension_owner_result(
+                "effect_unknown", reason or "turn_admission_unknown"
+            )
+        return _extension_owner_result(
+            "effect_unknown", "turn_admission_unknown"
+        )
+    if request.method == "session.interrupt":
+        status = result.get("status")
+        if status == "interrupted":
+            from hermes_cli.extension_host_v1 import (
+                OwnerActionResult,
+                OwnerActionStatus,
+            )
+
+            return OwnerActionResult(
+                OwnerActionStatus.ACCEPTED,
+                {
+                    "turn_id": result.get("turn_id"),
+                    "turn_generation": result.get("turn_generation"),
+                },
+            )
+        if status == "unavailable":
+            return _extension_owner_result(
+                "rejected",
+                str(result.get("reason") or "turn_unavailable"),
