+        def publish_output(
+            event_type: str,
+            payload: Mapping[str, Any],
+            event_sequence_start: int | None,
+        ) -> object:
+            with self._lock:
+                binding = self.sessions._resolve_locked(
+                    profile,
+                    durable_session_key,
+                    runtime_generation,
+                )
+                event = self.output_parity.event(
+                    profile=profile,
+                    durable_session_key=durable_session_key,
+                    runtime_generation=runtime_generation,
+                    event_sequence=binding.sequence + 1,
+                    event_type=event_type,
+                    payload=payload,
+                    event_sequence_start=event_sequence_start,
+                )
+                self.observers.publish_output_parity(event)
+                self.output_parity.apply(event)
+                return event
+        return _OwnerSessionRegistration(
+            owner_registration,
+            authority_registration,
+            binding.revision,
+            output_close,
+            publish_output,
+        )
+
+    def owner_revision(self, *, profile: str, durable_session_key: str) -> int:
+        """Read the authority registry's current CAS tombstone revision."""
+
+        with self._lock:
+            if not self._accepting:
+                raise HostSpiUnavailableError()
+        return self.sessions.current_revision(
+            profile=profile,
+            durable_session_key=durable_session_key,
+        )
+
+    def register_local_endpoint(self, endpoint: object) -> Registration:
+        role = getattr(endpoint, "connection_role", None)
+        if role not in {"local-gateway", "observer", "control"}:
+            raise HostSpiRegistrationError("local endpoint role is unavailable")
+        opener = getattr(endpoint, "open_local_endpoint", None)
+        if not callable(opener):
+            raise HostSpiRegistrationError("local endpoint descriptor is invalid")
+        try:
+            parameters = tuple(inspect.signature(opener).parameters.values())
+        except (TypeError, ValueError):
+            raise HostSpiRegistrationError(
+                "local endpoint descriptor is invalid"
+            ) from None
+        if (
+            len(parameters) != 1
+            or parameters[0].name != "runtime"
+            or parameters[0].kind
+            not in {
+                inspect.Parameter.POSITIONAL_ONLY,
+                inspect.Parameter.POSITIONAL_OR_KEYWORD,
+            }
+        ):
+            raise HostSpiRegistrationError("local endpoint descriptor is invalid")
+        with self._lock:
+            if not self._accepting:
+                raise HostSpiUnavailableError()
+            registrar = self._endpoint_registrar
+        if registrar is None:
+            try:
+                raw_registration = opener(self.runtime_descriptor())
+            except HostSpiError:
+                raise
+            except BaseException:
+                raise HostSpiRegistrationError(
+                    "local endpoint registration failed"
+                ) from None
+        else:
+            try:
+                raw_registration = registrar(endpoint)
+            except HostSpiError:
+                raise
+            except BaseException:
+                raise HostSpiRegistrationError(
+                    "local endpoint registration failed"
+                ) from None
+        if not callable(getattr(raw_registration, "close", None)):
+            raise HostSpiRegistrationError(
+                "local endpoint registration must return a Registration"
+            )
+        managed = _ManagedEndpointRegistration(self, raw_registration)
+        with self._lock:
+            if not self._accepting:
+                managed.close()
+                raise HostSpiUnavailableError()
+            self._endpoint_registrations.append(managed)
+        return managed
+
+    def _forget_endpoint(self, registration: _ManagedEndpointRegistration) -> None:
+        with self._lock:
+            if registration in self._endpoint_registrations:
+                self._endpoint_registrations.remove(registration)
+
+    def register_pending_interaction(
+        self,
+        *,
+        profile: str,
+        durable_session_key: str,
+        runtime_generation: str,
+        request_id: str,
+        kind: str,
+    ) -> Registration:
+        return self.owner_actions.pending.register(
+            profile=profile,
+            durable_session_key=durable_session_key,
+            runtime_generation=runtime_generation,
+            request_id=request_id,
+            kind=kind,
+        )
+
+    def add_runtime_listener(self, listener: object) -> Registration:
+        target = listener if callable(listener) else getattr(
+            listener, "on_runtime_descriptor", None
+        )
+        if not callable(target):
+            raise TypeError("runtime listener must be callable")
+        token = object()
+        with self._lock:
+            if not self._accepting:
+                raise HostSpiUnavailableError()
+            self._runtime_listeners[token] = target
+            descriptor = self.runtime_descriptor()
+        try:
+            target(descriptor)
+        except BaseException:
+            with self._lock:
+                self._runtime_listeners.pop(token, None)
+            raise HostSpiRegistrationError("runtime listener failed") from None
+        return _CallbackRegistration(
+            lambda: self._remove_runtime_listener(token)
+        )
+
+    def _remove_runtime_listener(self, token: object) -> None:
+        with self._lock:
+            self._runtime_listeners.pop(token, None)
+
     def close(self) -> tuple[ObserverCloseFailure, ...]:
         with self._lock:
             self._accepting = False
+            listeners = tuple(self._runtime_listeners.values())
+            endpoints = tuple(reversed(self._endpoint_registrations))
+            descriptor = self.runtime_descriptor()
+        for listener in listeners:
+            try:
+                listener(descriptor)
+            except BaseException:
+                continue
+        for endpoint in endpoints:
+            try:
+                endpoint.close()
+            except BaseException:
+                continue
         failures = self.observers.close_all()
         self.sessions.close_all()
