+"""Agent-neutral owner-action and authoritative session-catalog runtime."""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import threading
+import time
+import unicodedata
+from collections import OrderedDict, deque
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from typing import Any
+
+from hermes_cli.extension_host_v1 import (
+    OWNER_ACTION_METHODS_V1,
+    ControlSnapshot,
+    HostSpiUnavailableError,
+    OwnerActionRequest,
+    OwnerActionResult,
+    OwnerActionStatus,
+    SessionCatalogEntry,
+    SessionCatalogEvent,
+    SessionCatalogPage,
+    SessionCatalogRequest,
+)
+
+MAX_OWNER_ACTION_LEDGER_ENTRIES = 1024
+MAX_OWNER_ACTION_INBOX_ENTRIES = 32
+
+
+def _required_text(value: object, field_name: str) -> str:
+    if (
+        not isinstance(value, str)
+        or not value
+        or value != value.strip()
+        or len(value) > 4096
+        or any(unicodedata.category(character) == "Cc" for character in value)
+    ):
+        raise ValueError(f"{field_name} must be canonical text")
+    return value
+
+
+def invoke_authoritative_interrupt(
+    agent: object,
+    *,
+    message: str | None = None,
+) -> OwnerActionResult:
+    resolver = getattr(agent, "current_turn_identity", None)
+    interrupter = getattr(agent, "interrupt_turn", None)
+    if not callable(resolver) or not callable(interrupter):
+        return OwnerActionResult(
+            OwnerActionStatus.REJECTED,
+            {"reason": "turn_unavailable"},
+        )
+    try:
+        identity = resolver()
+        if (
+            not isinstance(identity, tuple)
+            or len(identity) != 2
+            or not isinstance(identity[0], str)
+            or not identity[0]
+            or type(identity[1]) is not int
+            or identity[1] < 1
+        ):
+            return OwnerActionResult(
+                OwnerActionStatus.REJECTED,
+                {"reason": "turn_unavailable"},
+            )
+        turn_id, turn_generation = identity
+        accepted = interrupter(
+            turn_id=turn_id,
+            turn_generation=turn_generation,
+            message=message,
+        )
+    except Exception:
+        return OwnerActionResult(
+            OwnerActionStatus.EFFECT_UNKNOWN,
+            {"reason": "surface_result_unknown"},
+        )
+    if accepted is not True:
+        return OwnerActionResult(
+            OwnerActionStatus.REJECTED,
+            {"reason": "turn_unavailable"},
+        )
+    return OwnerActionResult(
+        OwnerActionStatus.ACCEPTED,
+        {"turn_id": turn_id, "turn_generation": turn_generation},
+    )
+
+
+class _CloseOnce:
+    def __init__(self, close: Callable[[], None]) -> None:
+        self._close = close
+        self._lock = threading.Lock()
+        self._closed = False
+
+    def close(self) -> None:
+        with self._lock:
+            if self._closed:
+                return
+            self._close()
+            self._closed = True
+
+
+@dataclass
+class _LedgerEntry:
+    digest: str
+    ready: threading.Event
+    result: OwnerActionResult | None = None
+
+
+class OwnerActionLedger:
+    """Bounded process ledger providing exactly-once action invocation."""
+
+    def __init__(self, *, capacity: int = MAX_OWNER_ACTION_LEDGER_ENTRIES) -> None:
+        if type(capacity) is not int or capacity < 1:
+            raise ValueError("owner action ledger capacity must be positive")
+        self._capacity = capacity
+        self._lock = threading.Lock()
+        self._entries: OrderedDict[tuple[str, str, str, str], _LedgerEntry] = (
+            OrderedDict()
+        )
+
+    def execute(
+        self,
+        key: tuple[str, str, str, str],
+        digest: str,
+        operation: Callable[[], OwnerActionResult],
+    ) -> OwnerActionResult:
+        owner = False
+        with self._lock:
+            entry = self._entries.get(key)
+            if entry is not None:
+                if entry.digest != digest:
+                    return OwnerActionResult(
+                        OwnerActionStatus.REJECTED,
+                        {"reason": "command_id_conflict"},
+                    )
+                self._entries.move_to_end(key)
+            else:
+                self._evict_completed_locked()
+                if len(self._entries) >= self._capacity:
+                    return OwnerActionResult(
+                        OwnerActionStatus.REJECTED,
+                        {"reason": "owner_action_capacity"},
+                    )
+                entry = _LedgerEntry(digest=digest, ready=threading.Event())
+                self._entries[key] = entry
+                owner = True
+        if owner:
+            try:
+                result = operation()
+            except BaseException:
+                result = OwnerActionResult(
+                    OwnerActionStatus.EFFECT_UNKNOWN,
+                    {"reason": "owner_action_failed"},
+                )
+            with self._lock:
+                entry.result = result
+                entry.ready.set()
+            return result
+        entry.ready.wait()
+        assert entry.result is not None
+        return entry.result
+
+    def _evict_completed_locked(self) -> None:
+        for key, entry in tuple(self._entries.items()):
+            if len(self._entries) < self._capacity:
+                return
+            if entry.ready.is_set():
+                del self._entries[key]
+
+
+@dataclass
+class _InboxEntry:
+    request: OwnerActionRequest
+    queued: bool
+    binding: tuple[str, str, str]
+    ready: threading.Event
+    state: str = "queued"
+    result: OwnerActionResult | None = None
+
+
+class OwnerActionDelivery:
+    """One main-loop-owned prompt handoff awaiting an authoritative ack."""
+
+    def __init__(
+        self,
+        inbox: "OwnerActionInbox",
+        entry: _InboxEntry,
+        consumer_token: object,
+    ) -> None:
+        self._inbox = inbox
+        self._entry = entry
+        self._consumer_token = consumer_token
+
+    @property
+    def request(self) -> OwnerActionRequest:
+        return self._entry.request
+
+    @property
+    def queued(self) -> bool:
+        return self._entry.queued
+
+    def accept(
+        self,
+        *,
+        turn_id: str,
+        disposition: str,
+        bind: Callable[[], bool] | None = None,
+    ) -> bool:
+        turn_id = _required_text(turn_id, "turn_id")
+        if disposition not in {"accepted", "queued"}:
+            raise ValueError("owner action disposition is unavailable")
+        return self._inbox._resolve(
+            self._entry,
+            self._consumer_token,
+            OwnerActionResult(
+                OwnerActionStatus.ACCEPTED,
+                {"turn_id": turn_id, "disposition": disposition},
+            ),
+            bind=bind,
+        )
+
+    def reject(self, reason: str) -> bool:
+        reason = _required_text(reason, "reason")
+        return self._inbox._resolve(
+            self._entry,
+            self._consumer_token,
+            OwnerActionResult(OwnerActionStatus.REJECTED, {"reason": reason}),
+        )
+
+
+class _OwnerActionConsumer:
+    def __init__(self, inbox: "OwnerActionInbox", token: object) -> None:
+        self._inbox = inbox
+        self._token = token
+        self._closed = False
+
+    def receive(self, *, timeout_seconds: float) -> OwnerActionDelivery | None:
+        if self._closed:
+            return None
+        return self._inbox._receive(self._token, timeout_seconds)
+
+    def close(self) -> None:
+        if self._closed:
+            return
+        self._closed = True
+        self._inbox._close_consumer(self._token)
+
+
+class OwnerActionInbox:
+    """Bounded handoff from Host callers to the authoritative CLI turn loop."""
+
+    def __init__(
+        self,
+        *,
+        wait_timeout_seconds: float = 5.0,
+        capacity: int = MAX_OWNER_ACTION_INBOX_ENTRIES,
+    ) -> None:
+        if (
+            isinstance(wait_timeout_seconds, bool)
+            or not isinstance(wait_timeout_seconds, (int, float))
+            or wait_timeout_seconds <= 0
+        ):
+            raise ValueError("owner action wait timeout must be positive")
+        if type(capacity) is not int or capacity < 1:
+            raise ValueError("owner action inbox capacity must be positive")
+        self._wait_timeout_seconds = float(wait_timeout_seconds)
+        self._capacity = capacity
+        self._condition = threading.Condition()
+        self._binding: tuple[str, str, str] | None = None
+        self._consumer_token: object | None = None
+        self._queued: deque[_InboxEntry] = deque()
+        self._pending: list[_InboxEntry] = []
+        self._closed = False
+
+    def rebind(
+        self,
+        *,
+        profile: str,
+        durable_session_key: str,
+        runtime_generation: str,
+    ) -> None:
+        binding = (
+            _required_text(profile, "profile"),
+            _required_text(durable_session_key, "durable_session_key"),
+            _required_text(runtime_generation, "runtime_generation"),
+        )
+        with self._condition:
+            if self._closed:
+                raise HostSpiUnavailableError()
+            if binding == self._binding:
+                return
+            self._reject_pending_locked("binding_replaced")
+            self._binding = binding
+            self._consumer_token = None
+            self._condition.notify_all()
+
+    def open_consumer(self) -> _OwnerActionConsumer:
+        with self._condition:
+            if self._closed or self._binding is None:
+                raise HostSpiUnavailableError()
+            if self._consumer_token is not None:
+                self._reject_pending_locked("turn_consumer_unavailable")
+            token = object()
+            self._consumer_token = token
+            self._condition.notify_all()
+            return _OwnerActionConsumer(self, token)
+
+    def submit(
+        self,
+        request: OwnerActionRequest,
+        *,
+        queued: bool,
+    ) -> OwnerActionResult:
+        if not isinstance(request, OwnerActionRequest) or type(queued) is not bool:
+            raise TypeError("owner action handoff request is invalid")
+        binding = (
+            request.profile,
+            request.durable_session_key,
+            request.runtime_generation,
+        )
+        with self._condition:
+            if (
+                self._closed
+                or self._consumer_token is None
+                or self._binding != binding
+            ):
+                return OwnerActionResult(
+                    OwnerActionStatus.REJECTED,
+                    {"reason": "turn_consumer_unavailable"},
+                )
+            if len(self._pending) >= self._capacity:
+                return OwnerActionResult(
+                    OwnerActionStatus.REJECTED,
+                    {"reason": "turn_consumer_capacity"},
+                )
+            entry = _InboxEntry(request, queued, binding, threading.Event())
+            self._pending.append(entry)
+            self._queued.append(entry)
+            self._condition.notify_all()
+        if not entry.ready.wait(self._wait_timeout_seconds):
+            with self._condition:
+                if entry.result is None:
+                    self._finish_locked(
+                        entry,
+                        OwnerActionResult(
+                            OwnerActionStatus.REJECTED,
+                            {"reason": "turn_delivery_deadline"},
+                        ),
+                    )
+        assert entry.result is not None
+        return entry.result
+
+    def close(self) -> None:
+        with self._condition:
+            if self._closed:
+                return
+            self._closed = True
+            self._consumer_token = None
+            self._reject_pending_locked("turn_consumer_unavailable")
+            self._condition.notify_all()
+
+    def _receive(
+        self,
+        consumer_token: object,
+        timeout_seconds: float,
+    ) -> OwnerActionDelivery | None:
+        if (
+            isinstance(timeout_seconds, bool)
+            or not isinstance(timeout_seconds, (int, float))
+            or timeout_seconds < 0
+        ):
+            raise ValueError("owner action receive timeout is invalid")
+        with self._condition:
+            ready = self._condition.wait_for(
+                lambda: bool(self._queued)
+                or self._closed
+                or self._consumer_token is not consumer_token,
+                timeout=float(timeout_seconds),
+            )
+            if (
+                not ready
+                or self._closed
+                or self._consumer_token is not consumer_token
+            ):
+                return None
+            while self._queued:
+                entry = self._queued.popleft()
+                if entry.result is not None:
+                    continue
+                entry.state = "claimed"
+                return OwnerActionDelivery(self, entry, consumer_token)
+            return None
+
+    def _resolve(
+        self,
+        entry: _InboxEntry,
+        consumer_token: object,
+        result: OwnerActionResult,
+        *,
+        bind: Callable[[], bool] | None = None,
+    ) -> bool:
+        with self._condition:
+            if (
+                entry.result is not None
+                or entry.state != "claimed"
+                or self._consumer_token is not consumer_token
+                or self._binding != entry.binding
+                or self._closed
+            ):
+                return False
+            if bind is not None:
+                try:
+                    bound = bind() is True
+                except BaseException:
+                    bound = False
+                if not bound:
+                    self._finish_locked(
+                        entry,
+                        OwnerActionResult(
+                            OwnerActionStatus.REJECTED,
+                            {"reason": "turn_consumer_unavailable"},
+                        ),
+                    )
+                    return False
+            self._finish_locked(entry, result)
+            return True
+
+    def _close_consumer(self, consumer_token: object) -> None:
+        with self._condition:
+            if self._consumer_token is not consumer_token:
+                return
+            self._consumer_token = None
+            self._reject_pending_locked("turn_consumer_unavailable")
+            self._condition.notify_all()
+
+    def _reject_pending_locked(self, reason: str) -> None:
+        for entry in tuple(self._pending):
+            self._finish_locked(
+                entry,
+                OwnerActionResult(OwnerActionStatus.REJECTED, {"reason": reason}),
+            )
+        self._queued.clear()
+
+    def _finish_locked(
+        self,
+        entry: _InboxEntry,
+        result: OwnerActionResult,
+    ) -> None:
+        if entry.result is not None:
+            return
+        entry.result = result
+        entry.state = "resolved"
+        if entry in self._pending:
+            self._pending.remove(entry)
+        entry.ready.set()
+        self._condition.notify_all()
+
+
+@dataclass(frozen=True, repr=False)
+class OwnerScheduledPrompt:
+    """A protocol-neutral prompt with its authoritative Core turn identity."""
+
+    request: OwnerActionRequest
+    turn_id: str
+    disposition: str
+
+    def __post_init__(self) -> None:
+        if (
+            not isinstance(self.request, OwnerActionRequest)
+            or self.request.method != "prompt.submit"
+        ):
+            raise ValueError("scheduled owner prompt is unavailable")
+        _required_text(self.turn_id, "turn_id")
+        if self.disposition not in {"accepted", "queued"}:
+            raise ValueError("scheduled owner prompt disposition is unavailable")
+
+    def __repr__(self) -> str:
+        return (
+            "OwnerScheduledPrompt("
+            "request=[REDACTED], "
+            f"turn_id={self.turn_id!r}, disposition={self.disposition!r})"
+        )
+
+
+@dataclass(frozen=True)
+class _StagedOwnerPrompt:
+    scheduled: OwnerScheduledPrompt
+    delivery: OwnerActionDelivery
+
+
+class OwnerTurnScheduler:
+    """Always-live main-turn scheduler between the Host inbox and agent loop."""
+
+    def __init__(
+        self,
+        inbox: OwnerActionInbox,
+        *,
+        turn_id_factory: Callable[[], str],
+        capacity: int = MAX_OWNER_ACTION_INBOX_ENTRIES,
+    ) -> None:
+        if not isinstance(inbox, OwnerActionInbox) or not callable(turn_id_factory):
+            raise TypeError("owner turn scheduler configuration is invalid")
+        if type(capacity) is not int or capacity < 1:
+            raise ValueError("owner turn scheduler capacity must be positive")
+        self._inbox = inbox
+        self._turn_id_factory = turn_id_factory
+        self._capacity = capacity
+        self._condition = threading.Condition()
+        self._scheduled: deque[_StagedOwnerPrompt] = deque()
+        self._consumer: _OwnerActionConsumer | None = None
+        self._thread: threading.Thread | None = None
+        self._started = False
+        self._closed = False
+
+    def start(self) -> None:
+        with self._condition:
+            if self._closed or self._started:
+                raise HostSpiUnavailableError()
+            consumer = self._inbox.open_consumer()
+            thread = threading.Thread(
+                target=self._pump,
+                name="hermes-owner-turn-scheduler",
+                daemon=True,
+            )
+            self._consumer = consumer
+            self._thread = thread
+            self._started = True
+            try:
+                thread.start()
+            except BaseException:
+                self._started = False
+                self._consumer = None
+                self._thread = None
+                consumer.close()
+                raise HostSpiUnavailableError() from None
+
+    def receive(
+        self,
+        *,
+        timeout_seconds: float,
+        bind: Callable[[OwnerScheduledPrompt], bool],
+    ) -> OwnerScheduledPrompt | None:
+        if (
+            isinstance(timeout_seconds, bool)
+            or not isinstance(timeout_seconds, (int, float))
+            or timeout_seconds < 0
+            or not callable(bind)
+        ):
+            raise ValueError("owner turn receive timeout is invalid")
+        with self._condition:
+            deadline = time.monotonic() + float(timeout_seconds)
+            while True:
+                remaining = max(0.0, deadline - time.monotonic())
+                self._condition.wait_for(
+                    lambda: bool(self._scheduled) or self._closed,
+                    timeout=remaining,
+                )
+                if self._closed:
+                    return None
+                while self._scheduled:
+                    staged = self._scheduled.popleft()
+                    scheduled = staged.scheduled
+                    if staged.delivery.accept(
+                        turn_id=scheduled.turn_id,
+                        disposition=scheduled.disposition,
+                        bind=lambda: bind(scheduled),
+                    ):
+                        return scheduled
+                if time.monotonic() >= deadline:
+                    return None
+
+    def close(self) -> None:
+        with self._condition:
+            if self._closed:
+                return
+            self._closed = True
+            consumer = self._consumer
+            thread = self._thread
+            staged = tuple(self._scheduled)
+            self._scheduled.clear()
+            self._condition.notify_all()
+        for item in staged:
+            item.delivery.reject("turn_consumer_unavailable")
+        if consumer is not None:
+            consumer.close()
+        if thread is not None and thread is not threading.current_thread():
+            thread.join(timeout=1.0)
+
+    def _pump(self) -> None:
+        consumer = self._consumer
+        assert consumer is not None
+        while True:
+            with self._condition:
+                if self._closed:
+                    return
+            delivery = consumer.receive(timeout_seconds=0.1)
+            if delivery is None:
+                continue
+            try:
+                turn_id = _required_text(self._turn_id_factory(), "turn_id")
+                disposition = "queued" if delivery.queued else "accepted"
+                scheduled = OwnerScheduledPrompt(
+                    delivery.request,
+                    turn_id,
+                    disposition,
+                )
+            except BaseException:
+                delivery.reject("turn_assignment_failed")
+                continue
+            with self._condition:
+                if self._closed:
+                    delivery.reject("turn_consumer_unavailable")
+                    return
+                if len(self._scheduled) >= self._capacity:
+                    delivery.reject("turn_consumer_capacity")
+                    continue
+                self._scheduled.append(_StagedOwnerPrompt(scheduled, delivery))
+                self._condition.notify_all()
+
+
+@dataclass(frozen=True)
+class _PendingInteraction:
+    kind: str
+    authority_revision: int
+    token: object
+
+
+class PendingInteractionRegistry:
+    """Exact, non-forgeable approval and clarify request bindings."""
+
+    def __init__(self, lock: threading.RLock, sessions: Any) -> None:
+        self._lock = lock
+        self._sessions = sessions
+        self._records: dict[tuple[str, str, str, str], _PendingInteraction] = {}
+
+    def register(
+        self,
+        *,
+        profile: str,
+        durable_session_key: str,
+        runtime_generation: str,
+        request_id: str,
+        kind: str,
+    ) -> _CloseOnce:
+        request_id = _required_text(request_id, "request_id")
+        if kind not in {"approval", "clarify"}:
+            raise ValueError("pending interaction kind is unavailable")
+        binding = self._sessions.resolve(
+            profile=profile,
+            durable_session_key=durable_session_key,
+            runtime_generation=runtime_generation,
+        )
+        identity = (profile, durable_session_key, runtime_generation, request_id)
+        token = object()
+        with self._lock:
+            if identity in self._records:
+                raise HostSpiUnavailableError()
+            self._records[identity] = _PendingInteraction(
+                kind=kind,
+                authority_revision=binding.revision,
+                token=token,
+            )
+        return _CloseOnce(lambda: self._remove(identity, token))
+
+    def matches(self, request: OwnerActionRequest, authority_revision: int) -> bool:
+        kind = {
+            "approval.respond": "approval",
+            "clarify.respond": "clarify",
+        }.get(request.method)
+        if kind is None:
+            return True
+        request_id = request.payload.get("request_id")
+        if not isinstance(request_id, str):
+            return False
+        identity = (
+            request.profile,
+            request.durable_session_key,
+            request.runtime_generation,
+            request_id,
+        )
+        with self._lock:
+            record = self._records.get(identity)
+            return (
+                record is not None
+                and record.kind == kind
+                and record.authority_revision == authority_revision
+            )
+
+    def consume(self, request: OwnerActionRequest) -> None:
+        request_id = request.payload.get("request_id")
+        if not isinstance(request_id, str):
+            return
+        identity = (
+            request.profile,
+            request.durable_session_key,
+            request.runtime_generation,
+            request_id,
+        )
+        with self._lock:
+            self._records.pop(identity, None)
+
+    def revoke_scope(self, *, profile: str, durable_session_key: str) -> None:
+        with self._lock:
+            for identity in tuple(self._records):
+                if identity[:2] == (profile, durable_session_key):
+                    del self._records[identity]
+
+    def _remove(self, identity: tuple[str, str, str, str], token: object) -> None:
+        with self._lock:
+            record = self._records.get(identity)
+            if record is not None and record.token is token:
+                del self._records[identity]
+
+
+class SessionCatalog:
+    """Bounded snapshot and live changes for explicitly registered sessions."""
+
+    def __init__(self, lock: threading.RLock) -> None:
+        self._lock = lock
+        self._entries: dict[tuple[str, str], tuple[object, SessionCatalogEntry]] = {}
+        self._listeners: dict[object, Callable[[SessionCatalogEvent], None]] = {}
+        self._revision = 0
+
+    def upsert(self, entry: SessionCatalogEntry, token: object) -> None:
+        with self._lock:
+            self._entries[(entry.profile, entry.durable_session_key)] = (token, entry)
+            event, listeners = self._event_locked("upsert", entry)
+        self._deliver(listeners, event)
+
+    def remove(self, entry: SessionCatalogEntry, token: object) -> None:
+        with self._lock:
+            identity = (entry.profile, entry.durable_session_key)
+            current = self._entries.get(identity)
+            if current is None or current[0] is not token:
+                return
+            del self._entries[identity]
+            event, listeners = self._event_locked("remove", entry)
+        self._deliver(listeners, event)
+
+    def page(self, request: SessionCatalogRequest) -> SessionCatalogPage:
+        with self._lock:
+            revision = self._revision
+            start = self._decode_cursor(request.cursor, request, revision)
+            entries = sorted(
+                (
+                    entry
+                    for (_token, entry) in self._entries.values()
+                    if entry.profile == request.profile
+                    and entry.runtime_generation == request.runtime_generation
+                ),
+                key=lambda entry: entry.durable_session_key,
+            )
+            selected = tuple(entries[start : start + request.page_size])
+            next_index = start + len(selected)
+            cursor = (
+                self._encode_cursor(request.runtime_generation, revision, next_index)
+                if next_index < len(entries)
+                else None
+            )
+            return SessionCatalogPage(
+                profile=request.profile,
+                runtime_generation=request.runtime_generation,
+                catalog_revision=revision,
+                sessions=selected,
+                next_cursor=cursor,
+            )
+
+    def add_listener(self, listener: object) -> _CloseOnce:
+        target = listener if callable(listener) else getattr(listener, "on_event", None)
+        if not callable(target):
+            raise TypeError("session catalog listener must be callable")
+        token = object()
+        with self._lock:
+            self._listeners[token] = target
+        return _CloseOnce(lambda: self._remove_listener(token))
+
+    def _event_locked(
+        self, action: str, entry: SessionCatalogEntry
+    ) -> tuple[SessionCatalogEvent, tuple[Callable[[SessionCatalogEvent], None], ...]]:
+        self._revision += 1
+        event = SessionCatalogEvent(
+            profile=entry.profile,
+            runtime_generation=entry.runtime_generation,
+            sequence=self._revision,
+            action=action,  # type: ignore[arg-type]
+            entry=entry,
+        )
+        return event, tuple(self._listeners.values())
+
+    @staticmethod
+    def _deliver(
+        listeners: tuple[Callable[[SessionCatalogEvent], None], ...],
+        event: SessionCatalogEvent,
+    ) -> None:
+        for listener in listeners:
+            try:
+                listener(event)
+            except BaseException:
+                continue
+
+    def _remove_listener(self, token: object) -> None:
+        with self._lock:
+            self._listeners.pop(token, None)
+
+    @staticmethod
+    def _encode_cursor(generation: str, revision: int, index: int) -> str:
+        body = json.dumps([generation, revision, index], separators=(",", ":"))
+        return base64.urlsafe_b64encode(body.encode()).decode().rstrip("=")
+
+    @staticmethod
+    def _decode_cursor(
+        cursor: str | None,
+        request: SessionCatalogRequest,
+        revision: int,
+    ) -> int:
+        if cursor is None:
+            return 0
+        try:
+            padding = "=" * (-len(cursor) % 4)
+            generation, cursor_revision, index = json.loads(
+                base64.urlsafe_b64decode(cursor + padding).decode()
+            )
+        except (ValueError, TypeError, UnicodeError, json.JSONDecodeError):
+            raise HostSpiUnavailableError() from None
+        if (
+            generation != request.runtime_generation
+            or cursor_revision != revision
+            or type(index) is not int
+            or index < 0
+        ):
+            raise HostSpiUnavailableError()
+        return index
+
+
+@dataclass(frozen=True)
+class _OwnerSession:
+    token: object
+    authority_revision: int
+    entry: SessionCatalogEntry
+    invoke: Callable[[OwnerActionRequest], object]
+    snapshot: Callable[[], Mapping[str, Any]]
+
+
+class OwnerActionRouter:
+    def __init__(self, lock: threading.RLock, sessions: Any) -> None:
+        self._lock = lock
+        self._sessions = sessions
+        self._records: dict[tuple[str, str], _OwnerSession] = {}
+        self._ledger = OwnerActionLedger()
+        self.pending = PendingInteractionRegistry(lock, sessions)
+        self.catalog = SessionCatalog(lock)
+
+    def register(
+        self,
+        *,
+        profile: str,
+        durable_session_key: str,
+        runtime_generation: str,
+        surface: str,
+        authority_revision: int,
+        invoke: Callable[[OwnerActionRequest], object],
+        snapshot: Callable[[], Mapping[str, Any]],
+        available_actions: frozenset[str],
+    ) -> _CloseOnce:
+        if not callable(invoke) or not callable(snapshot):
+            raise TypeError("owner session callbacks must be callable")
+        entry = SessionCatalogEntry(
+            profile=profile,
+            durable_session_key=durable_session_key,
+            runtime_generation=runtime_generation,
+            surface=surface,
+            authority_revision=authority_revision,
+            available_actions=available_actions,
+        )
+        identity = (profile, durable_session_key)
+        token = object()
+        record = _OwnerSession(token, authority_revision, entry, invoke, snapshot)
+        with self._lock:
+            self._records[identity] = record
+        self.catalog.upsert(entry, token)
+
+        def close() -> None:
+            with self._lock:
+                current = self._records.get(identity)
+                if current is None or current.token is not token:
+                    return
+                del self._records[identity]
+            self.pending.revoke_scope(
+                profile=profile,
+                durable_session_key=durable_session_key,
+            )
+            self.catalog.remove(entry, token)
+
+        return _CloseOnce(close)
+
+    def invoke(self, request: OwnerActionRequest) -> OwnerActionResult:
+        binding = self._sessions.resolve(
+            profile=request.profile,
+            durable_session_key=request.durable_session_key,
+            runtime_generation=request.runtime_generation,
+        )
+        with self._lock:
+            record = self._records.get((request.profile, request.durable_session_key))
+            if record is None or record.authority_revision != binding.revision:
+                raise HostSpiUnavailableError()
+        _validate_owner_payload(request)
+        digest = hashlib.sha256(
+            json.dumps(
+                {"method": request.method, "payload": dict(request.payload)},
+                ensure_ascii=False,
+                sort_keys=True,
+                separators=(",", ":"),
+                allow_nan=False,
+            ).encode()
+        ).hexdigest()
+        ledger_key = (
+            request.profile,
+            request.durable_session_key,
+            request.runtime_generation,
+            request.command_id,
+        )
+
+        def operation() -> OwnerActionResult:
+            if request.method not in record.entry.available_actions:
+                return OwnerActionResult(
+                    OwnerActionStatus.REJECTED,
+                    {"reason": "owner_action_unavailable"},
+                )
+            if not self.pending.matches(request, binding.revision):
+                return OwnerActionResult(
+                    OwnerActionStatus.REJECTED,
+                    {"reason": "pending_request_unavailable"},
+                )
+            result = _owner_action_result(record.invoke(request))
+            if result.status is OwnerActionStatus.ACCEPTED:
+                self.pending.consume(request)
+            return result
+
+        return self._ledger.execute(ledger_key, digest, operation)
+
+    def snapshot(
+        self, *, profile: str, durable_session_key: str, runtime_generation: str
+    ) -> ControlSnapshot:
+        binding = self._sessions.resolve(
+            profile=profile,
+            durable_session_key=durable_session_key,
+            runtime_generation=runtime_generation,
+        )
+        with self._lock:
+            record = self._records.get((profile, durable_session_key))
+            if record is None or record.authority_revision != binding.revision:
+                raise HostSpiUnavailableError()
+        payload = record.snapshot()
+        if not isinstance(payload, Mapping):
+            raise HostSpiUnavailableError()
+        return ControlSnapshot(
+            profile=profile,
+            durable_session_key=durable_session_key,
+            runtime_generation=runtime_generation,
+            control_revision=binding.revision,
+            payload=payload,
+        )
+
+    def revoke(self, binding: object) -> None:
+        profile = getattr(binding, "profile")
+        durable_session_key = getattr(binding, "durable_session_key")
+        revision = getattr(binding, "revision")
+        identity = (profile, durable_session_key)
+        with self._lock:
+            record = self._records.get(identity)
+            if record is None or record.authority_revision != revision:
+                return
+            del self._records[identity]
+        self.pending.revoke_scope(
+            profile=profile,
+            durable_session_key=durable_session_key,
+        )
+        self.catalog.remove(record.entry, record.token)
+
