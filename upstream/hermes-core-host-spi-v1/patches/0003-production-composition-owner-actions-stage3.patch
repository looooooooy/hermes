+from types import SimpleNamespace
+import zipfile
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+import pytest
+from cryptography.hazmat.primitives import serialization
+from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
+
+
+PLUGIN_ID = "hermes-agent-plugin"
+ENTRYPOINT = {
+    "group": "hermes_agent.plugins",
+    "name": PLUGIN_ID,
+    "value": "hermes_agent_plugin",
+}
+
+
+def _canonical_manifest_bytes(payload: dict[str, object]) -> bytes:
+    unsigned = {key: value for key, value in payload.items() if key != "signature"}
+    return json.dumps(
+        unsigned,
+        ensure_ascii=False,
+        allow_nan=False,
+        separators=(",", ":"),
+        sort_keys=True,
+    ).encode("utf-8")
+
+
+def _write_wheel(
+    path: Path,
+    *,
+    version: str = "1.2.3",
+    entry_points: str | None = None,
+    extra_members: dict[str, bytes] | None = None,
+    module_source: str | None = None,
+) -> None:
+    dist_info = f"hermes_agent_plugin-{version}.dist-info"
+    if entry_points is None:
+        entry_points = (
+            "[hermes_agent.plugins]\n"
+            "hermes-agent-plugin = hermes_agent_plugin\n"
+        )
+    with zipfile.ZipFile(path, "w") as archive:
+        archive.writestr(
+            "hermes_agent_plugin/__init__.py",
+            module_source
+            or (
+                "ORIGIN_MARKER = 'signed-store'\n"
+                "def register(ctx):\n"
+                "    ctx._store_test_registered = True\n"
+            ),
+        )
+        archive.writestr(
+            f"{dist_info}/METADATA",
+            "Metadata-Version: 2.1\n"
+            "Name: hermes-agent-plugin\n"
+            f"Version: {version}\n",
+        )
+        archive.writestr(f"{dist_info}/entry_points.txt", entry_points)
+        archive.writestr(f"{dist_info}/RECORD", "")
+        for name, contents in (extra_members or {}).items():
+            archive.writestr(name, contents)
+
+
+def _signed_bundle(
+    tmp_path: Path,
+    *,
+    version: str = "1.2.3",
+    entry_points: str | None = None,
+    extra_members: dict[str, bytes] | None = None,
+    expires_delta: timedelta = timedelta(hours=1),
+    module_source: str | None = None,
+) -> tuple[Path, Path, Path, Ed25519PrivateKey]:
+    release = tmp_path / "release"
+    release.mkdir(parents=True)
+    wheel = release / f"hermes_agent_plugin-{version}-py3-none-any.whl"
+    _write_wheel(
+        wheel,
+        version=version,
+        entry_points=entry_points,
+        extra_members=extra_members,
+        module_source=module_source,
+    )
+    store_root = tmp_path / "plugin-store"
+    store_root.mkdir()
+    private_key = Ed25519PrivateKey.generate()
+    public_key = private_key.public_key().public_bytes(
+        encoding=serialization.Encoding.Raw,
+        format=serialization.PublicFormat.Raw,
+    )
+    now = datetime.now(timezone.utc)
+    trust_store = tmp_path / "trust-store.json"
+    trust_store.write_text(
+        json.dumps(
+            {
+                "schema_version": 1,
+                "keys": [
+                    {
+                        "key_id": "release-key-1",
+                        "signature_algorithm": "ed25519",
+                        "public_key": base64.b64encode(public_key).decode("ascii"),
+                        "not_before": (now - timedelta(hours=1)).isoformat(),
+                        "not_after": (now + timedelta(days=30)).isoformat(),
+                    }
+                ],
+            },
+            sort_keys=True,
+        ),
+        encoding="utf-8",
+    )
+    trust_store.chmod(0o444)
+    payload: dict[str, object] = {
+        "schema_version": 1,
+        "plugin_id": PLUGIN_ID,
+        "version": version,
+        "wheel_path": str(wheel),
+        "wheel_sha256": hashlib.sha256(wheel.read_bytes()).hexdigest(),
+        "store_root": str(store_root),
+        "entrypoint": ENTRYPOINT,
+        "signature_algorithm": "ed25519",
+        "key_id": "release-key-1",
+        "issued_at": now.isoformat(),
+        "expires_at": (now + expires_delta).isoformat(),
+    }
+    payload["signature"] = base64.b64encode(
+        private_key.sign(_canonical_manifest_bytes(payload))
+    ).decode("ascii")
+    manifest = release / "plugin-bundle-v1.json"
+    manifest.write_text(json.dumps(payload, sort_keys=True), encoding="utf-8")
+    manifest.chmod(0o444)
+    return manifest, trust_store, store_root, private_key
