+    if request.method == "approval.respond" and result.get("resolved") is not True:
+        return _extension_owner_result("rejected", "pending_request_unavailable")
+    if request.method == "clarify.respond" and result.get("status") != "ok":
+        return _extension_owner_result("rejected", "pending_request_unavailable")
+    return _extension_owner_result("accepted")
