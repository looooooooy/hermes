{
  "$defs": {
    "canonical_uuid": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": {
        "type": "object"
      },
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$"
      },
      "type": "object"
    },
    "prompt_submit_params": {
      "additionalProperties": false,
      "properties": {
        "client_turn_id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "runtime_generation": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "runtime_session_id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "text": {
          "maxLength": 65536,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "runtime_session_id",
        "runtime_generation",
        "client_turn_id",
        "text"
      ],
      "type": "object"
    },
    "session_interrupt_params": {
      "additionalProperties": false,
      "properties": {
        "runtime_generation": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "runtime_session_id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "runtime_session_id",
        "runtime_generation"
      ],
      "type": "object"
    },
    "utc_instant": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    }
  },
  "$id": "https://contracts.hermes.local/v1/cloud/payloads/command-deliver.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "const": "prompt.submit"
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/prompt_submit_params"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "session.interrupt"
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/session_interrupt_params"
          }
        }
      }
    }
  ],
  "properties": {
    "client_instance_id": {
      "$ref": "#/$defs/canonical_uuid"
    },
    "client_request_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "command_id": {
      "$ref": "#/$defs/canonical_uuid"
    },
    "connector_instance_id": {
      "$ref": "#/$defs/canonical_uuid"
    },
    "expires_at": {
      "$ref": "#/$defs/utc_instant"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    },
    "issued_at": {
      "$ref": "#/$defs/utc_instant"
    },
    "method": {
      "enum": [
        "prompt.submit",
        "session.interrupt"
      ]
    },
    "params": {
      "type": "object"
    },
    "profile": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "session_key": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "connector_instance_id",
    "client_instance_id",
    "session_key",
    "profile",
    "client_request_id",
    "method",
    "params",
    "issued_at",
    "expires_at",
    "revision"
  ],
  "title": "Hermes Command Deliver Payload v1",
  "type": "object"
}
