          }
        },
        {
          "properties": {
            "code": {
              "const": 4215
            },
            "reason": {
              "const": "relay_overloaded"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4306
            },
            "reason": {
              "const": "deadline_exceeded_before_effect"
