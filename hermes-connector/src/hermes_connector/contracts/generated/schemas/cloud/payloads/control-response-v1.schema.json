        "reason"
      ],
      "type": "object"
    },
    "extensions": {
      "additionalProperties": {
        "type": "object"
      },
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$"
      },
      "type": "object"
    },
    "lease_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "lease_result": {
      "additionalProperties": false,
      "properties": {
        "control_revision": {
          "minimum": 0,
          "type": "integer"
        },
        "controller_kind": {
          "const": "mobile"
        },
        "controller_label": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "expires_at_epoch_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "lease_id": {
          "$ref": "#/$defs/lease_id"
        },
        "pending_input": {
          "$ref": "#/$defs/pending_input"
        }
      },
      "required": [
        "lease_id",
        "expires_at_epoch_ms",
        "control_revision",
        "controller_kind",
        "controller_label",
        "pending_input"
      ],
      "type": "object"
    },
    "operation": {
      "enum": [
        "control.transport.open",
        "session.control.acquire",
        "session.control.renew",
        "session.control.release",
        "session.control.status",
        "session.command.status",
        "prompt.submit",
        "session.interrupt",
        "session.steer",
        "approval.respond",
        "clarify.respond",
        "control.transport.close"
      ]
    },
    "pending_approval": {
      "additionalProperties": false,
      "properties": {
        "choices": {
          "items": {
            "enum": [
              "allow_once",
              "allow_session",
              "allow_always",
              "deny"
            ]
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "command": {
          "maxLength": 131072,
          "type": "string"
        },
        "description": {
          "maxLength": 4096,
          "type": "string"
        },
        "expires_at_epoch_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "const": "approval"
        },
        "request_id": {
          "$ref": "#/$defs/request_identifier"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "kind",
        "title",
        "description",
        "command",
        "choices",
        "expires_at_epoch_ms"
      ],
      "type": "object"
    },
    "pending_clarify": {
      "additionalProperties": false,
      "properties": {
        "allow_other": {
          "type": "boolean"
        },
        "choices": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/request_identifier"
              },
              "label": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "type": "array"
        },
        "expires_at_epoch_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "const": "clarify"
        },
        "question": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "request_id": {
          "$ref": "#/$defs/request_identifier"
        }
      },
      "required": [
        "request_id",
        "kind",
        "question",
        "choices",
        "allow_other",
        "expires_at_epoch_ms"
      ],
      "type": "object"
    },
    "pending_input": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/pending_approval"
        },
        {
          "$ref": "#/$defs/pending_clarify"
        }
      ]
    },
    "pending_response_result": {
      "additionalProperties": false,
      "properties": {
        "client_request_id": {
          "$ref": "#/$defs/request_identifier"
        },
        "control_revision": {
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "enum": [
            "approval",
            "clarify"
          ]
        },
        "request_id": {
          "$ref": "#/$defs/request_identifier"
        },
        "status": {
          "const": "accepted"
        }
      },
      "required": [
        "status",
        "kind",
        "request_id",
        "client_request_id",
        "control_revision"
      ],
      "type": "object"
    },
    "prompt_result": {
      "additionalProperties": false,
      "properties": {
        "client_request_id": {
          "$ref": "#/$defs/request_identifier"
        },
        "client_turn_id": {
          "$ref": "#/$defs/request_identifier"
        },
        "server_turn_id": {
          "$ref": "#/$defs/request_identifier"
        },
        "status": {
          "$ref": "#/$defs/command_state"
        }
      },
      "required": [
        "status",
        "client_request_id",
        "client_turn_id"
      ],
      "type": "object"
    },
    "release_result": {
      "additionalProperties": false,
      "properties": {
        "control_revision": {
          "minimum": 0,
          "type": "integer"
        },
        "released": {
          "const": true
        }
      },
      "required": [
        "released",
        "control_revision"
      ],
      "type": "object"
    },
    "request_identifier": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "simple_command_result": {
      "additionalProperties": false,
      "properties": {
        "client_request_id": {
          "$ref": "#/$defs/request_identifier"
        },
        "status": {
          "$ref": "#/$defs/command_state"
        }
      },
      "required": [
        "status",
        "client_request_id"
      ],
      "type": "object"
    },
    "status_result": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "controller_label": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              }
            }
          },
          "if": {
            "properties": {
              "controller_kind": {
                "const": "none"
              }
            },
            "required": [
              "controller_kind"
            ]
          },
          "then": {
            "properties": {
              "controller_label": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "control_revision": {
          "minimum": 0,
          "type": "integer"
        },
        "controller_kind": {
          "enum": [
            "mobile",
            "desktop",
            "none"
          ]
        },
        "controller_label": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          ]
        },
        "lease_expires_at_epoch_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "pending_input": {
          "$ref": "#/$defs/pending_input"
        }
      },
      "required": [
        "controller_kind",
        "controller_label",
        "control_revision",
        "lease_expires_at_epoch_ms",
        "pending_input"
      ],
      "type": "object"
    },
    "transport_close_result": {
      "additionalProperties": false,
      "properties": {
        "closed": {
          "const": true
        }
      },
      "required": [
        "closed"
      ],
      "type": "object"
    },
    "transport_open_result": {
      "additionalProperties": false,
      "properties": {
        "attached": {
          "const": true
        },
        "connection_role": {
          "const": "control"
        }
