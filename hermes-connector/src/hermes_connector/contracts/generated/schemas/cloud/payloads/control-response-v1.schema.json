          }
        },
        {
          "properties": {
            "code": {
              "const": 4202
            },
            "reason": {
              "const": "live_runtime_unavailable"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4203
            },
            "reason": {
              "const": "controller_conflict"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4204
            },
            "reason": {
              "const": "lease_required"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4205
            },
            "reason": {
              "const": "lease_expired"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4206
            },
            "reason": {
              "const": "lease_mismatch"
