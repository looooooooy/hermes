          }
        },
        {
          "properties": {
            "code": {
              "const": 4207
            },
            "reason": {
              "const": "request_id_payload_conflict"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4208
            },
            "reason": {
              "const": "pending_request_conflict"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4209
            },
            "reason": {
              "const": "method_not_allowed"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4210
            },
            "reason": {
              "const": "command_unknown"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4211
            },
            "reason": {
              "const": "revision_conflict"
