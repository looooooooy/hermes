      "required": [
        "attached",
        "connection_role"
      ],
      "type": "object"
    },
    "utc_instant": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    }
  },
  "$id": "https://contracts.hermes.local/v1/cloud/payloads/control-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "not": {
          "required": [
            "result"
          ]
        },
        "required": [
          "error"
        ]
      },
      "if": {
        "properties": {
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "not": {
          "required": [
            "error"
          ]
        },
        "required": [
          "result"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "unknown"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "$ref": "#/$defs/effect_unknown_error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "allOf": [
              {
                "$ref": "#/$defs/error"
              },
              {
                "not": {
                  "$ref": "#/$defs/effect_unknown_error"
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "control.transport.open"
          },
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "state"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/transport_open_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "session.control.acquire",
              "session.control.renew"
            ]
          },
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "state"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/lease_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "session.control.release"
          },
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "state"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/release_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "session.control.status"
          },
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "state"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/status_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "session.command.status"
          },
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "state"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/command_status_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "prompt.submit"
          },
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "state"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/prompt_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "session.interrupt",
              "session.steer"
            ]
          },
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "state"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/simple_command_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "approval.respond"
          },
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "state"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/approval_response_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "clarify.respond"
          },
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "state"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/clarify_response_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "control.transport.close"
          },
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "state"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/transport_close_result"
          }
        }
      }
    }
  ],
  "properties": {
    "completed_at": {
      "$ref": "#/$defs/utc_instant"
    },
    "control_transport_id": {
      "$ref": "#/$defs/canonical_uuid"
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    },
    "operation": {
      "$ref": "#/$defs/operation"
    },
    "request_id": {
      "$ref": "#/$defs/canonical_uuid"
    },
    "result": {
      "type": "object"
    },
    "state": {
      "enum": [
        "succeeded",
        "failed",
        "unknown"
      ]
    }
  },
  "required": [
    "request_id",
    "control_transport_id",
    "operation",
    "state",
    "completed_at"
  ],
  "title": "Hermes Owner Control Response Payload v1",
  "type": "object"
}
