{
  "$id": "https://contracts.hermes.local/cloud/payloads/session-catalog-snapshot-page-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "is_last": {
            "const": false
          }
        },
        "required": [
          "is_last"
        ]
      },
      "then": {
        "properties": {
          "sessions": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "catalog_revision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "extensions": {
      "additionalProperties": {
        "type": "object"
      },
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$"
      },
      "type": "object"
    },
    "is_last": {
      "type": "boolean"
    },
    "page_index": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "profile": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[^A-Za-z0-9_.-])[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "runtime_generation": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "sessions": {
      "items": {
        "$ref": "https://contracts.hermes.local/session-catalog-entry-v1.schema.json"
      },
      "maxItems": 128,
      "type": "array"
    },
    "snapshot_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "required": [
    "profile",
    "runtime_generation",
    "snapshot_id",
    "catalog_revision",
    "page_index",
    "is_last",
    "sessions"
  ],
  "title": "Hermes Session Catalog Snapshot Page v1",
  "type": "object"
}
