  "$id": "https://contracts.hermes.local/cloud/payloads/session-event-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "message.start"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/messageStart"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "message.delta",
              "reasoning.delta",
              "thinking.delta"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/textDelta"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "message.complete"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/messageComplete"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.terminal.output"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/terminalOutput"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "status.update"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/statusUpdate"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool.output.delta"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/toolOutput"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "todo.update"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "oneOf": [
              {
                "$ref": "#/$defs/todoUpsert"
              },
              {
                "$ref": "#/$defs/todoDelete"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "subagent.update"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "oneOf": [
              {
                "$ref": "#/$defs/subagentUpsert"
              },
              {
                "$ref": "#/$defs/subagentDelete"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool.update"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "oneOf": [
              {
                "$ref": "#/$defs/toolUpsert"
              },
              {
                "$ref": "#/$defs/toolDelete"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "terminal.update"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "oneOf": [
              {
                "$ref": "#/$defs/terminalUpsert"
              },
              {
                "$ref": "#/$defs/terminalDelete"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "message.start",
              "message.complete",
              "todo.update",
              "subagent.update",
              "tool.update",
              "terminal.update"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "not": {
          "required": [
            "event_sequence_start"
          ]
        }
      }
    }
  ],
  "properties": {
    "event_sequence": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "event_sequence_start": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "extensions": {
      "additionalProperties": {
        "type": "object"
      },
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$"
      },
      "type": "object"
    },
    "observer_contract": {
      "const": 2
    },
    "payload": {
      "maxProperties": 1024,
      "type": "object"
    },
    "profile": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[^A-Za-z0-9_.-])[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "runtime_generation": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "session_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "session_key": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "enum": [
        "message.start",
        "message.delta",
        "message.complete",
        "agent.terminal.output",
        "reasoning.delta",
        "status.update",
        "thinking.delta",
        "tool.output.delta",
        "todo.update",
        "subagent.update",
        "tool.update",
        "terminal.update"
      ]
    }
  },
  "required": [
    "observer_contract",
    "profile",
    "runtime_generation",
    "session_key",
    "session_id",
    "type",
    "event_sequence",
    "payload"
  ],
  "title": "Hermes Connector Session Event Payload v2",
  "type": "object"
}
