[Unit]
Description=Hermes Cloud test server Connector Gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=hermes-cloud
Group=hermes-cloud
UMask=0077
EnvironmentFile=/etc/hermes-cloud/test-server.env
LoadCredential=connector_signing_secret:/etc/hermes-cloud/secrets/connector_signing_secret
Environment=HERMES_CONNECTOR_SIGNING_SECRET_FILE=%d/connector_signing_secret
WorkingDirectory=/
ExecStartPre=/usr/bin/env bash ${HERMES_CURRENT}/deploy/test_server/scripts/preflight.sh --connector
ExecStart=/usr/bin/env bash ${HERMES_CURRENT}/deploy/test_server/scripts/run_asgi.sh hermes_cloud.entrypoints.connector_gateway.bootstrap:app ${HERMES_CONNECTOR_GATEWAY_BIND} ${HERMES_CONNECTOR_GATEWAY_PORT}
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
StateDirectory=hermes-cloud
RuntimeDirectory=hermes-cloud

[Install]
WantedBy=multi-user.target
