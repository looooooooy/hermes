[Unit]
Description=Hermes Cloud explicit short-lived SQLite-profile Connector test token

[Service]
Type=oneshot
User=hermes-cloud
Group=hermes-cloud
UMask=0077
EnvironmentFile=/etc/hermes-cloud/sqlite/test-server.env
Environment=HERMES_CONNECTOR_SIGNING_SECRET_FILE=/etc/hermes-cloud/sqlite/secrets/connector_signing_secret
Environment=HERMES_RUNTIME_DSN_FILE=/etc/hermes-cloud/sqlite/secrets/runtime_database_dsn
WorkingDirectory=/
ExecStartPre=/usr/bin/env bash ${HERMES_CURRENT}/deploy/test_server/sqlite/scripts/preflight.sh --sqlite-connector-token
ExecStart=/usr/bin/env ${HERMES_VENV}/bin/python ${HERMES_CURRENT}/deploy/test_server/scripts/mint_connector_token.py --apply --output ${HERMES_CONNECTOR_TOKEN_OUTPUT}
RemainAfterExit=no
TimeoutStartSec=30s
TimeoutStopSec=10s
LimitNOFILE=1024
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
StateDirectory=hermes-cloud-connector-token
StateDirectoryMode=0700
RuntimeDirectory=hermes-cloud-sqlite-connector-token
