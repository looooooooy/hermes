# References only. Create these files outside the repository with mode 0600.
runtime_database_dsn_file=/etc/hermes-cloud/secrets/runtime_database_dsn
migration_database_dsn_file=/etc/hermes-cloud/secrets/migration_database_dsn
bootstrap_database_dsn_file=/etc/hermes-cloud/secrets/bootstrap_database_dsn
business_api_signing_secret_file=/etc/hermes-cloud/secrets/business_api_signing_secret
connector_signing_secret_file=/etc/hermes-cloud/secrets/connector_signing_secret
initial_user_password_file=/etc/hermes-cloud/secrets/initial_user_password

# systemd LoadCredential exposes the selected file below the service credential
# directory. Unit files pass only that generated file path to the process.
