{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hermes.local/cloud/payloads/session-catalog-ack-v1.schema.json",
  "title": "Hermes Session Catalog business ACK v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "runtime_generation",
    "acked_message_id",
    "acked_payload_digest",
    "acked_connector_sequence",
    "ack_kind"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?![\\s\\S]*[^A-Za-z0-9_.-])[A-Za-z0-9_.-]+$"
    },
    "runtime_generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "acked_message_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "acked_payload_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "acked_connector_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ack_kind": {
      "enum": [
        "snapshot_committed",
        "event_applied"
      ]
    },
    "snapshot_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "catalog_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "page_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "is_last": {
      "const": true
    },
    "catalog_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "extensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "snapshot_id",
        "catalog_revision",
        "page_index",
        "is_last"
      ],
      "properties": {
        "ack_kind": {
          "const": "snapshot_committed"
        }
      },
      "not": {
        "required": [
          "catalog_sequence"
        ]
      }
    },
    {
      "required": [
        "catalog_sequence"
      ],
      "properties": {
        "ack_kind": {
          "const": "event_applied"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "snapshot_id"
            ]
          },
          {
            "required": [
              "catalog_revision"
            ]
          },
          {
            "required": [
              "page_index"
            ]
          },
          {
            "required": [
              "is_last"
            ]
          }
        ]
      }
    }
  ]
}
