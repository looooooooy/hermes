{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hermes.local/cloud/payloads/session-observe-open-v1.schema.json",
  "title": "Session Observe Open v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "subscription_id",
    "profile",
    "session_key",
    "target_source",
    "requested_at"
  ],
  "properties": {
    "request_id": {"type": "string", "format": "uuid"},
    "subscription_id": {"type": "string", "format": "uuid"},
    "profile": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?![\\s\\S]*[^A-Za-z0-9_.-])[A-Za-z0-9_.-]+$"},
    "session_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "target_source": {"const": "cloud_authorized_binding"},
    "requested_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "extensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$"},
      "additionalProperties": {"type": "object"}
    }
  }
}
