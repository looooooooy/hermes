{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hermes.local/v1/cloud/payloads/control-response.schema.json",
  "title": "Hermes Owner Control Response Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "control_transport_id",
    "operation",
    "state",
    "completed_at"
  ],
  "properties": {
    "request_id": {
      "$ref": "#/$defs/canonical_uuid"
    },
    "control_transport_id": {
      "$ref": "#/$defs/canonical_uuid"
    },
    "operation": {
      "$ref": "#/$defs/operation"
    },
    "state": {
      "enum": [
        "succeeded",
        "failed",
        "unknown"
      ]
    },
    "completed_at": {
      "$ref": "#/$defs/utc_instant"
    },
    "result": {
      "type": "object"
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "result"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      },
      "else": {
        "required": [
          "error"
        ],
        "not": {
          "required": [
            "result"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "unknown"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "$ref": "#/$defs/effect_unknown_error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "allOf": [
              {
                "$ref": "#/$defs/error"
              },
              {
                "not": {
                  "$ref": "#/$defs/effect_unknown_error"
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "control.transport.open"
          },
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "state"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/transport_open_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "session.control.acquire",
              "session.control.renew"
            ]
          },
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "state"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/lease_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "session.control.release"
          },
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "state"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/release_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "session.control.status"
          },
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "state"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/status_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {"const": "session.command.status"},
          "state": {"const": "succeeded"}
        },
        "required": ["operation", "state"]
      },
      "then": {
        "properties": {
          "result": {"$ref": "#/$defs/command_status_result"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {"const": "prompt.submit"},
          "state": {"const": "succeeded"}
        },
        "required": ["operation", "state"]
      },
      "then": {
        "properties": {
          "result": {"$ref": "#/$defs/prompt_result"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {"enum": ["session.interrupt", "session.steer"]},
          "state": {"const": "succeeded"}
        },
        "required": ["operation", "state"]
      },
      "then": {
        "properties": {
          "result": {"$ref": "#/$defs/simple_command_result"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {"const": "approval.respond"},
          "state": {"const": "succeeded"}
        },
        "required": ["operation", "state"]
      },
      "then": {
        "properties": {
          "result": {"$ref": "#/$defs/approval_response_result"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {"const": "clarify.respond"},
          "state": {"const": "succeeded"}
        },
        "required": ["operation", "state"]
      },
      "then": {
        "properties": {
          "result": {"$ref": "#/$defs/clarify_response_result"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "control.transport.close"
          },
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "state"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/transport_close_result"
          }
        }
      }
    }
  ],
  "$defs": {
    "canonical_uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utc_instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "operation": {
      "enum": [
        "control.transport.open",
        "session.control.acquire",
        "session.control.renew",
        "session.control.release",
        "session.control.status",
        "session.command.status",
        "prompt.submit",
        "session.interrupt",
        "session.steer",
        "approval.respond",
        "clarify.respond",
        "control.transport.close"
      ]
    },
    "lease_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "transport_open_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attached",
        "connection_role"
      ],
      "properties": {
        "attached": {
          "const": true
        },
        "connection_role": {
          "const": "control"
        }
      }
    },
    "lease_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lease_id",
        "expires_at_epoch_ms",
        "control_revision",
        "controller_kind",
        "controller_label",
        "pending_input"
      ],
      "properties": {
        "lease_id": {
          "$ref": "#/$defs/lease_id"
        },
        "expires_at_epoch_ms": {
          "type": "integer",
          "minimum": 0
        },
        "control_revision": {
          "type": "integer",
          "minimum": 0
        },
        "controller_kind": {
          "const": "mobile"
        },
        "controller_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "pending_input": {
          "$ref": "#/$defs/pending_input"
        }
      }
    },
    "release_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "released",
        "control_revision"
      ],
      "properties": {
        "released": {
          "const": true
        },
        "control_revision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "status_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controller_kind",
        "controller_label",
        "control_revision",
        "lease_expires_at_epoch_ms",
        "pending_input"
      ],
      "properties": {
        "controller_kind": {
          "enum": [
            "mobile",
            "desktop",
            "none"
          ]
        },
        "controller_label": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 128}
          ]
        },
        "control_revision": {
          "type": "integer",
          "minimum": 0
        },
        "lease_expires_at_epoch_ms": {
          "type": "integer",
          "minimum": 0
        },
        "pending_input": {
          "$ref": "#/$defs/pending_input"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "controller_kind": {"const": "none"}
            },
            "required": ["controller_kind"]
          },
          "then": {
            "properties": {
              "controller_label": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "controller_label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      ]
    },
    "command_state": {
      "enum": ["accepted", "queued", "rejected"]
    },
    "request_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "command_status_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "client_request_id"],
      "properties": {
        "status": {"$ref": "#/$defs/command_state"},
        "client_request_id": {"$ref": "#/$defs/request_identifier"},
        "client_turn_id": {"$ref": "#/$defs/request_identifier"},
        "server_turn_id": {"$ref": "#/$defs/request_identifier"}
      }
    },
    "prompt_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "client_request_id", "client_turn_id"],
      "properties": {
        "status": {"$ref": "#/$defs/command_state"},
        "client_request_id": {"$ref": "#/$defs/request_identifier"},
        "client_turn_id": {"$ref": "#/$defs/request_identifier"},
        "server_turn_id": {"$ref": "#/$defs/request_identifier"}
      }
    },
    "simple_command_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "client_request_id"],
      "properties": {
        "status": {"$ref": "#/$defs/command_state"},
        "client_request_id": {"$ref": "#/$defs/request_identifier"}
      }
    },
    "approval_response_result": {
      "$ref": "#/$defs/pending_response_result",
      "properties": {
        "kind": {"const": "approval"}
      }
    },
    "clarify_response_result": {
      "$ref": "#/$defs/pending_response_result",
      "properties": {
        "kind": {"const": "clarify"}
      }
    },
    "pending_response_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "kind",
        "request_id",
        "client_request_id",
        "control_revision"
      ],
      "properties": {
        "status": {"const": "accepted"},
        "kind": {"enum": ["approval", "clarify"]},
        "request_id": {"$ref": "#/$defs/request_identifier"},
        "client_request_id": {"$ref": "#/$defs/request_identifier"},
        "control_revision": {"type": "integer", "minimum": 0}
      }
    },
    "pending_input": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/pending_approval"},
        {"$ref": "#/$defs/pending_clarify"}
      ]
    },
    "pending_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id", "kind", "title", "description", "command", "choices",
        "expires_at_epoch_ms"
      ],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_identifier"},
        "kind": {"const": "approval"},
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "description": {"type": "string", "maxLength": 4096},
        "command": {"type": "string", "maxLength": 131072},
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": ["allow_once", "allow_session", "allow_always", "deny"]
          }
        },
        "expires_at_epoch_ms": {"type": "integer", "minimum": 0}
      }
    },
    "pending_clarify": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id", "kind", "question", "choices", "allow_other",
        "expires_at_epoch_ms"
      ],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_identifier"},
        "kind": {"const": "clarify"},
        "question": {"type": "string", "minLength": 1, "maxLength": 4096},
        "choices": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": {"$ref": "#/$defs/request_identifier"},
              "label": {"type": "string", "minLength": 1, "maxLength": 256}
            }
          }
        },
        "allow_other": {"type": "boolean"},
        "expires_at_epoch_ms": {"type": "integer", "minimum": 0}
      }
    },
    "transport_close_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closed"
      ],
      "properties": {
        "closed": {
          "const": true
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reason"
      ],
      "properties": {
        "code": {
          "type": "integer"
        },
        "reason": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "code": {
              "const": 4200
            },
            "reason": {
              "const": "control_role_required"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4201
            },
            "reason": {
              "const": "control_contract_unsupported"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4202
            },
            "reason": {
              "const": "live_runtime_unavailable"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4203
            },
            "reason": {
              "const": "controller_conflict"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4204
            },
            "reason": {
              "const": "lease_required"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4205
            },
            "reason": {
              "const": "lease_expired"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4206
            },
            "reason": {
              "const": "lease_mismatch"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4207
            },
            "reason": {
              "const": "request_id_payload_conflict"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4208
            },
            "reason": {
              "const": "pending_request_conflict"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4209
            },
            "reason": {
              "const": "method_not_allowed"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4210
            },
            "reason": {
              "const": "command_unknown"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4211
            },
            "reason": {
              "const": "revision_conflict"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4212
            },
            "reason": {
              "const": "session_binding_mismatch"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4213
            },
            "reason": {
              "const": "invalid_pending_response"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4214
            },
            "reason": {
              "const": "owner_adapter_unavailable"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4215
            },
            "reason": {
              "const": "relay_overloaded"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4306
            },
            "reason": {
              "const": "deadline_exceeded_before_effect"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4307
            },
            "reason": {
              "const": "effect_unknown"
            }
          }
        }
      ]
    },
    "effect_unknown_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reason"
      ],
      "properties": {
        "code": {
          "const": 4307
        },
        "reason": {
          "const": "effect_unknown"
        }
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
