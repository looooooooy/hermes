{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hermes.local/v1/cloud/payloads/connector-hello.schema.json",
  "title": "Hermes Connector Hello Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connector_instance_id",
    "connector_version",
    "runtime_generation",
    "required_capabilities",
    "optional_capabilities",
    "resume"
  ],
  "properties": {
    "connector_instance_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "connector_version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "runtime_generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "required_capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "optional_capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "$comment": "Must be disjoint from required_capabilities."
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "next_outbound_sequence",
        "next_inbound_sequence"
      ],
      "properties": {
        "mode": {
          "enum": [
            "fresh",
            "resume"
          ]
        },
        "previous_connection_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "next_outbound_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "next_inbound_sequence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "resume"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "previous_connection_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "previous_connection_id"
              ]
            }
          }
        }
      ]
    },
    "extensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
