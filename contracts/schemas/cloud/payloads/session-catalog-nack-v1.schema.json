{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hermes.local/cloud/payloads/session-catalog-nack-v1.schema.json",
  "title": "Hermes Session Catalog business NACK v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "runtime_generation",
    "rejected_message_id",
    "rejected_payload_digest",
    "rejected_connector_sequence",
    "reason",
    "reset_required",
    "snapshot_id",
    "expected_page_index",
    "expected_catalog_sequence"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?![\\s\\S]*[^A-Za-z0-9_.-])[A-Za-z0-9_.-]+$"
    },
    "runtime_generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "rejected_message_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "rejected_payload_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rejected_connector_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reason": {
      "enum": [
        "page_gap",
        "event_gap",
        "runtime_mismatch",
        "stale_writer",
        "contract_mismatch",
        "revision_conflict"
      ]
    },
    "reset_required": {
      "const": true
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "expected_page_index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expected_catalog_sequence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "extensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "reason": {
          "const": "page_gap"
        },
        "snapshot_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expected_page_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expected_catalog_sequence": {
          "const": null
        }
      }
    },
    {
      "properties": {
        "reason": {
          "const": "event_gap"
        },
        "snapshot_id": {
          "const": null
        },
        "expected_page_index": {
          "const": null
        },
        "expected_catalog_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    {
      "properties": {
        "reason": {
          "const": "runtime_mismatch"
        },
        "snapshot_id": {
          "const": null
        },
        "expected_page_index": {
          "const": null
        },
        "expected_catalog_sequence": {
          "const": null
        }
      }
    },
    {
      "properties": {
        "reason": {
          "const": "stale_writer"
        },
        "snapshot_id": {
          "const": null
        },
        "expected_page_index": {
          "const": null
        },
        "expected_catalog_sequence": {
          "const": null
        }
      }
    },
    {
      "properties": {
        "reason": {
          "const": "contract_mismatch"
        },
        "snapshot_id": {
          "const": null
        },
        "expected_page_index": {
          "const": null
        },
        "expected_catalog_sequence": {
          "const": null
        }
      }
    },
    {
      "properties": {
        "reason": {
          "const": "revision_conflict"
        },
        "snapshot_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expected_page_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expected_catalog_sequence": {
          "const": null
        }
      }
    }
  ]
}
