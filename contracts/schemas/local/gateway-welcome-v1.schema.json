{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hermes.local/v1/local/gateway-welcome.schema.json",
  "title": "Hermes Local Gateway Welcome v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "message_type",
    "runtime_generation",
    "profile",
    "accepted_capabilities",
    "unavailable_optional_capabilities"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "message_type": {
      "const": "local.welcome"
    },
    "runtime_generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?![\\s\\S]*[^A-Za-z0-9_.-])[A-Za-z0-9_.-]+$"
    },
    "accepted_capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "unavailable_optional_capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
