{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hermes.local/local/session-catalog-rpc-v1.schema.json",
  "title": "Hermes Session Catalog persistent Observer RPC v1",
  "oneOf": [
    {"$ref": "#/$defs/subscribeRequest"},
    {"$ref": "#/$defs/pageRequest"},
    {"$ref": "#/$defs/unsubscribeRequest"},
    {"$ref": "#/$defs/pageResponse"},
    {"$ref": "#/$defs/unsubscribeResponse"},
    {"$ref": "#/$defs/eventNotification"},
    {"$ref": "#/$defs/resetNotification"},
    {"$ref": "#/$defs/errorResponse"}
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subscription_id",
        "snapshot_id",
        "profile",
        "runtime_generation",
        "catalog_revision",
        "page_index",
        "is_last",
        "sessions",
        "next_cursor"
      ],
      "properties": {
        "subscription_id": {"$ref": "#/$defs/uuid"},
        "snapshot_id": {"$ref": "#/$defs/uuid"},
        "profile": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?![\\s\\S]*[^A-Za-z0-9_.-])[A-Za-z0-9_.-]+$"},
        "runtime_generation": {"type": "string", "minLength": 1, "maxLength": 128},
        "catalog_revision": {"$ref": "#/$defs/safeInteger"},
        "page_index": {"$ref": "#/$defs/safeInteger"},
        "is_last": {"type": "boolean"},
        "sessions": {
          "type": "array",
          "maxItems": 128,
          "items": {"$ref": "https://contracts.hermes.local/session-catalog-entry-v1.schema.json"}
        },
        "next_cursor": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 512
        }
      },
      "allOf": [
        {
          "if": {"properties": {"is_last": {"const": true}}, "required": ["is_last"]},
          "then": {"properties": {"next_cursor": {"const": null}}},
          "else": {
            "properties": {
              "sessions": {"minItems": 1},
              "next_cursor": {"type": "string", "minLength": 1, "maxLength": 512}
            }
          }
        }
      ]
    },
    "subscribeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"$ref": "#/$defs/uuid"},
        "method": {"const": "session.catalog.subscribe"},
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "runtime_generation", "page_size"],
          "properties": {
            "profile": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?![\\s\\S]*[^A-Za-z0-9_.-])[A-Za-z0-9_.-]+$"},
            "runtime_generation": {"type": "string", "minLength": 1, "maxLength": 128},
            "page_size": {"type": "integer", "minimum": 1, "maximum": 128}
          }
        }
      }
    },
    "pageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"$ref": "#/$defs/uuid"},
        "method": {"const": "session.catalog.page"},
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subscription_id", "snapshot_id", "page_index", "cursor"],
          "properties": {
            "subscription_id": {"$ref": "#/$defs/uuid"},
            "snapshot_id": {"$ref": "#/$defs/uuid"},
            "page_index": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
            "cursor": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        }
      }
    },
    "unsubscribeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"$ref": "#/$defs/uuid"},
        "method": {"const": "session.catalog.unsubscribe"},
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subscription_id"],
          "properties": {"subscription_id": {"$ref": "#/$defs/uuid"}}
        }
      }
    },
    "pageResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"$ref": "#/$defs/uuid"},
        "result": {"$ref": "#/$defs/page"}
      }
    },
    "unsubscribeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"$ref": "#/$defs/uuid"},
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subscription_id", "closed"],
          "properties": {
            "subscription_id": {"$ref": "#/$defs/uuid"},
            "closed": {"const": true}
          }
        }
      }
    },
    "eventNotification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "method": {"const": "session.catalog.event"},
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subscription_id",
            "profile",
            "runtime_generation",
            "catalog_sequence",
            "action",
            "entry"
          ],
          "properties": {
            "subscription_id": {"$ref": "#/$defs/uuid"},
            "profile": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?![\\s\\S]*[^A-Za-z0-9_.-])[A-Za-z0-9_.-]+$"},
            "runtime_generation": {"type": "string", "minLength": 1, "maxLength": 128},
            "catalog_sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
            "action": {"enum": ["upsert", "remove"]},
            "entry": {"$ref": "https://contracts.hermes.local/session-catalog-entry-v1.schema.json"}
          }
        }
      }
    },
    "resetNotification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "method": {"const": "session.catalog.reset_required"},
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subscription_id", "reason"],
          "properties": {
            "subscription_id": {"$ref": "#/$defs/uuid"},
            "reason": {"enum": ["cursor_stale", "event_gap", "buffer_overflow", "page_revision_changed", "runtime_generation_changed", "transport_replaced"]}
          }
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"$ref": "#/$defs/uuid"},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "reason"],
          "properties": {
            "code": {"const": 4400},
            "message": {"const": "session catalog reset required"},
            "reason": {"enum": ["cursor_stale", "event_gap", "buffer_overflow", "page_revision_changed", "runtime_generation_changed", "transport_replaced"]}
          }
        }
      }
    }
  }
}
